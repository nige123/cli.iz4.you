#!/bin/sh
# iz4 installer:
#
#     curl -fsSL https://raw.githubusercontent.com/nige123/cli.iz4.you/main/install | sh
#
# Fetches the iz4 CLI into your home directory and puts `iz4` on your
# PATH. If the runtime it needs is missing, it fetches that too (via
# rakubrew, also into your home - nothing system-wide, no sudo). Afterwards
# 'iz4 update' keeps it current; re-running the installer does the same.
#
# It first tries the standalone file published for your system (one file,
# nothing else needed; 'iz4 update' keeps it current). Where none is
# published, or it will not run here, it installs from source instead:
# the code into your home, plus Rakudo if missing.
#
# Overrides: IZ4_SOURCE=1 (install from source even if a file is published),
# IZ4_RELEASE_URL (where the files are), IZ4_REPO (git URL), IZ4_HOME
# (checkout parent), IZ4_BIN (launcher directory), IZ4_NO_RUNTIME=1 (never
# fetch a runtime).  Working on iz4 itself: symlink $IZ4_HOME/cli (default
# ~/.local/share/iz4/cli) to your checkout and the launcher runs that.
set -eu

REPO="${IZ4_REPO:-https://github.com/nige123/cli.iz4.you}"
RELEASE="${IZ4_RELEASE_URL:-https://github.com/nige123/cli.iz4.you/releases/latest/download}"
DATA="${IZ4_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/iz4}"
BIN_DIR="${IZ4_BIN:-$HOME/.local/bin}"
CHECKOUT="$DATA/cli"
RAKUBREW="$HOME/.rakubrew/bin/rakubrew"

say()  { printf '%s\n' "$*"; }
fail() { printf 'iz4 install: %s\n' "$*" >&2; exit 1; }

# -- the standalone file, when one is published for this machine ---------------
asset_for() {
    case "$(uname -s):$(uname -m)" in
        Linux:x86_64)              echo iz4-linux-x86_64 ;;
        Linux:aarch64|Linux:arm64) echo iz4-linux-aarch64 ;;
        Darwin:*)                  echo iz4-macos-universal ;;
        *)                         echo '' ;;
    esac
}
sha256_of() {
    (sha256sum "$1" 2>/dev/null || shasum -a 256 "$1" 2>/dev/null || openssl dgst -sha256 -r "$1" 2>/dev/null) | awk '{print tolower($1)}'
}
try_binary() {
    [ -z "${IZ4_SOURCE:-}" ] || return 1
    [ ! -L "$CHECKOUT" ] || return 1          # a developer checkout stays in charge
    command -v curl >/dev/null 2>&1 || return 1
    asset=$(asset_for); [ -n "$asset" ] || return 1
    tmp=$(mktemp -d 2>/dev/null || mktemp -d -t iz4)
    say "fetching the iz4 file for $(uname -s) $(uname -m)"
    curl -fsSL -o "$tmp/$asset" "$RELEASE/$asset" 2>/dev/null || { say "no published file for this machine; installing from source"; return 1; }
    curl -fsSL -o "$tmp/$asset.sha256" "$RELEASE/$asset.sha256" 2>/dev/null || { say "no checksum published; installing from source"; return 1; }
    exp=$(tr -d '\r\n ' < "$tmp/$asset.sha256" | grep -o -i '[0-9a-f]\{64\}' | head -1 | tr 'A-F' 'a-f')
    got=$(sha256_of "$tmp/$asset")
    [ -n "$exp" ] && [ "$exp" = "$got" ] || fail "checksum mismatch for $asset: expected $exp, got $got; nothing was installed"
    chmod +x "$tmp/$asset"
    "$tmp/$asset" version >/dev/null 2>&1 || { say "the published file does not run on this system; installing from source"; return 1; }
    mkdir -p "$BIN_DIR"
    rm -f "$BIN_DIR/iz4"
    mv "$tmp/$asset" "$BIN_DIR/iz4"
    rm -rf "$tmp"
    say "installed: $BIN_DIR/iz4 ($("$BIN_DIR/iz4" version)) - 'iz4 update' keeps it current"
    return 0
}
# -- 321.do, an agent launcher ------------------------------------------------
# iz4 uses 321 for everything agentic when it is there (suggest, review,
# test drafting, and hooks for every harness it knows). It is fetched
# beside iz4 unless one is already installed, and IZ4_NO_321=1 skips it.
# iz4 works without it: a failure here is a note, never an error.
launcher_asset_for() {
    case "$(uname -s):$(uname -m)" in
        Linux:x86_64)              echo 321-linux-x86_64 ;;
        Linux:aarch64|Linux:arm64) echo 321-linux-aarch64 ;;
        Darwin:*)                  echo 321-macos-universal ;;
        *)                         echo '' ;;
    esac
}
install_launcher() {
    [ "${IZ4_NO_321:-}" != 1 ] || return 0
    if command -v 321 >/dev/null 2>&1 && [ ! -f "$BIN_DIR/.321-from-iz4" ]; then
        say "321.do, an agent launcher, is already installed at $(command -v 321); left as is"
        return 0
    fi
    command -v curl >/dev/null 2>&1 || { say "could not fetch 321.do (no curl); iz4 works without it"; return 0; }
    asset=$(launcher_asset_for); [ -n "$asset" ] || { say "no published 321.do for this machine; iz4 works without it"; return 0; }
    lrelease="${IZ4_321_RELEASE_URL:-https://github.com/nige123/cli.321.do/releases/latest/download}"
    say "install 321.do, an agent launcher"
    tmp=$(mktemp -d 2>/dev/null || mktemp -d -t iz4)
    curl -fsSL -o "$tmp/$asset" "$lrelease/$asset" 2>/dev/null || { say "could not fetch 321.do; iz4 works without it"; rm -rf "$tmp"; return 0; }
    curl -fsSL -o "$tmp/$asset.sha256" "$lrelease/$asset.sha256" 2>/dev/null || { say "could not fetch the 321.do checksum; iz4 works without it"; rm -rf "$tmp"; return 0; }
    exp=$(tr -d '\r\n ' < "$tmp/$asset.sha256" | grep -o -i '[0-9a-f]\{64\}' | head -1 | tr 'A-F' 'a-f')
    got=$(sha256_of "$tmp/$asset")
    [ -n "$exp" ] && [ "$exp" = "$got" ] || { say "checksum mismatch for $asset; 321.do was not installed, iz4 works without it"; rm -rf "$tmp"; return 0; }
    chmod +x "$tmp/$asset"
    "$tmp/$asset" version >/dev/null 2>&1 || { say "the published 321.do does not run on this system; iz4 works without it"; rm -rf "$tmp"; return 0; }
    mkdir -p "$BIN_DIR"
    mv "$tmp/$asset" "$BIN_DIR/321"
    printf 'installed by iz4\n' > "$BIN_DIR/.321-from-iz4"
    rm -rf "$tmp"
    say "installed: $BIN_DIR/321 ($("$BIN_DIR/321" version)) - 'iz4 update' keeps it current"
}

if try_binary; then
    install_launcher
    case ":$PATH:" in
        *":$BIN_DIR:"*) ;;
        *) say "note: $BIN_DIR is not on your PATH. Add this line to your shell profile:"
           say "    export PATH=\"$BIN_DIR:\$PATH\"" ;;
    esac
    say "next: cd your-project && iz4 init"
    exit 0
fi

# -- from source ----------------------------------------------------------------
command -v git  >/dev/null 2>&1 || fail "git is required (https://git-scm.com); install it and re-run"

# -- the iz4 code -----------------------------------------------------------
# A symlink here is a developer's own checkout: the launcher runs it as it
# is, uncommitted edits included, and the installer never pulls over it.
if [ -L "$CHECKOUT" ]; then
    say "running iz4 from your checkout at $(readlink "$CHECKOUT") (symlink; not pulling)"
elif [ -d "$CHECKOUT/.git" ]; then
    say "updating iz4 in $CHECKOUT"
    git -C "$CHECKOUT" pull --ff-only --quiet
else
    mkdir -p "$DATA"
    say "fetching iz4 into $CHECKOUT"
    git clone --depth 1 --quiet "$REPO" "$CHECKOUT" 2>/dev/null \
        || git clone --depth 1 --quiet "$REPO" "$CHECKOUT"
fi

# -- the runtime, only when missing -------------------------------------------
RAKU="$(command -v raku 2>/dev/null || true)"
[ -n "$RAKU" ] || [ ! -x "$HOME/.rakubrew/shims/raku" ] || RAKU="$HOME/.rakubrew/shims/raku"
if [ -z "$RAKU" ]; then
    [ "${IZ4_NO_RUNTIME:-}" != 1 ] \
        || fail "the runtime is missing; install Rakudo (https://rakudo.org) and re-run"
    say "iz4 needs its runtime; fetching it into $HOME/.rakubrew (one-off, a few minutes) ..."
    command -v curl >/dev/null 2>&1 \
        || fail "fetching the runtime needs curl; or install Rakudo yourself: https://rakudo.org"
    command -v perl >/dev/null 2>&1 \
        || fail "fetching the runtime needs perl; or install Rakudo yourself: https://rakudo.org"
    curl -fsSL https://rakubrew.io/install-on-perl.sh | sh >/dev/null 2>&1 \
        || fail "could not set up rakubrew; install Rakudo yourself: https://rakudo.org"
    "$RAKUBREW" mode shim >/dev/null 2>&1 || true
    if ! "$RAKUBREW" download >/dev/null 2>&1; then
        # No prebuilt runtime for this OS/architecture: build it from source.
        ARCH="$(uname -sm 2>/dev/null || echo 'this platform')"
        say "no prebuilt runtime for $ARCH; building it from source instead"
        say "(one-off; needs a C compiler and make, and can take 10+ minutes) ..."
        command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 || command -v clang >/dev/null 2>&1 \
            || fail "building the runtime needs a C compiler (cc, gcc or clang); install one and re-run, or install Rakudo yourself: https://rakudo.org"
        command -v make >/dev/null 2>&1 || command -v gmake >/dev/null 2>&1 \
            || fail "building the runtime needs make; install it and re-run, or install Rakudo yourself: https://rakudo.org"
        "$RAKUBREW" build >/dev/null \
            || fail "could not build the runtime on $ARCH; install Rakudo yourself: https://rakudo.org"
    fi
    RAKU="$HOME/.rakubrew/shims/raku"
    [ -x "$RAKU" ] || fail "runtime fetched but not found at $RAKU; please report this"
fi

# -- the command --------------------------------------------------------------
# The launcher runs the checkout's source, so it is always the code that is
# there. Where Raku++ is installed and runs this iz4 (proved here, now), the
# launcher prefers it: the same source starts in milliseconds instead of
# seconds. Rakudo stays the fallback, and IZ4_RUNTIME=raku forces it.
mkdir -p "$BIN_DIR"
rm -f "$BIN_DIR/iz4"    # replace, never write through an existing symlink
RAKUPP="$(command -v rakupp 2>/dev/null || true)"
if [ -n "$RAKUPP" ] && [ "${IZ4_RUNTIME:-}" != raku ] \
   && [ "$("$RAKUPP" -I "$CHECKOUT/lib" "$CHECKOUT/bin/iz4" version 2>/dev/null | cut -d' ' -f1)" = iz4 ]; then
    say "Raku++ is installed and runs this iz4: the launcher will use it (IZ4_RUNTIME=raku for Rakudo)"
    cat > "$BIN_DIR/iz4" <<LAUNCH
#!/bin/sh
# iz4 launcher, written by the iz4 installer; iz4 update keeps it current.
# Runs the source in $CHECKOUT: under Raku++ while it is installed, else Rakudo.
if [ "\${IZ4_RUNTIME:-}" != raku ] && command -v rakupp >/dev/null 2>&1; then
    exec rakupp -I "$CHECKOUT/lib" "$CHECKOUT/bin/iz4" "\$@"
fi
exec "$RAKU" "$CHECKOUT/bin/iz4" "\$@"
LAUNCH
else
    cat > "$BIN_DIR/iz4" <<LAUNCH
#!/bin/sh
# iz4 launcher, written by the iz4 installer; iz4 update keeps it current.
exec "$RAKU" "$CHECKOUT/bin/iz4" "\$@"
LAUNCH
fi
chmod +x "$BIN_DIR/iz4"

say "checking the installation (the first run compiles; about half a minute) ..."
"$BIN_DIR/iz4" version >/dev/null 2>&1 \
    || "$RAKU" -I "$CHECKOUT/lib" -c "$CHECKOUT/bin/iz4" >/dev/null \
    || fail "installed, but iz4 does not run; please report this"

say "installed: $BIN_DIR/iz4"
install_launcher
case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) say "note: $BIN_DIR is not on your PATH. Add this line to your shell profile:"
       say "    export PATH=\"$BIN_DIR:\$PATH\"" ;;
esac
say "next: cd your-project && iz4 init   (later: iz4 update)"
