#!/bin/sh
# iz4 installer:
#
#     curl -fsSL https://raw.githubusercontent.com/nige123/cli.iz4.you/main/install | sh
#
# Fetches the iz4 CLI into your home directory and puts `iz4` on your
# PATH. If the runtime it needs is missing, it fetches that too (via
# rakubrew, also into your home - nothing system-wide, no sudo). Re-running
# the installer updates iz4.
#
# Overrides: IZ4_REPO (git URL), IZ4_HOME (checkout parent),
# IZ4_BIN (launcher directory), IZ4_NO_RUNTIME=1 (never fetch a runtime).
set -eu

REPO="${IZ4_REPO:-https://github.com/nige123/cli.iz4.you}"
DATA="${IZ4_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/iz4}"
BIN_DIR="${IZ4_BIN:-$HOME/.local/bin}"
CHECKOUT="$DATA/cli"
RAKUBREW="$HOME/.rakubrew/bin/rakubrew"

say()  { printf '%s\n' "$*"; }
fail() { printf 'iz4 install: %s\n' "$*" >&2; exit 1; }

command -v git  >/dev/null 2>&1 || fail "git is required (https://git-scm.com); install it and re-run"

# -- the iz4 code -----------------------------------------------------------
if [ -d "$CHECKOUT/.git" ]; then
    say "updating iz4 in $CHECKOUT"
    git -C "$CHECKOUT" pull --ff-only --quiet
else
    mkdir -p "$DATA"
    say "fetching iz4 into $CHECKOUT"
    git clone --depth 1 --quiet "$REPO" "$CHECKOUT" 2>/dev/null \
        || git clone --depth 1 --quiet "$REPO" "$CHECKOUT"
fi

# -- the runtime, only when missing -------------------------------------------
RAKU="$(command -v raku 2>/dev/null || true)"
[ -n "$RAKU" ] || [ ! -x "$HOME/.rakubrew/shims/raku" ] || RAKU="$HOME/.rakubrew/shims/raku"
if [ -z "$RAKU" ]; then
    [ "${IZ4_NO_RUNTIME:-}" != 1 ] \
        || fail "the runtime is missing; install Rakudo (https://rakudo.org) and re-run"
    say "iz4 needs its runtime; fetching it into $HOME/.rakubrew (one-off, a few minutes) ..."
    command -v curl >/dev/null 2>&1 \
        || fail "fetching the runtime needs curl; or install Rakudo yourself: https://rakudo.org"
    command -v perl >/dev/null 2>&1 \
        || fail "fetching the runtime needs perl; or install Rakudo yourself: https://rakudo.org"
    curl -fsSL https://rakubrew.io/install-on-perl.sh | sh >/dev/null 2>&1 \
        || fail "could not set up rakubrew; install Rakudo yourself: https://rakudo.org"
    "$RAKUBREW" mode shim >/dev/null 2>&1 || true
    if ! "$RAKUBREW" download >/dev/null 2>&1; then
        # No prebuilt runtime for this OS/architecture: build it from source.
        ARCH="$(uname -sm 2>/dev/null || echo 'this platform')"
        say "no prebuilt runtime for $ARCH; building it from source instead"
        say "(one-off; needs a C compiler and make, and can take 10+ minutes) ..."
        command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 || command -v clang >/dev/null 2>&1 \
            || fail "building the runtime needs a C compiler (cc, gcc or clang); install one and re-run, or install Rakudo yourself: https://rakudo.org"
        command -v make >/dev/null 2>&1 || command -v gmake >/dev/null 2>&1 \
            || fail "building the runtime needs make; install it and re-run, or install Rakudo yourself: https://rakudo.org"
        "$RAKUBREW" build >/dev/null \
            || fail "could not build the runtime on $ARCH; install Rakudo yourself: https://rakudo.org"
    fi
    RAKU="$HOME/.rakubrew/shims/raku"
    [ -x "$RAKU" ] || fail "runtime fetched but not found at $RAKU; please report this"
fi

# -- the command --------------------------------------------------------------
mkdir -p "$BIN_DIR"
rm -f "$BIN_DIR/iz4"    # replace, never write through an existing symlink
cat > "$BIN_DIR/iz4" <<LAUNCH
#!/bin/sh
# iz4 launcher, written by the iz4 installer; re-run the installer to update.
exec "$RAKU" "$CHECKOUT/bin/iz4" "\$@"
LAUNCH
chmod +x "$BIN_DIR/iz4"

say "checking the installation (the first run compiles; about half a minute) ..."
"$BIN_DIR/iz4" version >/dev/null 2>&1 \
    || "$RAKU" -I "$CHECKOUT/lib" -c "$CHECKOUT/bin/iz4" >/dev/null \
    || fail "installed, but iz4 does not run; please report this"

say "installed: $BIN_DIR/iz4"
case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) say "note: $BIN_DIR is not on your PATH. Add this line to your shell profile:"
       say "    export PATH=\"$BIN_DIR:\$PATH\"" ;;
esac
say "next: cd your-project && iz4 init"
