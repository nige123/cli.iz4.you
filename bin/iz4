#!/usr/bin/env raku
# iz4 — IZ4 means Is For: what your software is for, who it is for, and the few
# invariants that must remain true to keep serving them.

use lib $*PROGRAM.resolve.parent(2).add('lib').Str;   # run from a checkout without installing
use IZ4;
use IZ4::Document;
use IZ4::Launcher;
use IZ4::Register;
use IZ4::Agent;
use IZ4::Coach;
use IZ4::Review;
use IZ4::Hook;
use IZ4::Evidence;

my %*SUB-MAIN-OPTS = :named-anywhere;
$*OUT.out-buffer = False;   # a closed pipe fails at the write, leaving nothing to flush at exit

sub USAGE() {
    print q:to/END/;
    IZ4 means Is For.  An IZ4 says what your system is for, who it is
    for, and the handful of things that must remain true for it to keep
    serving them.  It is deliberately small: never a specification.

    Usage:
      iz4 init                         ask what this is for and who
                                           it is for, write the IZ4, and offer
                                           to find a first invariant
                                           (scripts: --for-what=... --for-who=...;
                                            --/agents: skip AGENTS.md and friends)
      iz4 add                          find an invariant, coached: one useful
                                           question at a time, and a BECAUSE
      iz4 add invariant TEXT --because=WHY
                                         the fast path, for when you already
                                           know (--number=N to choose one;
                                           --force past a challenge)
      iz4 add for-what TEXT            set IS FOR WHAT (--replace once set)
      iz4 add for-who TEXT             set IS FOR WHO  (--replace once set)
      iz4 because N WHY                say why invariant N must survive
                                           (--replace once set)
      iz4 because N --split            move the reason folded into invariant
                                           N's own text under BECAUSE;
                                           'iz4 because --split' does every one
      iz4 review [RANGE] [--staged]    review a change against the invariants:
                                           which ones it touches (offline), then
                                           your agent's assessment and any
                                           invariant the change reveals, for you
                                           to approve (--offline: no agent;
                                           --strict: exit 1 on a conflict;
                                           --for-push: what is about to be pushed;
                                           --install-hook [--force]: advisory
                                           pre-push hook)
      iz4 suggest                      ask an agent (through 321 when it is
                                           installed, else IZ4_AGENT_CMD,
                                           default 'claude -p') for a few
                                           candidate invariants, then review
                                           them
      iz4 invariants [FILE]            the effective invariants: the foundation
                                           0-4 and this project's own
      iz4 foundation [--restore FILE]  the foundation every IZ4 carries word for
                                           word; --restore writes it back into a
                                           file where it is missing or altered
      iz4 show [FILE] [PART]           print the IZ4, or for-what, for-who or
                                           invariants
      iz4 show invariant N             print invariant N (0-4 are the foundation)
      iz4 check [FILE]                 tick what is true, cross what needs a
                                           remedy; exit 1 only on errors
      iz4 number [FILE]                number any unnumbered invariant from 5
      iz4 test [N ...] [--lang=L]      a test for each invariant that has
                                           none, in the repository's own test
                                           language: on a terminal with an
                                           agent (321 or IZ4_AGENT_CMD), a
                                           drafted real test you approve, marked for
                                           review until you delete the mark;
                                           otherwise a born-red scaffold
                                           (--/draft: scaffold only; --list:
                                           the evidence each invariant has)
      iz4 log [FILE]                   Git history of the IZ4
      iz4 diff [FILE] [REV [REV]]      Git diff of the IZ4
      iz4 agent [--json]               print the agent packet: the protocol
                                           and the effective invariants
      iz4 agent install [--claude] [--skill] [--hooks [--strict]]
                                         add a managed section to AGENTS.md
                                           (--claude: CLAUDE.md too; --skill:
                                           the portable skill; --hooks: hooks
                                           that deliver the packet at start and
                                           after a compaction, wired by 321 into
                                           every harness it knows, else by iz4
                                           into Claude Code; --strict: also
                                           refuse an edit before the packet, and
                                           a turn that changed files without the
                                           invariant report)
      iz4 hook session-start|pre-edit|stop
                                         the harness-neutral hook: JSON in,
                                           text out, exit 2 to refuse
      iz4 agent status [--json] [--strict]
                                         report spec validity and integration
                                           state, and what 321 says each
                                           harness enforces (--strict for CI)
      iz4 register [--url=U --token=T] connect this IZ4 to the IZ4 register
                     [--github [--force]]  (sign up first: iz4.you)
      iz4 report [--dry-run|--strict]  submit evidence (never the text)
      iz4 badge                        print the card link and badge snippets
      iz4 version                      print the tool version
      iz4 update [--check]             update this iz4 to the latest published
                                           version (--check: only say whether one
                                           exists); a developer checkout with
                                           local changes is left alone

    The golden test for an invariant: if the whole system were
    rewritten tomorrow, would we regret not telling the people and agents
    rebuilding it this?

    END
    print EXAMPLES;
}

# Run a command body; user errors become one-line messages and exit 1.
sub attempt(&body) {
    my $rc = body() // 0;
    exit $rc;
    CATCH {
        when X::IZ4 { note .message; exit 1 }
        # A closed pipe (iz4 ... | head) is normal, never a stack trace.
        when *.message.contains('Broken pipe') { try $*OUT.close; exit 0 }
    }
}

# ------------------------------------------------------------ conversation

#| Coaching needs a person: a terminal on both ends, or IZ4_INTERACTIVE=1
#| (tests script the answers).  Scripts and CI never get a question.
sub interactive(--> Bool) {
    with %*ENV<IZ4_INTERACTIVE> { return $_ ne '0' && $_ ne '' }
    $*IN.t && $*OUT.t;
}

sub ask(Str $prompt --> Str) {
    print $prompt;
    my $line = read-line();
    print "\n" unless $*IN.t;     # keep scripted transcripts readable
    $line // Str;                 # end of input: no answer
}

#| One line from standard input, read a character at a time: under Raku++
#| a second $*IN.get on a pipe returns nothing and .lines reads to the end
#| before answering, and a coach must answer as the person types.
sub read-line(--> Str) {
    my $s = '';
    loop {
        my $c = $*IN.getc;
        without $c { return $s ne '' ?? $s !! Str }
        last if $c eq "\n";
        $s ~= $c;
    }
    $s.subst(/ \r $ /, '');
}

sub tell(Str $line) { say $line }

sub ask-required(Str $prompt, Str $what --> Str) {
    for ^3 {
        my $answer = (ask($prompt) // user-error("$what: no answer")).trim;
        return $answer if $answer ne '';
        say 'One plain sentence is plenty.';
    }
    user-error("$what: no answer");
}

#| Coach one invariant into $path.  Always exit 0: deciding not to add
#| something is a good outcome, not an error.
sub coach-into(IO::Path $path, Str :$candidate, Str :$suggested-because --> Int) {
    my $doc = check-doc($path);
    my %r = coach-invariant(
        :&ask, :&tell, :$candidate, :$suggested-because,
        for-what => $doc.for-what, for-who => $doc.for-who,
        number => next-free-number($path));
    given %r<outcome> {
        when 'add' {
            my $n = add-invariant($path, %r<text>, :because(%r<because>));
            say "Added INVARIANT $n to {display-name($path)}.";
        }
        when 'skipped' { say 'Nothing added.' }
    }
    0;
}

# ------------------------------------------------------------ init

multi MAIN('init', Str :$for-what, Str :$for-who, Bool :$agent, Bool :$agents) {
    attempt {
        user-error("IZ4 already exists here; not overwriting") if $*CWD.add('IZ4').e;
        note "init no longer drafts a specification from the repository; after init, 'iz4 suggest' proposes a few candidate invariants"
            if $agent === True;
        my $talk = interactive();
        my $what = $for-what;
        my $who  = $for-who;
        if !$talk && (!$what.defined || !$who.defined) {
            user-error("iz4 init needs two answers: what this is for, and who it is for.\n"
                ~ "On a terminal it asks; in a script pass --for-what=... --for-who=...");
        }
        $what //= ask-required("What is this for?\n> ", 'what it is for');
        $who  //= ask-required("Who is it for?\n> ", 'who it is for');
        my $path = init(:for-what($what), :for-who($who));
        say "Created {$path.basename}.";

        # Agent entry points install themselves - don't make the user think.
        # AGENTS.md always; CLAUDE.md and the skill where the repository
        # shows Claude use.  --agents forces all three; --/agents skips.
        if $agents !=== False {
            CATCH { when X::IZ4 { note "agent entry points not installed: {.message}" } }
            my $root      = $*CWD;
            my $claudeish = $root.add('CLAUDE.md').e || $root.add('.claude').d;
            my @sections  = 'AGENTS.md', |(($agents === True || $claudeish) ?? 'CLAUDE.md' !! Empty);
            say "$_: {install-agent-section($root.add($_), :$root)}" for @sections;
            say "{SKILL-PATH}: {install-skill(:$root)}" if $agents === True || $root.add('.claude').d;
        }

        say '';
        say "Every IZ4 carries invariants 0-4, the foundation, word for word ('iz4 invariants' shows them).";
        say 'Your project-specific invariants begin at 5.';
        if $talk {
            say '';
            return coach-into($path) if yes-no(ask('Add an invariant now? [Y/n] '), :default);
        }
        0;
    }
}

# ------------------------------------------------------------ add

multi MAIN('add', Str $kind?, Str $text?, Str :$file, Str :$because, Int :$number,
           Bool :$replace = False, Bool :$force = False) {
    attempt {
        my $path = resolve-target($file);
        my $k = ($kind // 'invariant').lc;
        given $k {
            when 'invariant' | 'invariants' {
                if interactive() && !$because.defined && !$number.defined {
                    return coach-into($path, :candidate($text));
                }
                user-error("iz4 add coaches you on a terminal; in a script use:\n"
                    ~ "  iz4 add invariant 'what must remain true' --because='why it must survive'")
                    without $text;
                fast-add($path, $text, :$because, :$number, :$force);
            }
            when 'for-what' | 'what' | 'is-for-what' {
                user-error('iz4 add for-what needs the answer: what is this for?') without $text;
                set-is-for($path, 'IS FOR WHAT', $text, :$replace);
                say 'Set IS FOR WHAT.';
            }
            when 'for-who' | 'who' | 'is-for-who' {
                user-error('iz4 add for-who needs the answer: who is this for?') without $text;
                set-is-for($path, 'IS FOR WHO', $text, :$replace);
                say 'Set IS FOR WHO.';
            }
            default {
                my $singular = $k.subst(/ 's' $/, '');
                with %ELSEWHERE-FOR{$singular} { user-error($_) }
                user-error("unknown kind '$kind'; IZ4 holds invariant, for-what and for-who");
            }
        }
        0;
    }
}

#| The fast path: no questions, but the same challenges as the coach, as
#| a refusal the person can overrule with --force.  They decide.
sub fast-add(IO::Path $path, Str $text, Str :$because, Int :$number, Bool :$force) {
    unless $force {
        my %a = assess-candidate($text.subst(/:i^ 'invariant' \s+ \d+ \s* <[:.\-]>? \s+/, ''));
        my $why = do given %a<kind> {
            when 'implementation' { "that sounds like an implementation choice ({%a<signal>}), not an invariant. If it were replaced tomorrow, could it still serve the same people and purpose? If so, record it in an ADR or developer docs instead." }
            when 'mechanism'      { "{%a<signal>} sounds like how it is done today. What must remain true if it is replaced? Add that instead." }
            when 'requirement'    { "that reads like a requirement or setting ({%a<signal>}), not enduring intent. Pin it with a test, or say what would let people down if it changed." }
            when 'task'           { "that reads like work to do. Track it in your issues; IZ4 records what must stay true." }
            default               { Str }
        }
        user-error("not added: $why\n(--force adds it anyway, if you have judged that it must remain true)") with $why;
        if ($because // '').trim && assess-because($text, $because) eq 'circular' {
            user-error("not added: the BECAUSE restates the invariant. Who would be harmed, surprised or let down if it stopped being true, and why?\n(--force adds it anyway)");
        }
    }
    my $n = add-invariant($path, $text, :$because, :$number);
    say "Added INVARIANT $n.";
    note "note: no BECAUSE - say why it must survive, so nobody removes it by accident (--because=...)"
        unless ($because // '').trim;
}

# ------------------------------------------------------------ because

multi MAIN('because', Str $number?, Str $text?, Str :$file, Bool :$replace = False, Bool :$split = False) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        if $split {
            my @which = $number.defined ?? (parse-number($number),) !! ();
            my @done = @which ?? (split-because($path, @which[0]) andthen ((@which[0], $_),)) // () !! split-all-because($path);
            if @done {
                say "Invariant {.[0]}: moved under BECAUSE - {.[1]}" for @done;
                say "Check each one: the words are yours, only moved.";
            }
            else {
                say @which
                    ?? "Invariant {@which[0]}: no reason found in its text; say it with 'iz4 because {@which[0]} WHY'"
                    !! "$name: no invariant carries a reason in its own text";
            }
            return 0;
        }
        user-error("iz4 because needs an invariant number and the reason: iz4 because 5 'why it must survive'")
            unless $number.defined && $text.defined;
        my $n = parse-number($number);
        if assess-because(check-doc($path).invariant($n).?text // '', $text) eq 'circular' && !$replace {
            user-error("that restates the invariant. Who would be harmed, surprised or let down if it stopped being true, and why?\n(--replace sets it anyway)");
        }
        set-because($path, $n, $text, :$replace);
        say "Set BECAUSE for Invariant $n.";
        0;
    }
}

sub parse-number(Str $s --> Int) {
    my $raw = $s.subst(/:i^ 'invariant' \s+ /, '').subst(/ ':' $/, '');
    user-error("'$s' is not an invariant number") unless $raw ~~ /^ \d+ $/;
    +$raw;
}

# ------------------------------------------------------------ read

#| The foundation as every file carries it; --restore writes it into
#| the file when it is missing or altered.
multi MAIN('foundation', Str $file?, Bool :$restore = False) {
    attempt {
        unless $restore {
            print foundation-block();
            say "(sha256 of the foundation text: {FOUNDATION-DIGEST.substr(0, 12)}; every IZ4 carries these five word for word)";
            return 0;
        }
        my $path = resolve-target($file);
        given restore-foundation($path) {
            when 'unchanged' { say "{display-name($path)}: the foundation is already there, word for word" }
            when 'written'   { say "{display-name($path)}: wrote the foundation, Invariants 0-4, after IS FOR WHO?" }
            when 'replaced'  { say "{display-name($path)}: replaced the altered foundation with Invariants 0-4 word for word" }
        }
        my $doc = check-doc($path);
        say "  now: {$doc.foundation-status}";
        $doc.foundation-intact ?? 0 !! 1;
    }
}

multi MAIN('invariants', Str $file?) {
    attempt {
        my $path = resolve-target($file);
        print effective-text(check-doc($path), :name(display-name($path)));
        0;
    }
}

multi MAIN('show', 'invariant', Str $number, Str :$file) {
    attempt {
        print invariant-text(resolve-target($file), $number);
        0;
    }
}

multi MAIN('show', Str $a?, Str $b?) {
    attempt {
        my ($file, $part) = $a.defined && looks-like-file($a) ?? ($a, $b) !! (Str, $a);
        user-error("too many arguments") if $b.defined && !$file.defined;
        print show-text(resolve-target($file), $part);
        0;
    }
}

# ------------------------------------------------------------ check

multi MAIN('check', Str $file?) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        my $doc  = check-doc($path);
        .say for $doc.report(:$name);

        # A checklist of file facts: a tick for what is true, a cross with
        # its remedy for what is not.  Whether the software keeps its
        # invariants is never a tick: a checker cannot know, so it says so.
        my @rows;
        my $errors = +$doc.errors;
        my $warns  = +$doc.warnings;
        @rows.push: ($errors == 0 ?? '✓' !! '✗',
            $errors == 0
                ?? "structure: valid" ~ ($warns ?? " ($warns warning{$warns == 1 ?? '' !! 's'} above)" !! '')
                !! "structure: $errors error{$errors == 1 ?? '' !! 's'} above - fix each line listed");
        @rows.push: $doc.for-what.defined
            ?? ('✓', "IS FOR WHAT: {short($doc.for-what)}")
            !! ('✗', "IS FOR WHAT: missing - what is this for? ('iz4 add for-what ...')");
        @rows.push: $doc.for-who.defined
            ?? ('✓', "IS FOR WHO: {short($doc.for-who)}")
            !! ('✗', "IS FOR WHO: missing - who is this for? ('iz4 add for-who ...')");
        @rows.push: ($doc.foundation-intact ?? '✓' !! '✗', $doc.foundation-status);

        my $count = $doc.invariants.elems;
        my $unnum = +$doc.unnumbered-invariants;
        if $unnum {
            @rows.push: ('✗', "invariants: $unnum of $count unnumbered - run 'iz4 number'");
        }
        elsif $count {
            @rows.push: ('✓', "invariants: $count of your own, numbered from 5");
        }
        else {
            @rows.push: ('✓', "invariants: none of your own yet, which is a fine start ('iz4 add' helps you find one)");
        }
        if $count {
            my @bare   = $doc.unexplained-invariants;
            my @folded = @bare.grep({ split-reason(.text)[1].defined }).map({ .number // 'unnumbered' });
            my @plain  = @bare.grep({ !split-reason(.text)[1].defined }).map({ .number // 'unnumbered' });
            @rows.push: ('✗', "BECAUSE: Invariant {@folded.join(', ')} carr{@folded == 1 ?? 'ies' !! 'y'} the reason inside the invariant - 'iz4 because --split' moves it under BECAUSE")
                if @folded;
            @rows.push: ('✗', "BECAUSE: missing for Invariant {@plain.join(', ')} - write under each why it must survive ('iz4 because N WHY')")
                if @plain;
            @rows.push: ('✓', 'BECAUSE: every invariant says why it must survive') unless @bare;

            # evidence: a test that names the invariant and quotes it.  Named
            # is a test; scaffolded is the born-red placeholder; none is none.
            my %ev = evidence-for($doc, $path.parent);
            my @none = %ev<state>.pairs.grep(*.value eq 'none').map(*.key).sort(+*);
            my @scaf = %ev<state>.pairs.grep(*.value eq 'scaffolded').map(*.key).sort(+*);
            my $named = %ev<state>.values.grep(* eq 'named').elems;
            my @draft = %ev<state>.pairs.grep(*.value eq 'drafted').map(*.key).sort(+*);
            @rows.push: ('✗', "evidence: Invariant {@scaf.join(', ')} ha{@scaf == 1 ?? 's' !! 've'} only a scaffold - write the assertion in {%ev<files>{@scaf[0]}[0]}" ~ (@scaf > 1 ?? ' and the others' !! ''))
                if @scaf;
            @rows.push: ('✗', "evidence: Invariant {@draft.join(', ')} ha{@draft == 1 ?? 's' !! 've'} an agent-drafted test awaiting review - read {%ev<files>{@draft[0]}[0]}" ~ (@draft > 1 ?? ' and the others' !! '') ~ ", run it, make sure it can fail, then delete its first line")
                if @draft;
            @rows.push: ('✗', "evidence: Invariant {@none.join(', ')} ha{@none == 1 ?? 's' !! 've'} no test naming {@none == 1 ?? 'it' !! 'them'} - 'iz4 test' scaffolds one")
                if @none;
            @rows.push: ('✓', "evidence: every invariant is named and quoted by a test ($named of $count)") unless @none || @scaf || @draft;
        }

        if $path.basename eq ROOT-NAME {
            my $root = $path.parent;
            my %s    = agent-status($path, :$root);
            for expected-integrations(:$root) -> $i {
                my $status = %s<integrations>{$i};
                @rows.push: ($status eq 'current' ?? '✓' !! '✗', integration-line($i, $status));
            }
        }

        my $top = $count ?? ($doc.invariants.map(*.number).grep(*.defined).max max 4) !! 4;
        @rows.push: ('?', "the system keeps Invariants 0-$top: uncertain - a checker cannot verify "
            ~ "natural-language invariants; review consequential changes against 'iz4 invariants'");

        say mark(.[0]) ~ ' ' ~ .[1] for @rows;
        say 'checked: file facts only; a passing check never means the system is safe, '
          ~ 'harmless, or keeps its invariants';
        my $crosses = @rows.grep({ .[0] eq '✗' }).elems;
        if $doc.ok {
            say "OK $name" ~ ($crosses ?? " ($crosses to remedy above)" !! '');
            0;
        }
        else { 1 }
    }
}

sub short(Str $s --> Str) { $s.chars > 60 ?? $s.substr(0, 57).trim-trailing ~ '...' !! $s }

#| One plain glyph: green tick, red cross, yellow question; coloured only
#| on a terminal that has not asked for no colour.
sub mark(Str $glyph --> Str) {
    return $glyph if %*ENV<NO_COLOR> || !$*OUT.t;
    my $colour = do given $glyph { when '✓' { 32 }; when '✗' { 31 }; default { 33 } };
    "\e[{$colour}m$glyph\e[0m";
}

# ------------------------------------------------------------ number

multi MAIN('test', *@numbers, Str :$file, Str :$lang, Bool :$list = False, Bool :$draft = True) {
    attempt {
        my $path = resolve-target($file);
        my $root = $path.parent;
        my $doc  = check-doc($path);
        user-error("fix the errors 'iz4 check' reports first") if $doc.errors;
        my %ev = evidence-for($doc, $root);
        if $list || !$doc.invariants {
            say "No project invariants yet; 'iz4 add' finds one." unless $doc.invariants;
            for $doc.invariants.grep(*.number.defined) -> $inv {
                my $n = $inv.number;
                say sprintf('  Invariant %-3s %-10s %s', $n, %ev<state>{$n}, (%ev<files>{$n} // ()).join(', '));
            }
            say "named: a reviewed test names and quotes it; drafted: an agent's draft awaiting review; scaffolded: the born-red placeholder; none: nothing.";
            say "Evidence that an invariant holds is a test that would fail if it stopped being true; a name alone is not that.";
            return 0;
        }
        my @only = @numbers.map({ parse-number($_) });
        for @only { user-error("no invariant $_ in {display-name($path)}") unless $doc.invariant($_) }
        my $language = $lang // detect-language($root);
        user-error("no scaffold for language '$language'; --lang takes one of {LANGUAGES.join(', ')}")
            unless so $language eq any(LANGUAGES);

        # With an agent and a person present, draft the real test and ask;
        # a draft is written only on a yes, and is marked for review.
        my @drafted;
        if $draft && interactive() {
            my $layout = gather-context($root);
            for $doc.invariants.grep(*.number.defined) -> $inv {
                my $n = $inv.number;
                next if @only && $n ne any(@only);
                next if %ev<state>{$n} ne 'none';
                my ($rel, $) = scaffold($language, $inv);
                next if $root.add($rel).e;
                say '';
                say "Invariant $n: {$inv.text}";
                say "asking agent ({agent-label()}) for a test ($language, $rel) ...";
                my $d = try agent-draft($doc, $inv, $root, :lang($language), :path($rel), :$layout);
                without $d { say "  no draft: {$!.message.lines.head}; a scaffold will be written instead"; next }
                with $d<cannot> { say "  the agent declined: $_"; say "  a scaffold will be written instead"; next }
                say '';
                say $d<text>.lines.map({ "    $_" }).join("\n");
                say '';
                my $answer = (ask("Write it to $rel, marked for your review? [Y/n/q] ") // 'q').trim.lc;
                last if $answer.starts-with('q');
                next if $answer.starts-with('n');
                $root.add($rel).parent.mkdir;
                $root.add($rel).spurt(marked-draft($language, $d<text>));
                @drafted.push: ($rel, $n);
            }
            %ev = evidence-for($doc, $root);
        }
        my @done = write-scaffolds($doc, $root, :lang($language), :@only);
        if @drafted {
            say '';
            say "Drafted {+@drafted} test{+@drafted == 1 ?? '' !! 's'} ($language), each marked for review on its first line:";
            say "  $_[0]  (Invariant $_[1])" for @drafted;
            say "A draft is not evidence until you have read it, run it, seen that it can fail, and deleted that line.";
        }
        if @done {
            say '';
            say "Scaffolded {+@done} test{+@done == 1 ?? '' !! 's'} ($language), each failing until you write the assertion:";
            say "  $_[0]  (Invariant $_[1])" for @done;
            say "A scaffold is not evidence: 'iz4 check' counts it only once its placeholder is gone.";
            say "On a terminal with an agent (IZ4_AGENT_CMD), 'iz4 test' drafts the real test for you to approve." unless $draft && interactive();
        }
        unless @drafted || @done {
            say @only
                ?? "Nothing to write: {@only.map({ 'Invariant ' ~ $_ }).join(', ')} already ha{@only == 1 ?? 's' !! 've'} a test naming it (or its file exists)."
                !! "Nothing to write: every invariant already has a test naming it, or its file exists ('iz4 test --list').";
        }
        0;
    }
}

multi MAIN('number', Str $file?) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        my @done = number-invariants($path);
        if @done {
            my ($from, $to) = @done[0][1], @done[*-1][1];
            say "Numbered {+@done} invariant{+@done == 1 ?? '' !! 's'} in $name ("
              ~ ($from == $to ?? "Invariant $from" !! "Invariant $from to Invariant $to") ~ ')';
        }
        else {
            say "$name: every invariant is already numbered";
        }
        0;
    }
}

# ------------------------------------------------------------ review

multi MAIN('review', *@range, Str :$file, Bool :$staged = False, Bool :$for-push = False,
           Bool :$offline = False, Bool :$strict = False, Bool :$install-hook = False, Bool :$force = False) {
    attempt {
        my $path = resolve-target($file);
        if $install-hook {
            say "pre-push hook: {install-hook($path, :$force)} (advisory; set IZ4_REVIEW_STRICT=1 to make it block on a conflict)";
            return 0;
        }
        my $doc = check-doc($path);
        user-error("fix the errors 'iz4 check' reports before reviewing") if $doc.errors;
        my ($diff, $what) = change-diff($path, |($for-push ?? (push-range($path),) !! @range), :$staged);
        .say for offline-report($doc, $diff, :$what);
        return 0 unless $diff.trim;
        return 0 if $offline;

        my $review = try agent-review($path, :$diff, :$what);
        without $review {
            say "No agent review: {$!.message.lines.head} (IZ4_AGENT_CMD names your agent; --offline skips this).";
            return 0;
        }
        say '';
        .say for assessment-lines($review, $doc);
        my $conflicts = $review<assessments>.grep(*<level> eq 'conflicting').elems;

        if $review<candidates> {
            for $review<candidates>.list -> %c {
                say '';
                say "Candidate invariant ({%c<class>.lc}): {%c<text>}";
                say "  BECAUSE {%c<because>}" if %c<because>;
                say "  Evidence that would show it holds: {%c<evidence>}" if %c<evidence>;
                if interactive() {
                    my $answer = (ask('Consider it? [Y/n/q] ') // 'q').trim.lc;
                    last if $answer.starts-with('q');
                    next if $answer.starts-with('n');
                    coach-into($path, :candidate(%c<text>), :suggested-because(%c<because>));
                }
            }
            say "Nothing was added. Add one with 'iz4 add' if you agree." unless interactive();
        }
        say '';
        say $conflicts
            ?? "A conflict is the agent's reading of the diff, with its evidence above; you decide."
            !! "No conflict reported. That is one reading of the diff, not a proof.";
        $strict && $conflicts ?? 1 !! 0;
    }
}

# ------------------------------------------------------------ suggest

multi MAIN('suggest', Str :$file) {
    attempt {
        my $path = try resolve-target($file);
        my $dir  = $path.defined ?? $path.parent !! $*CWD;
        my $reply = try agent-suggest($dir, current => ($path.defined ?? $path.slurp !! ''));
        user-error("agent suggestion failed: {$!.message.lines.head}; nothing was added") without $reply;
        my %s = %$reply;

        my ($strong, $possible) = %s<found><strong possible>;
        my $left = %s<implementation> + %s<not-iz4>;
        say 'Analysed repository.';
        say "I found $strong strong candidate invariant{$strong == 1 ?? '' !! 's'} and $possible "
          ~ "thing{$possible == 1 ?? '' !! 's'} that may depend on product intent.";
        if $strong > %s<strong> || $possible > %s<possible> {
            say "Showing the strongest {+%s<strong>} and {+%s<possible>}: fewer, stronger invariants beat apparent completeness.";
        }
        say "Left out $left as implementation or not IZ4 (for example: {%s<implementation>[0]<text> // %s<not-iz4>[0]<text>})." if $left;
        unless %s<strong> || %s<possible> {
            say "Nothing stood out as enduring intent. That is a fine answer; 'iz4 add' when something does.";
            return 0;
        }

        if !$path.defined || !interactive() {
            for %s<strong>.list -> %c {
                say "\nStrong candidate: {%c<text>}";
                say "  BECAUSE: {%c<because>}" if %c<because>;
            }
            for %s<possible>.list -> %c {
                say "\nPossible, needs your intent: {%c<text>}";
                say "  Only you can say: {%c<question>}" if %c<question>;
            }
            say '';
            say $path.defined
                ?? "Nothing was added. Review them on a terminal with 'iz4 suggest', or add one with 'iz4 add'."
                !! "Nothing was added. Run 'iz4 init' first, then 'iz4 suggest' again.";
            return 0;
        }

        say "Let's review the strongest one first.";
        my @queue = |%s<strong>.map({ %( |$_, kind => 'strong' ) }),
                    |%s<possible>.map({ %( |$_, kind => 'possible' ) });
        for @queue -> %c {
            say '';
            say %c<kind> eq 'strong' ?? "Candidate: {%c<text>}" !! "Possible: {%c<text>}";
            say "Only you can say: {%c<question>}" if %c<question>;
            my $answer = (ask('Consider it? [Y/n/q] ') // 'q').trim.lc;
            last if $answer.starts-with('q');
            next if $answer.starts-with('n');
            coach-into($path, :candidate(%c<text>), :suggested-because(%c<because>));
        }
        0;
    }
}

multi MAIN('log', Str $file?) {
    attempt {
        print log-text(resolve-target($file));
        0;
    }
}

multi MAIN('diff', *@args) {
    attempt {
        my $file = @args && looks-like-file(@args[0]) ?? @args.shift !! Str;
        user-error("diff takes at most two revisions") if @args > 2;
        my ($rc, $out, $err) = diff-result(resolve-target($file), |@args);
        if $rc == 127 { say $err.trim; return 0 }      # no Git: informational, like log
        print $out;
        note $err.trim if $err.trim ne '';
        $rc;
    }
}

multi MAIN('version') {
    say "iz4 {VERSION}" ~ (own-revision() andthen " ($_)" orelse '');
}

multi MAIN('update', Bool :$check = False) {
    attempt {
        my %u = self-update(:$check);
        my sub commits() { say "  $_" for %u<commits>.head(8); say "  ..." if %u<commits> > 8 }
        my $rc = do given %u<state> {
            when 'current'  { say "iz4 is up to date ({VERSION}, {%u<from>})."; 0 }
            when 'behind'   { say "iz4 is {%u<n>} commit{%u<n> == 1 ?? '' !! 's'} behind; 'iz4 update' fetches:"; commits(); 0 }
            when 'updated'  { say "Updated iz4 from {%u<from>} to {%u<to>} ({%u<n>} commit{%u<n> == 1 ?? '' !! 's'}):"; commits(); 0 }
            default         { note %u<note>; 1 }
        };
        # 321, when iz4 installed it, is kept current too; one someone else installed is left alone.
        # A source install runs the checkout's bin/iz4 through a launcher script on PATH, so
        # the marker is looked for beside that script as well as beside the program itself.
        my $bin-dir = launcher-owner-dir();
        if $bin-dir.defined {
            my %l = launcher-install(:$bin-dir, :$check);
            given %l<state> {
                when 'current' { say "321.do, an agent launcher, is up to date ({%l<version>})." }
                when 'behind'  { say "321.do, an agent launcher, is behind: {%l<version>} installed, {%l<tag>} published; 'iz4 update' fetches it." }
                when 'updated' { say "Updated 321.do, an agent launcher, from {%l<from>} to {%l<version>}." }
                when 'installed' { say "Installed 321.do, an agent launcher ({%l<version>}) at {%l<path>}." }
                default        { note "321.do: {%l<note>}" }
            }
        }
        $rc;
    }
}

multi MAIN('agent', Bool :$json = False, Str :$file) {
    attempt {
        my %p = agent-packet(resolve-target($file));
        print $json ?? json-encode(%p) ~ "\n" !! packet-text(%p);
        0;
    }
}

multi MAIN('agent', 'install', Bool :$claude = False, Bool :$skill = False, Bool :$hooks = False,
           Bool :$strict = False, Str :$file) {
    attempt {
        my $root = resolve-target($file).parent;
        for 'AGENTS.md', |($claude ?? 'CLAUDE.md' !! Empty) -> $name {
            say "$name: {install-agent-section($root.add($name), :$root)}";
        }
        say "{SKILL-PATH}: {install-skill(:$root)}" if $skill;
        if $hooks {
            with launcher-binary() -> $bin {
                # 321 knows the harnesses: it writes the wiring and says what each enforces
                my %h = launcher-hooks($bin, 'install', :$root, :$strict);
                say "hooks via 321 {launcher-version($bin)}, for every harness it knows:";
                say "  $_" for hooks-lines(%h);
            }
            else {
                say "{SETTINGS-PATH}: {install-claude-hooks(:$root, :$strict)} ("
                  ~ ($strict ?? 'session-start, pre-edit and stop hooks: the packet is delivered, nothing is edited before it, and a turn that changed files ends with the invariant report'
                             !! 'session-start hook: the packet is delivered at start, resume and after a compaction; --strict adds the blocking hooks')
                  ~ ')';
            }
        }
        say "These integrations only encourage adherence in tools that load them"
          ~ ($hooks ?? '; a hook can prove the packet was delivered and a report written, never that an invariant was honoured.' !! '.');
        0;
    }
}

# ------------------------------------------------------------ hook

#| The harness-neutral hook contract: JSON in, text for the model out,
#| exit 2 with a reason on standard error to refuse.
multi MAIN('hook', Str $event where 'session-start' | 'pre-edit' | 'stop', Str :$file) {
    my %input = read-input($*IN.slurp);
    my $path = try resolve-target($file);
    without $path { exit ALLOW }                # no IZ4 here: nothing to insist on
    my ($exit, $out, $err) = do given $event {
        when 'session-start' { on-session-start($path, %input) }
        when 'pre-edit'      { on-pre-edit($path, %input) }
        when 'stop'          { on-stop($path, %input) }
    };
    print $out if $out;
    note $err.trim-trailing if $err;
    exit $exit;
}

multi MAIN('agent', 'status', Bool :$json = False, Bool :$strict = False, Str :$file) {
    attempt {
        my $path = try resolve-target($file);
        my $root = $path.defined ?? $path.parent !! $*CWD;
        my %s    = agent-status($path, :$root);
        %s<hooks> = claude-hooks-status(:$root);
        my $bin = launcher-binary();
        with $bin { %s<launcher> = %( binary => $_, version => launcher-version($_) ) }
        if $json { say json-encode(%s) }
        else {
            if %s<iz4><present> {
                say "IZ4: {display-name($path)} - " ~ (%s<iz4><valid>
                    ?? 'valid'
                    !! "INVALID ({%s<iz4><errors>} errors - run 'iz4 check')");
                say %s<iz4><binding>;
            }
            else { say 'IZ4: none found in this directory or its parents' }
            say integration-line($_, %s<integrations>{$_}) for 'AGENTS.md', 'CLAUDE.md', SKILL-PATH;
            say "{SETTINGS-PATH}: " ~ do given %s<hooks> {
                when 'strict' { 'hooks installed (packet delivered, edits and turn end gated)' }
                when 'start'  { "session-start hook installed ('iz4 agent install --hooks --strict' adds the gates)" }
                default       { "no hooks ('iz4 agent install --hooks')" }
            };
            with $bin {
                my %h = try launcher-hooks($_, 'status', :$root);
                if %h {
                    say "321 {%s<launcher><version>}, an agent launcher, is installed: agent runs, suggest, review and test drafting go through it,";
                    say "and it wires hooks into every harness it knows and says what each enforces:";
                    say "  $_" for hooks-lines(%h);
                }
                else { say "321 is installed at $_ but 'hooks status' failed: {$!.message.lines.head}" }
            }
            else { say "321, an agent launcher, is not installed: agent prompts go to {agent-cmd()} and hooks are wired for Claude Code only" }
            say %s<note>;
        }
        my $fail = !%s<iz4><present> || !%s<iz4><valid>
                || ?%s<integrations>.values.grep(* eq 'stale' | 'malformed');
        ($strict && $fail) ?? 1 !! 0;
    }
}

multi MAIN('register', Str :$url, Str :$token, Str :$file,
           Bool :$github = False, Bool :$force = False) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        with $url {
            my $f = save-register-url($path, $url);
            say "Register URL saved to {display-name($f)}";
        }
        with $token {
            my $u = register-url($path)
                // user-error("save the reports URL first: iz4 register --url=<reports URL>");
            save-token($u, $token);
            say "Token saved to {token-store()} - outside the repository; do not commit it.";
        }
        if $github {
            my $u = register-url($path)
                // user-error("save the reports URL first: iz4 register --url=<reports URL> --github");
            say install-github-workflow($path, :$force) eq 'unchanged'
                ?? '.github/workflows/iz4.yml is already set up'
                !! 'Wrote .github/workflows/iz4.yml: every push installs iz4 (runtime cached) and runs iz4 report';
            my $t = $token // token-for($u);
            if $t.defined {
                given set-github-secret($path, $t) {
                    when 'set'   { say 'Stored the token as the repository secret S2R_TOKEN (GitHub CLI).' }
                    when 'no-gh' { say 'No GitHub CLI found. Add a repository secret named S2R_TOKEN with your token (Settings > Secrets and variables > Actions).' }
                    default      { user-error("the GitHub CLI could not set the secret ($_). Sign in with: gh auth login, then run: iz4 register --github") }
                }
                say "Next: commit and push {display-name(register-file($path))} and .github/workflows/iz4.yml; every push then reports.";
            }
            else {
                say 'No reporting token yet. Mint one on the Connect CI page, then: iz4 register --token=<token> --github';
            }
        }
        if !$url.defined && !$token.defined && !$github {
            with register-url($path) -> $u {
                say "$name reports to $u";
                say token-for($u).defined
                    ?? "A reporting token is available. Submit evidence with: iz4 report"
                    !! "No reporting token yet. Mint one on the project's Connect CI page, then:\n  iz4 register --token=<token>";
            }
            else {
                print qq:to/END/;
                $name is not connected to a register yet.

                To make it discoverable on the IZ4 register:
                  1. Sign up first (email passcode): {REGISTER-START}
                  2. Create a project there and mint a reporting token (shown once)
                  3. Connect this IZ4 (add --github to set up GitHub Actions too):
                       iz4 register --url=<the project's reports URL> --token=<the token>
                  4. Submit evidence: iz4 report

                A report carries presence, digest, counts and check outcomes -
                never the text of your IZ4. Only register and report, and the
                agent behind suggest, reach the network; every other iz4
                command stays offline.
                END
            }
        }
        0;
    }
}

multi MAIN('badge', Str :$file) {
    attempt {
        my %b = badge-info(resolve-target($file));
        say "card:  {%b<card>}";
        say "badge: {%b<badge>}";
        say '';
        say 'Markdown (paste into README.md):';
        say %b<markdown>;
        say '';
        say 'HTML:';
        say %b<html>;
        say '';
        say 'The badge is served live by the register and renders the card\'s';
        say 'current evidence; embedding it claims nothing the card cannot back.';
        0;
    }
}

multi MAIN('report', Str :$file, Str :$release, Str :$run-id,
           Bool :$dry-run = False, Bool :$strict = False) {
    attempt {
        my $path   = resolve-target($file);
        my %report = collect-report($path, :$release, :$run-id);
        my $body   = json-encode(%report);
        if $dry-run { say $body; return 0 }

        my $url = register-url($path)
            // user-error("not connected to a register; run 'iz4 register' for the steps");
        my $token = token-for($url)
            // user-error("no reporting token; run 'iz4 register' for the steps");

        my ($code, $reply) = submit-report($url, $token, $body);
        if 200 <= $code < 300 {
            say "submitted {%report<report_id>} ({display-name($path)} at {%report<revision>.substr(0, 12)})";
            return 0;
        }
        note $code == 0
            ?? "register unreachable: $reply"
            !! "register answered $code: {$reply.substr(0, 300)}";
        $strict ?? 1 !! 0;   # advisory by design: never blocks a pipeline
    }
}

sub user-error(Str $message) { X::IZ4.new(:$message).throw }
