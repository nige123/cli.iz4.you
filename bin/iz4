#!/usr/bin/env raku
# iz4 — IZ4 means Is For: what your software is for, who it is for, and the few
# invariants that must remain true to keep serving them.

use lib $*PROGRAM.resolve.parent(2).add('lib').Str;   # run from a checkout without installing
# The core: intent, its evidence, the gate, a person's agreement, and the
# machine interface a driver calls.  It knows no agent harness and never
# runs 321.
use IZ4;
use IZ4::Document;
use IZ4::Register;
use IZ4::Git;
use IZ4::Gate;
use IZ4::Agent;
use IZ4::Coach;
use IZ4::Help;
use IZ4::Review;
use IZ4::Evidence;
use IZ4::Machine;
# The conveniences: they may ask 321, the environment driver and agent
# launcher, and are the only things here that do.
use IZ4::Launcher;
use IZ4::Assist;
use IZ4::Integrations;
# Compatibility for wiring an earlier iz4 left behind; deprecated.
use IZ4::LegacyHook;

my %*SUB-MAIN-OPTS = :named-anywhere;
$*OUT.out-buffer = False;   # a closed pipe fails at the write, leaving nothing to flush at exit

#| What is shown when a command line is not understood, or --help is
#| given.  Short on purpose: the command's own help when it names one,
#| and otherwise the first screen.
sub USAGE() {
    my @words = @*ARGS.grep({ !.starts-with('-') });
    my $wanted = so @*ARGS.grep('--help' | '-h' | '-?');
    # the longest leading run of words that names a command
    my $t;
    for (2, 1) -> $n { last if $t.defined; $t = topic(@words.head($n).join(' ')) if @words >= $n }
    if $wanted { print $t.defined ?? help-topic($t) !! help-index(); return }
    if $t.defined {
        note "iz4 {$t.name} was not given what it needs. Here is how it is called:";
        note '';
        note help-topic($t);
    }
    elsif @words {
        note help-for([@words[0]])[0];
    }
    else { print help-index() }
}

# Run a command body; user errors become one-line messages and exit 1.
constant INACTIVE-NOTE = 'The IZ4 intent is recorded, but harness enforcement is currently inactive.';

sub attempt(&body, Bool :$intent = False) {
    # A command that changes intent is followed, when it succeeded and
    # really changed something, by making sure enforcement is in place.
    my $*IZ4-INTENT-CHANGED = False;
    my $before = $intent ?? intent-digest() !! '';
    my $rc = body() // 0;
    if $intent && $rc == 0 && ($*IZ4-INTENT-CHANGED || intent-digest() ne $before) {
        try { activate-enforcement(); CATCH { default { note "enforcement: {.message.lines.head}"; note INACTIVE-NOTE } } }
    }
    exit $rc;
    CATCH {
        when X::IZ4 { note .message; exit 1 }
        # A closed pipe (iz4 ... | head) is normal, never a stack trace.
        when *.message.contains('Broken pipe') { try $*OUT.close; exit 0 }
    }
}

# ------------------------------------------------------------ enforcement

#| The nearest IZ4's content identity, or '' when there is none: how a
#| command that may or may not have changed the file is told apart.
sub intent-digest(--> Str) {
    my $path = try resolve-target(Str);
    return '' without $path;
    $path.f ?? (try sha256-file($path)) // '' !! '';
}

#| After a successful change of intent: make sure the environment driver
#| is there (installing the official 321 when it is not), ask it to
#| activate enforcement, and report what is really in place.  Nothing
#| here can undo the change that was just made, and nothing is called
#| active until 321 has wired it and read it back.
sub activate-enforcement() {
    return if enforcement-disabled();
    my $path = try resolve-target(Str);
    return without $path;
    my $root = $path.parent;
    my %r = ensure-enforcement(:$root);
    my %d = %r<driver>;
    given %d<state> {
        when 'installed' { say "321 {%d<version>} installed at {%d<path>}: the environment driver iz4 uses to activate enforcement." }
        when 'updated'   { say "321 updated from {%d<from>} to {%d<version>} at {%d<path>}." }
    }
    if %d<state> eq any(<failed too-old foreign>) {
        my $why = %d<state> eq 'failed'  ?? "321 could not be installed ({%d<note>})"
               !! %d<state> eq 'too-old' ?? "{%d<note>}"
               !!                           "321 was left alone ({%d<note>})";
        quiet("$why, so agent enforcement could not be activated.");
        quiet(INACTIVE-NOTE);
        return;
    }
    with %r<error> {
        quiet("321 {%d<version>} could not activate enforcement ($_).");
        quiet(INACTIVE-NOTE);
        return;
    }
    if !%r<detected> {
        say "enforcement: 321 {%d<version>} found no agent harness here, so there is nothing to wire.";
        return;
    }
    say "enforcement, as 321 {%d<version>} wired it and read it back:";
    say "  $_" for driver-lines(%r<report>);
    note INACTIVE-NOTE if !%r<active>;
}

# ------------------------------------------------------------ conversation

#| Coaching needs a person: a terminal on both ends, or IZ4_INTERACTIVE=1
#| (tests script the answers).  Scripts and CI never get a question.
sub interactive(--> Bool) {
    with %*ENV<IZ4_INTERACTIVE> { return $_ ne '0' && $_ ne '' }
    $*IN.t && $*OUT.t;
}

sub ask(Str $prompt --> Str) {
    print $prompt;
    my $line = read-line();
    print "\n" unless $*IN.t;     # keep scripted transcripts readable
    $line // Str;                 # end of input: no answer
}

#| One line from standard input, read a character at a time: under Raku++
#| a second $*IN.get on a pipe returns nothing and .lines reads to the end
#| before answering, and a coach must answer as the person types.
sub read-line(--> Str) {
    my $s = '';
    loop {
        my $c = $*IN.getc;
        without $c { return $s ne '' ?? $s !! Str }
        last if $c eq "\n";
        $s ~= $c;
    }
    $s.subst(/ \r $ /, '');
}

sub tell(Str $line) { say pretty($line) }

#| A short block a person can take in at a glance: a title under the icon,
#| a sentence or two, and the one command that comes next.  The shape every
#| human-facing command answers in, so nothing is a wall.
sub calm(Str $title, *@body, :@next) {
    say pretty((pretty-on() ?? diamond() ~ ' ' !! '') ~ $title);
    if @body {
        say '';
        say "  $_" for wrap(@body.join(' '), 72);
    }
    if @next {
        say '';
        say pretty(sprintf('  iz4 %-14s %s', .key, .value)) for @next;
    }
}

#| A note to standard error that a person can read past: dimmed on a terminal.
sub quiet(Str $text) { note pretty-on() && $*ERR.t ?? "\e[2m$text\e[0m" !! $text }

#| Show a drafted answer and let the person keep it with Enter or type
#| their own.  The words that go in the file are the ones they chose.
sub keep-or-type(Str $lead, Str $draft, Str $what --> Str) {
    say '';
    say $lead;
    say "  $draft";
    my $said = ask("Enter keeps that; or type your own.\n> ");
    user-error("iz4 init needs $what") without $said;
    $said.trim eq '' ?? $draft !! $said.trim;
}

sub ask-required(Str $prompt, Str $what --> Str) {
    for ^3 {
        my $answer = (ask($prompt) // user-error("$what: no answer")).trim;
        return $answer if $answer ne '';
        say 'One plain sentence is plenty.';
    }
    user-error("$what: no answer");
}

#| Coach one invariant into $path.  Always exit 0: deciding not to add
#| something is a good outcome, not an error.
sub coach-into(IO::Path $path, Str :$candidate, Str :$suggested-because, Str :$name, Str :$namespace --> Int) {
    my $doc = check-doc($path);
    my %r = coach-invariant(
        :&ask, :&tell, :$candidate, :$suggested-because, :clauses($doc.form eq 'clauses'),
        for-what => $doc.for-what, for-who => $doc.for-who);
    given %r<outcome> {
        when 'add' {
            my ($id, $ns) = choose-identity($path, $name, :$namespace, :text(%r<text>));
            add-invariant($path, %r<text>, :name($id), :because(%r<because>), :namespace($ns), :reach(%r<reach> // Str));
            say "Added INVARIANT $id to {display-name($path)}.";
        }
        when 'skipped' { say 'Nothing added.' }
    }
    0;
}

#| The namespace a project's invariants are named under: from the file,
#| the option or IZ4_NAMESPACE; else a person is asked, once, and every
#| later invariant takes it from the file.  A script is never asked.
sub choose-namespace(IO::Path $path, Str :$namespace --> Str) {
    my $ns = project-namespace($path, :given($namespace));
    without $ns {
        my $guess = suggested-namespace($path);
        user-error("this project's invariants have no namespace yet: pass --namespace=your.domain once "
            ~ "(a domain your project answers for" ~ ($guess ?? ", perhaps $guess" !! '') ~ "); later invariants take it from the file")
            unless interactive();
        say "Invariants are named under a domain your project answers for, like honeywillow.com.";
        say "You are asked once: later invariants take it from the file.";
        for ^3 {
            my $answer = (ask("Which domain?" ~ ($guess ?? " [$guess]" !! '') ~ "\n> ") // user-error('no namespace given')).trim.lc;
            $answer ||= $guess // '';
            if $answer ne '' && namespace-problem($answer) eq '' { $ns = $answer; last }
            say $answer eq '' ?? 'A domain, like honeywillow.com.' !! "'$answer' cannot be used: {namespace-problem($answer)}";
        }
        user-error('no namespace given') without $ns;
    }
    with namespace-problem($ns) -> $why { user-error("'$ns' cannot be a namespace: $why") if $why }
    $ns;
}

#| The domain a new IZ4's header names: the one given, IZ4_NAMESPACE, the
#| directory's own name when it reads as a domain; else a person is asked,
#| once.  A script must say it: a domain is one a project answers for, and
#| is never made up.
sub init-namespace(Str $given --> Str) {
    my $ns = ($given // '').trim.lc || (%*ENV<IZ4_NAMESPACE> // '').trim.lc;
    my $guess = suggested-namespace($*CWD.add('IZ4'));
    if $ns eq '' {
        user-error("iz4 init needs the domain your project answers for, which its invariants are named under: --namespace=your.domain"
            ~ ($guess ?? " (perhaps $guess)" !! '')) unless interactive();
        say "Which domain does this project answer for? Its invariants are named under it, like honeywillow.com.";
        for ^3 {
            my $answer = (ask("Which domain?" ~ ($guess ?? " [$guess]" !! '') ~ "\n> ") // user-error('no domain given')).trim.lc;
            $answer ||= $guess // '';
            if $answer ne '' && namespace-problem($answer) eq '' { $ns = $answer; last }
            say $answer eq '' ?? 'A domain, like honeywillow.com.' !! "'$answer' cannot be used: {namespace-problem($answer)}";
        }
        user-error('no domain given') if $ns eq '';
    }
    with namespace-problem($ns) -> $why { user-error("'$ns' cannot be this project's domain: $why") if $why }
    $ns;
}

#| The full identity for a new invariant: the name a person gave, under
#| the project's namespace.  A name that is already whole is taken as it
#| is.  On a terminal a missing name is asked for; a script must give it:
#| a name is a person's choice and is never made up here.
sub choose-identity(IO::Path $path, Str $name? is copy, Str :$namespace, Str :$text = '', Str :$for = 'it' --> List) {
    my $known = project-namespace($path, :given($namespace));
    without $name {
        user-error("an invariant needs a name: --name=a-few-words (lower case, joined by hyphens), which is how people and tools will refer to it")
            unless interactive();
        say "Name $for: a few lower-case words joined by hyphens, like owner-adjusted.";
        say "The name is how people, tests and tools refer to it, and it never changes.";
        for ^3 {
            my $answer = (ask("> ") // user-error('no name given')).trim;
            my $trial = is-identity($answer) ?? $answer !! $answer ~ '.' ~ ($known // 'example.com');
            if $answer ne '' && identity-problem($trial) eq '' { $name = $answer; last }
            say $answer eq '' ?? 'A name, like owner-adjusted.' !! "'$answer' cannot be used: {identity-problem($trial)}";
        }
        user-error('no name given') without $name;
    }
    $name = $name.trim;
    return ($name, $known) if is-identity($name) && (!$known || $name.ends-with(".$known"));
    if is-identity($name) && $known {
        note "note: $name is outside this project's namespace ($known); taken as the whole name";
        return ($name, Str);
    }
    my $ns = choose-namespace($path, :$namespace);
    (full-identity($name, $ns), $ns);
}

# ------------------------------------------------------------ help

#| 'iz4' alone, and 'iz4 help': the first screen.  'iz4 help add': one
#| command.  'iz4 help more': the rest.  Always short.
multi MAIN() { print pretty(help-index()); exit 0 }
multi MAIN('help', *@words) {
    my ($text, $known) = help-for(@words);
    if $known { print pretty($text); exit 0 }
    note $text;
    exit 1;
}
multi MAIN(Bool :h($h)!) { print pretty(help-index()); exit 0 }
# people type this out of habit; it is the same as 'iz4 version'
multi MAIN(Bool :$version!) { MAIN('version') }

# ------------------------------------------------------------ init

multi MAIN('init', Str :$for-what, Str :$for-who, Str :$namespace, Bool :$agent, Bool :$agents) {
    attempt :intent, {
        user-error("IZ4 already exists here; not overwriting") if $*CWD.add('IZ4').e;
        note "init no longer drafts a specification from the repository; after init, 'iz4 suggest' proposes a few candidate invariants"
            if $agent === True;
        my $talk = interactive();
        my $what = $for-what;
        my $who  = $for-who;
        if !$talk && (!$what.defined || !$who.defined) {
            user-error("iz4 init needs two answers: what this is for, and who it is for.\n"
                ~ "On a terminal it asks; in a script pass --for-what=... --for-who=...");
        }
        if $talk && (!$what.defined || !$who.defined) {
            # Whatever agent is on this machine drafts it with them: 321 is made
            # sure of first, since it is what reaches one.  Nothing is written
            # until the person has seen each answer and kept it or typed their own.
            my %d = (try ensure-driver()) // %();
            say "321 {%d<version>} installed at {%d<path>}: it is how iz4 reaches the agent you already use." if (%d<state> // '') eq 'installed';
            if agent-reachable() {
                say "Reading this repository with {agent-label()} to draft the IZ4 with you ...";
                my %p = (try agent-purpose($*CWD)) // %();
                if %p {
                    $what //= keep-or-type('It looks like this is for:', %p<for-what>, 'what it is for');
                    $who  //= keep-or-type('And it is for:', %p<for-who>, 'who it is for');
                }
                else { say "No draft came back, so two questions instead." }
            }
        }
        $what //= ask-required("What is this for?\n> ", 'what it is for');
        $who  //= ask-required("Who is it for?\n> ", 'who it is for');
        my $ns = init-namespace($namespace);
        my $path = init(:for-what($what), :for-who($who), :namespace($ns));
        say "Created {$path.basename} for $ns.";

        # Agent entry points install themselves - don't make the user think.
        # AGENTS.md always; CLAUDE.md and the skill where the repository
        # shows Claude use.  --agents forces all three; --/agents skips.
        if $agents !=== False {
            CATCH { when X::IZ4 { note "agent entry points not installed: {.message}" } }
            my $root      = $*CWD;
            my $claudeish = $root.add('CLAUDE.md').e || $root.add('.claude').d;
            my @sections  = 'AGENTS.md', |(($agents === True || $claudeish) ?? 'CLAUDE.md' !! Empty);
            say "$_: {install-agent-section($root.add($_), :$root)}" for @sections;
            say "{SKILL-PATH}: {install-skill(:$root)}" if $agents === True || $root.add('.claude').d;
        }

        # The commit hook installs itself too, where this is a Git repository:
        # it is what notices a change to what the software promises and asks
        # the person about it there and then.  IZ4_ENFORCE=0 leaves it out.
        if (%*ENV<IZ4_ENFORCE> // '') ne '0' && git($path, 'rev-parse', '--git-dir')[0] == 0 {
            my $state = try install-hook($path, :hook<pre-commit>, :text(gate-hook-text(:enforce)),
                                         :mark(GATE-HOOK-MARK), :manual('iz4 gate --staged'));
            say $state.defined
                ?? "Commit hook: $state. When a commit changes what this software promises, it asks you about it there and then."
                !! "Commit hook left alone: {$!.message.lines.head}";
        }

        say '';
        calm("What every IZ4 carries",
             'The foundation, word for word, beginning with Invariant Zero: humans first.',
             'Your own invariants say where they apply (WHERE), what must remain true there (ALWAYS) and what must not be defeated (PROTECTS).',
             :next(['add' => 'one invariant, one question at a time',
                    'mode vibe' => 'move fast while the invariants settle',
                    'foundation' => 'the words every IZ4 carries']));
        if $talk {
            say '';
            if yes-no(ask('Add an invariant now? [Y/n] '), :default) {
                # with an agent here, it reads the code for the few things worth keeping; else one question at a time
                return agent-reachable() && review-suggestions($path, :quiet) ?? 0 !! coach-into($path);
            }
        }
        0;
    }
}

# ------------------------------------------------------------ add

multi MAIN('add', Str $kind?, Str $text?, Str :$file, Str :$because, Str :$name, Str :$namespace,
           Str :$where, Str :$protects, Bool :$replace = False, Bool :$force = False) {
    attempt :intent, {
        my $path = resolve-target($file);
        my $k = ($kind // 'invariant').lc;
        given $k {
            when 'invariant' | 'invariants' {
                if interactive() && !$because.defined && !$name.defined && !$where.defined && !$protects.defined {
                    return coach-into($path, :candidate($text), :$namespace);
                }
                user-error("iz4 add coaches you on a terminal; in a script use:\n"
                    ~ (check-doc($path).form eq 'clauses'
                        ?? "  iz4 add invariant 'what must remain true there' --where='the situation it applies in' --protects='what must not be defeated' --name=a-few-words"
                        !! "  iz4 add invariant 'what must remain true' --name=a-few-words --because='why it must survive'"))
                    without $text;
                fast-add($path, $text, :because($protects // $because), :$name, :$namespace, :$force, :reach($where));
            }
            when 'for-what' | 'what' | 'is-for-what' {
                user-error('iz4 add for-what needs the answer: what is this for?') without $text;
                set-is-for($path, 'IS FOR WHAT', $text, :$replace);
                say 'Set IS FOR WHAT.';
            }
            when 'for-who' | 'who' | 'is-for-who' {
                user-error('iz4 add for-who needs the answer: who is this for?') without $text;
                set-is-for($path, 'IS FOR WHO', $text, :$replace);
                say 'Set IS FOR WHO.';
            }
            default {
                my $singular = $k.subst(/ 's' $/, '');
                with %ELSEWHERE-FOR{$singular} { user-error($_) }
                user-error("unknown kind '$kind'; IZ4 holds invariant, for-what and for-who");
            }
        }
        0;
    }
}

#| The fast path: no questions, but the same challenges as the coach, as
#| a refusal the person can overrule with --force.  They decide.
sub fast-add(IO::Path $path, Str $text, Str :$because, Str :$name, Str :$namespace, Bool :$force, Str :$reach) {
    my $form = check-doc($path).form;
    if $form eq 'clauses' {
        user-error("not added: say where it applies with --where='the situation', as WHERE is the first clause of an invariant here") if ($reach // '').trim eq '';
        user-error("not added: say whose what it protects with --protects='a customer\'s money', as PROTECTS is the third clause here. {NOTHING-PROTECTED}") if ($because // '').trim eq '';
    }
    unless $force {
        my %a = assess-candidate($text);
        my $why = do given %a<kind> {
            when 'implementation' { "that sounds like an implementation choice ({%a<signal>}), not an invariant. If it were replaced tomorrow, could it still serve the same people and purpose? If so, record it in an ADR or developer docs instead." }
            when 'mechanism'      { "{%a<signal>} sounds like how it is done today. What must remain true if it is replaced? Add that instead." }
            when 'requirement'    { "that reads like a requirement or setting ({%a<signal>}), not enduring intent. Pin it with a test, or say what would let people down if it changed." }
            when 'task'           { "that reads like work to do. Track it in your issues; IZ4 records what must stay true." }
            default               { Str }
        }
        user-error("not added: $why\n(--force adds it anyway, if you have judged that it must remain true)") with $why;
        if ($because // '').trim && assess-because($text, $because) eq 'circular' {
            user-error($form eq 'clauses'
                ?? "not added: PROTECTS restates ALWAYS. What must not be defeated: which person, and what of theirs?\n(--force adds it anyway)"
                !! "not added: the BECAUSE restates the invariant. Who would be harmed, surprised or let down if it stopped being true, and why?\n(--force adds it anyway)");
        }
    }
    my ($id, $ns) = choose-identity($path, $name, :$namespace, :$text);
    add-invariant($path, $text, :name($id), :$because, :namespace($ns), :$reach);
    say "Added INVARIANT $id.";
    note "note: no BECAUSE - say why it must survive, so nobody removes it by accident (--because=...)"
        unless ($because // '').trim || $form eq 'clauses';
}

# ------------------------------------------------------------ because

multi MAIN('because', Str $which?, Str $text?, Str :$file, Bool :$replace = False, Bool :$split = False) {
    attempt :intent, {
        my $path = resolve-target($file);
        my $name = display-name($path);
        if $split {
            my @done = $which.defined ?? (split-because($path, $which) andthen ((which-invariant($path, $which), $_),)) // () !! split-all-because($path);
            if @done {
                say "INVARIANT {.[0]}: moved under BECAUSE - {.[1]}" for @done;
                say "Check each one: the words are yours, only moved.";
            }
            else {
                say $which.defined
                    ?? "INVARIANT {which-invariant($path, $which)}: no reason found in its text; say it with 'iz4 because {which-invariant($path, $which)} WHY'"
                    !! "$name: no invariant carries a reason in its own text";
            }
            return 0;
        }
        user-error("iz4 because needs an invariant's name and the reason: iz4 because owner-adjusted 'why it must survive'")
            unless $which.defined && $text.defined;
        my $id = which-invariant($path, $which);
        if assess-because(check-doc($path).invariant($id).?text // '', $text) eq 'circular' && !$replace {
            user-error("that restates the invariant. Who would be harmed, surprised or let down if it stopped being true, and why?\n(--replace sets it anyway)");
        }
        set-because($path, $id, $text, :$replace);
        say "Set BECAUSE for INVARIANT $id.";
        0;
    }
}

#| The identity a person means, or what they typed when nothing matches:
#| the command that uses it says what is wrong.
sub which-invariant(IO::Path $path, Str $ref --> Str) {
    resolve-identity(check-doc($path), $ref) // $ref.trim;
}

# ---------------------------------------------------------- withdraw

#| Take a project invariant out, on a person's say-so.  The name is
#| retired for good; Git keeps the words.  The foundation cannot be
#| withdrawn.  Scripts pass --force in place of the question.
multi MAIN('withdraw', Str $which, Str :$file, Bool :$force = False, Bool :$keep-tests = False) {
    attempt :intent, {
        my $path = resolve-target($file);
        my $name = display-name($path);
        my $id   = which-invariant($path, $which);
        print pretty(invariant-text($path, $id)) unless is-foundation-id($id);   # the refusal below says why for the foundation
        # What goes with it is worked out, and shown, before anyone is asked.
        my $present = !is-foundation-id($id) && check-doc($path).invariant($id).defined;
        my %tests = $present ?? withdrawal-tests($path, check-doc($path), $id) !! %( remove => [], shared => [], unsaved => [] );
        my @remove = $keep-tests ?? () !! @(%tests<remove>);
        my @kept   = $keep-tests ?? @(%tests<remove>) !! ();
        unless $force || !$present {
            user-error("withdrawing an invariant needs a person: run this on a terminal (a script passes --force)")
                unless interactive();
            say "Withdrawing retires the name $id for good (never reused) and takes the words out of $name; Git keeps them.";
            if @remove {
                say "Its tests go with it: a test for an invariant that is gone protects nothing. Git keeps these too:";
                say "  $_" for @remove;
            }
            my $answer = yes-no(ask("Withdraw INVARIANT $id" ~ (@remove ?? " and remove {+@remove == 1 ?? 'that test' !! "those {+@remove} tests"}" !! '') ~ "? [y/N] ") // '', :default(False));
            unless $answer { say "INVARIANT $id stays" ~ (@remove ?? ', and so do its tests.' !! '.'); return 0 }
        }
        my $inv = withdraw-invariant($path, $id);
        say "Withdrew INVARIANT $id from $name: {$inv.text}";
        my @gone = remove-tests($path.parent, @remove);
        if @gone {
            say "Removed {+@gone == 1 ?? 'the test' !! "the {+@gone} tests"} that existed only for it:";
            say "  $_" for @gone;
        }
        my @next;
        for @(%tests<shared>) -> ($f, @also) {
            say "Left $f: it also names {@also.join(', ')}.";
            @next.push("take what was about $id out of $f; the rest of it still protects {@also.join(', ')}");
        }
        for @(%tests<unsaved>) -> $f {
            say "Left $f: Git does not hold it as it is, so removing it would lose it for good.";
            @next.push("delete $f yourself if it was only for $id, or commit it first");
        }
        @next.push("delete or re-home $_: it was only for $id (kept because of --keep-tests)") for @kept;
        @next.push("git add -A && git commit -m 'Withdraw $id: ...'  (say why, so the history explains it)");
        say-next(@next, :then('iz4 check'));
        0;
    }
}

# ------------------------------------------------------------ mode

#| vibe mode or solid: how much the project's own invariants are meant yet.
multi MAIN('mode', Str $mode?, Str :$file) {
    attempt :intent, {
        my $path = resolve-target($file);
        my $doc  = check-doc($path);
        my $name = display-name($path);
        without $mode {
            $doc.vibe
                ?? calm("$name is in vibe mode", 'Its invariants are still settling, and a change to them does not wait for a yes.',
                        :next(['mode solid' => 'when they are ready to hold']))
                !! calm("$name is solid", 'A change to one of its invariants waits for your yes.',
                        :next(['mode vibe' => 'while they are still settling']));
            return 0;
        }
        my $want = $mode.lc;
        user-error("iz4 mode takes vibe or solid; not '$mode'") unless $want eq 'vibe' | 'solid';
        my $now = set-mode($path, $want);
        if $now eq 'unchanged' { calm("$name is already " ~ ($want eq 'vibe' ?? 'in vibe mode' !! 'solid')); return 0 }
        my $agreed = git($path, 'rev-parse', '--git-dir')[0] == 0 && git-tracked($path)
            ?? 'Changing mode is itself something you agree to: commit it, and you are asked once.' !! '';
        if $want eq 'vibe' {
            calm("$name is in vibe mode",
                 'Changes to its invariants do not wait for a yes, and a failing test of one does not hold a commit. The foundation holds as ever.', $agreed,
                 :next(['mode solid' => 'when the invariants are ready to mean it']));
        }
        else {
            my %ev    = evidence-for(check-doc($path), $path.parent);
            my @own   = check-doc($path).invariants.grep(*.id.defined);
            my $named = @own.grep({ (%ev<state>{.id} // '') eq 'named' }).elems;
            calm("$name is solid",
                 'From now on a change to one of its invariants waits for your yes.',
                 (@own == $named ?? "All {+@own} of its own have a test." !! "$named of {+@own} have a test."), $agreed,
                 :next(@own == $named ?? () !! ['test' => 'writes the rest, so each one means something']));
        }
        0;
    }
}

# ------------------------------------------------------------ words for actions
#
# An action is a word.  Each of these is the same command as the flag
# beside it, which still works: hooks and scripts written before call it.

multi MAIN('foundation', 'restore', Str $file?) { MAIN('foundation', |($file // Empty), :restore) }
multi MAIN('split', Str $which?, Str :$file) { MAIN('because', |($which // Empty), :split, |(:$file if $file.defined)) }
multi MAIN('test', 'list', Str :$file) { MAIN('test', :list, |(:$file if $file.defined)) }
multi MAIN('update', 'check') { MAIN('update', :check) }
multi MAIN('migrate', 'preview', Str $file?, Str :$namespace, Str :$where) {
    MAIN('migrate', |($file // Empty), :dry-run, |(:$namespace if $namespace.defined), |(:$where if $where.defined));
}
multi MAIN('report', 'preview', Str :$file, Str :$release, Str :$run-id) {
    MAIN('report', :dry-run, |(:$file if $file.defined), |(:$release if $release.defined), |(:$run-id if $run-id.defined));
}
multi MAIN('gate', 'install', Bool :$enforce = False, Bool :$force = False, Str :$file) {
    MAIN('gate', :install-hook, :$enforce, :$force, |(:$file if $file.defined));
}
multi MAIN('review', 'install', Bool :$force = False, Str :$file) {
    MAIN('review', :install-hook, :$force, |(:$file if $file.defined));
}
#| 'iz4 agent install claude skill hooks': what to install, as words.
multi MAIN('agent', 'install', *@what where { .elems > 0 }, Bool :$strict = False, Str :$file) {
    my @known = <claude skill hooks>;
    my @bad = @what.grep({ $_ ne any(@known) });
    if @bad { note "iz4 agent install takes {@known.join(', ')}; not '{@bad[0]}'.\n"; note help-topic(topic('agent install')); exit 1 }
    MAIN('agent', 'install', :claude(so @what.grep('claude')), :skill(so @what.grep('skill')),
         |(:hooks if @what.grep('hooks')), :$strict, |(:$file if $file.defined));
}

# ------------------------------------------------------------ read

#| The foundation as every file carries it; 'restore' writes it into
#| the file when it is missing or altered.
multi MAIN('foundation', Str $file?, Bool :$restore = False) {
    attempt {
        unless $restore {
            # the form of the file here, else the newest
            my $clauses = (try check-doc(resolve-target($file)).form eq 'clauses') // True;
            say 'The foundation:';
            for ($clauses ?? FOUNDATION-CLAUSES !! FOUNDATION) -> %f {
                say sprintf('  %d  %-26s%s', %f<legacy>, %f<id>, %f<id> eq INVARIANT-ZERO ?? 'Invariant Zero: the foundation of the foundation' !! '').trim-trailing;
            }
            say '';
            print pretty(foundation-block(:$clauses));
            say '';
            say "(sha256 of the foundation text: {($clauses ?? FOUNDATION-CLAUSES-DIGEST !! FOUNDATION-DIGEST).substr(0, 12)}; every IZ4 carries it word for word)";
            return 0;
        }
        my $path = resolve-target($file);
        given restore-foundation($path) {
            when 'unchanged' { say "{display-name($path)}: the foundation is already there, word for word" }
            when 'written'   { say "{display-name($path)}: wrote the foundation after IS FOR WHO?" }
            when 'replaced'  { say "{display-name($path)}: replaced the foundation with its current words" }
            when 'tidied'    { say "{display-name($path)}: the foundation was right; the comments around it are brought up to date" }
        }
        my $doc = check-doc($path);
        say "  now: {$doc.foundation-status}";
        say-next(['iz4 check'], :then('iz4 foundation restore')) unless $doc.foundation-intact;
        $doc.foundation-intact ?? 0 !! 1;
    }
}

#| Tell the renderer which invariants are held, so the diamond before each
#| name is closed (a test names it, or it is the foundation) or open.
sub mark-held(IO::Path $path) {
    my $doc = check-doc($path);
    return unless $doc.ok;
    my %ev = evidence-for($doc, $path.parent);
    my %solid = |foundation-ids(:clauses).map(* => True), |foundation-ids().map(* => True);   # held word for word
    for $doc.invariants.grep(*.id.defined) -> $inv {
        my $held = (%ev<state>{$inv.id} // 'none') eq 'named';
        %solid{$inv.id} = $held;
        # the file writes the name short, under its header domain
        my $tail = '.' ~ ($doc.domain // '');
        %solid{$inv.id.substr(0, * - $tail.chars)} = $held if $doc.domain && $inv.id.ends-with($tail);
    }
    mark-solid(%solid);
}

multi MAIN('invariants', Str $file?) {
    attempt {
        my $path = resolve-target($file);
        mark-held($path);
        print pretty(effective-text(check-doc($path), :name(display-name($path))));
        0;
    }
}

multi MAIN('show', 'invariant', Str $which, Str :$file) {
    attempt {
        mark-held(resolve-target($file));
        print pretty(invariant-text(resolve-target($file), $which));
        0;
    }
}

multi MAIN('show', Str $a?, Str $b?) {
    attempt {
        my ($file, $part) = $a.defined && looks-like-file($a) ?? ($a, $b) !! (Str, $a);
        user-error("too many arguments") if $b.defined && !$file.defined;
        mark-held(resolve-target($file));
        print pretty(show-text(resolve-target($file), $part));
        0;
    }
}

# ------------------------------------------------------------ check

multi MAIN('check', Str $file?, Bool :$strict = False) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        my $doc  = check-doc($path);
        .say for $doc.report(:$name);

        # A checklist of file facts: a tick for what is true, a cross with
        # its remedy for what is not, and for every cross the next step
        # that clears it, listed in order at the end.  Whether the software
        # keeps its invariants is never a tick: a checker cannot know, so it
        # says so.
        my @rows;                      # (glyph, line, next step or '')
        my @next = $doc.fixes;         # the structural fixes come first, in line order
        my $errors = +$doc.errors;
        my $warns  = +$doc.warnings;
        @rows.push: ($errors == 0 ?? '✓' !! '✗',
            $errors == 0
                ?? "structure: valid" ~ ($warns ?? " ($warns warning{$warns == 1 ?? '' !! 's'} above)" !! '')
                !! "structure: $errors error{$errors == 1 ?? '' !! 's'} above - fix each line listed", '');
        @rows.push: $doc.for-what.defined && $doc.for-what ne ''
            ?? ('✓', "IS FOR WHAT: {short($doc.for-what)}", '')
            !! ('✗', "IS FOR WHAT: missing - what is this for? ('iz4 add for-what ...')", 'iz4 add for-what "what it is for"');
        @rows.push: $doc.for-who.defined && $doc.for-who ne ''
            ?? ('✓', "IS FOR WHO: {short($doc.for-who)}", '')
            !! ('✗', "IS FOR WHO: missing - who is this for? ('iz4 add for-who ...')", 'iz4 add for-who "who it is for"');
        @rows.push: ($doc.foundation-intact ?? '✓' !! '✗', $doc.foundation-status, $doc.foundation-intact ?? '' !! 'iz4 foundation restore');

        my sub lbl($id) { $id }
        my sub lbls(@ids) { @ids.join(', ') }

        my $count = $doc.invariants.elems;
        my $unnamed = +$doc.unnamed-invariants;
        if $unnamed {
            @rows.push: ('✗', "invariants: $unnamed of $count unnamed - every invariant has a name", '');
        }
        elsif $count {
            my $ns = $doc.namespace;
            @rows.push: ('✓', "invariants: $count of your own, named" ~ ($ns ?? " under $ns" !! ''), '');
        }
        else {
            @rows.push: ('✓', "invariants: none of your own yet, which is a fine start ('iz4 add' helps you find one)", '');
        }
        if $count && $doc.vibe {
            # still settling: say where things stand in a line, and ask for nothing
            my %ev    = evidence-for($doc, $path.parent);
            my $named = $doc.invariants.grep({ .id.defined && (%ev<state>{.id} // '') eq 'named' }).elems;
            my $why   = $count - $doc.unexplained-invariants.elems;
            @rows.push: ('✓', "vibe mode: $count settling, $why with a reason, $named with a test. Nothing waits on you; 'iz4 mode solid' when they are ready to hold.", '');
        }
        elsif $count {
            my @bare   = $doc.unexplained-invariants;
            my @folded = @bare.grep({ split-reason(.text)[1].defined }).map({ .id // 'unnamed' });
            my @plain  = @bare.grep({ !split-reason(.text)[1].defined }).map({ .id // 'unnamed' });
            @rows.push: ('✗', "BECAUSE: {lbls(@folded)} carr{@folded == 1 ?? 'ies' !! 'y'} the reason inside the invariant - 'iz4 split' moves it under BECAUSE", 'iz4 split')
                if @folded;
            @rows.push: ('✗', "BECAUSE: missing for {lbls(@plain)} - write under each why it must survive ('iz4 because NAME WHY')",
                @plain.map({ "iz4 because $_ \"why it must survive\"" }).join("\n"))
                if @plain;
            @rows.push: ('✓', 'BECAUSE: every invariant says why it must survive', '') unless @bare;

            # evidence: a test that names the invariant.  Named is a test;
            # scaffolded is the born-red placeholder; none is none.
            my %ev = evidence-for($doc, $path.parent);
            my sub in-order(@ids) { @ids.sort({ $_ ~~ /^ \d+ $/ ?? (0, +$_, '') !! (1, 0, $_) }) }
            my @none = in-order(%ev<state>.pairs.grep(*.value eq 'none').map(*.key));
            my @scaf = in-order(%ev<state>.pairs.grep(*.value eq 'scaffolded').map(*.key));
            my $named = %ev<state>.values.grep(* eq 'named').elems;
            my @draft = in-order(%ev<state>.pairs.grep(*.value eq 'drafted').map(*.key));
            @rows.push: ('✗', "evidence: {lbls(@scaf)} ha{@scaf == 1 ?? 's' !! 've'} only a scaffold - write the assertion in {%ev<files>{@scaf[0]}[0]}" ~ (@scaf > 1 ?? ' and the others' !! ''),
                @scaf.map({ "write the assertion for {lbl($_)} in {%ev<files>{$_}[0]}" }).join("\n"))
                if @scaf;
            @rows.push: ('✗', "evidence: {lbls(@draft)} ha{@draft == 1 ?? 's' !! 've'} an agent-drafted test awaiting review - read {%ev<files>{@draft[0]}[0]}" ~ (@draft > 1 ?? ' and the others' !! '') ~ ", run it, make sure it can fail, then delete its first line",
                @draft.map({ "review {%ev<files>{$_}[0]} ({lbl($_)}): run it, make sure it can fail, then delete its first line" }).join("\n"))
                if @draft;
            @rows.push: ('✗', "evidence: {lbls(@none)} ha{@none == 1 ?? 's' !! 've'} no test naming {@none == 1 ?? 'it' !! 'them'}" ~ (" - 'iz4 test' scaffolds one"),
                "iz4 test {@none.join(' ')}")
                if @none;
            @rows.push: ('✓', "evidence: every invariant is named by a test ($named of $count)", '') unless @none || @scaf || @draft;
        }

        if $path.basename eq ROOT-NAME {
            my $root = $path.parent;
            my %s    = agent-status($path, :$root);
            for expected-integrations(:$root) -> $i {
                my $status = %s<integrations>{$i};
                @rows.push: ($status eq 'current' ?? '✓' !! '✗',
                    integration-line($i, $status, :reason($status eq 'stale' ?? stale-reason($root.add($i)) !! '')),
                    $status eq 'current' ?? '' !! integration-next($i, $status));
            }
        }

        @rows.push: ('?', "the system keeps its invariants (the foundation" ~ ($count ?? " and its own $count" !! '') ~ "): uncertain - a checker cannot verify "
            ~ "natural-language invariants; review consequential changes against 'iz4 invariants'", '');

        say pretty(mark(.[0]) ~ ' ' ~ .[1]) for @rows;
        say pretty('checked: file facts only; a passing check never means the system is safe, '
          ~ 'harmless, or keeps its invariants');
        my $crosses = @rows.grep({ .[0] eq '✗' }).elems;

        # The next steps, each once, in the order that clears the most first:
        # structure, then each cross in checklist order, then a check again.
        for @rows.grep({ .[0] eq '✗' && .[2] ne '' }).map({ .[2].lines }).flat -> $step {
            @next.push($step) unless @next.first(* eq $step).defined;
        }
        say-next(@next, :then($strict ?? 'iz4 check --strict' !! 'iz4 check')) if @next;
        if $doc.ok && !($strict && $crosses) {
            say pretty("OK $name" ~ ($crosses ?? " ($crosses to remedy above)" !! ''));
            0;
        }
        elsif $doc.ok {
            # --strict, for a gate: a cross is a failure, and the verdict says so last
            say pretty("NOT YET $name: $crosses to remedy above (--strict) - do the next steps above, then 'iz4 check --strict' again");
            1;
        }
        else {
            say "NOT YET $name: $errors error{$errors == 1 ?? '' !! 's'} - do the next steps above, then 'iz4 check' again";
            1;
        }
    }
}

#| The numbered next steps that clear what a command found, and the one
#| that confirms it.  A step is a command to run or, where iz4 must not
#| touch a person's words, what to change by hand.
sub say-next(@steps, Str :$then) {
    say pretty('next:');
    my $n = 0;
    say "  {++$n}. $_" for @steps;
    say "  then: $then again" with $then;
}

sub short(Str $s --> Str) { $s.chars > 60 ?? $s.substr(0, 57).trim-trailing ~ '...' !! $s }

#| One plain glyph: green tick, red cross, yellow question; coloured only
#| on a terminal that has not asked for no colour.
sub mark(Str $glyph --> Str) {
    return $glyph if %*ENV<NO_COLOR> || !$*OUT.t;
    my $colour = do given $glyph { when '✓' { 32 }; when '✗' { 31 }; default { 33 } };
    "\e[{$colour}m$glyph\e[0m";
}

# ------------------------------------------------------------ test

multi MAIN('test', *@which, Str :$file, Str :$lang, Bool :$list = False, Bool :$draft = True) {
    attempt {
        my $path = resolve-target($file);
        my $root = $path.parent;
        my $doc  = check-doc($path);
        user-error("fix the errors 'iz4 check' reports first") if $doc.errors;
        my %ev = evidence-for($doc, $root);
        if $list || !$doc.invariants {
            say "No project invariants yet; 'iz4 add' finds one." unless $doc.invariants;
            for $doc.invariants.grep(*.id.defined) -> $inv {
                my $n = $inv.id;
                say sprintf('  %-10s %s  %s', %ev<state>{$n}, $n, (%ev<files>{$n} // ()).join(', '));
            }
            say "named: a reviewed test names it; drafted: an agent's draft awaiting review; scaffolded: the born-red placeholder; none: nothing.";
            say "Evidence that an invariant holds is a test that would fail if it stopped being true; a name alone is not that.";
            return 0;
        }
        my @only = @which.map({ resolve-identity($doc, $_) // user-error("no invariant '$_' in {display-name($path)}; 'iz4 test list' shows the names") });
        for @only { user-error("no invariant $_ in {display-name($path)} of its own to test") unless $doc.invariant($_) }
        my $language = $lang // detect-language($root);
        user-error("no scaffold for language '$language'; --lang takes one of {LANGUAGES.join(', ')}")
            unless so $language eq any(LANGUAGES);

        # With an agent and a person present, draft the real test and ask;
        # a draft is written only on a yes, and is marked for review.
        my @drafted;
        say "No agent to draft with (321, or your own IZ4_AGENT_CMD): writing scaffolds for you to fill in."
            if $draft && interactive() && !agent-reachable();
        if $draft && interactive() && agent-reachable() {
            my $layout = gather-context($root);
            for $doc.invariants.grep(*.id.defined) -> $inv {
                my $n = $inv.id;
                next if @only && $n ne any(@only);
                next if %ev<state>{$n} ne 'none';
                my ($rel, $) = scaffold($language, $inv);
                next if $root.add($rel).e;
                say '';
                say "INVARIANT $n: {$inv.text}";
                say "asking agent ({agent-label()}) for a test ($language, $rel) ...";
                my $d = try agent-draft($doc, $inv, $root, :lang($language), :path($rel), :$layout);
                without $d { say "  no draft: {$!.message.lines.head}; a scaffold will be written instead"; next }
                with $d<cannot> { say "  the agent declined: $_"; say "  a scaffold will be written instead"; next }
                say '';
                say $d<text>.lines.map({ "    $_" }).join("\n");
                say '';
                my $answer = (ask("Write it to $rel, marked for your review? [Y/n/q] ") // 'q').trim.lc;
                last if $answer.starts-with('q');
                next if $answer.starts-with('n');
                $root.add($rel).parent.mkdir;
                $root.add($rel).spurt(marked-draft($language, $d<text>));
                @drafted.push: ($rel, $n);
            }
            %ev = evidence-for($doc, $root);
        }
        my @done = write-scaffolds($doc, $root, :lang($language), :@only);
        if @drafted {
            say '';
            say "Drafted {+@drafted} test{+@drafted == 1 ?? '' !! 's'} ($language), each marked for review on its first line:";
            say "  $_[0]  ($_[1])" for @drafted;
            say "A draft is not evidence until you have read it, run it, seen that it can fail, and deleted that line.";
        }
        if @done {
            say '';
            say "Scaffolded {+@done} test{+@done == 1 ?? '' !! 's'} ($language), each failing until you write the assertion:";
            say "  $_[0]  ($_[1])" for @done;
            say "A scaffold is not evidence: 'iz4 check' counts it only once its placeholder is gone.";
            say "On a terminal with an agent (IZ4_AGENT_CMD), 'iz4 test' drafts the real test for you to approve." unless $draft && interactive();
        }
        unless @drafted || @done {
            say @only
                ?? "Nothing to write: {@only.join(', ')} already ha{@only == 1 ?? 's' !! 've'} a test naming it (or its file exists)."
                !! "Nothing to write: every invariant already has a test naming it, or its file exists ('iz4 test list').";
        }
        0;
    }
}

#| Name the unnamed INVARIANT on a line.  A name already given is an
#| identity and is not changed here.
multi MAIN('name', Int $line, Str $name, Str :$file, Str :$namespace) {
    attempt :intent, {
        my $path = resolve-target($file);
        my $id = name-invariant($path, $line, choose-identity($path, $name, :$namespace)[0]);
        say "Named the invariant on line $line of {display-name($path)}: INVARIANT $id";
        0;
    }
}

# ------------------------------------------------------------ where

#| Say where an invariant applies: its WHERE.
multi MAIN('where', Str $which, Str $text, Str :$file) {
    attempt :intent, {
        my $path = resolve-target($file);
        say "{set-reach($path, $which, $text)} now applies where: $text";
        0;
    }
}

# ------------------------------------------------------------ migrate

multi MAIN('migrate', Str $file?, Str :$namespace, Str :$where, Bool :$dry-run = False) {
    attempt :intent, {
        my $path = resolve-target($file);
        if check-doc($path).form eq 'clauses' { say "{display-name($path)} is already in the canonical form; there is nothing to migrate."; return 0 }
        migrate-clauses-command($path, :$namespace, :$where, :$dry-run);
    }
}

#| Move an IZ4 from named invariants to the three-clause form.  The new thing
#| is FOR: who or what each invariant covers.  It is the owner's to say:
#| asked for on a terminal, given with --where=NAME=SITUATION in a script,
#| never made up.  The words of each stay word for word.  Nothing is
#| written until every invariant has its WHERE; with one missing and nobody
#| to ask, the exit code is 2: a person is needed.
sub migrate-clauses-command(IO::Path $path, Str :$namespace, Str :$where, Bool :$dry-run --> Int) {
    my $name = display-name($path);
    my %plan = clauses-migration-plan($path);
    user-error("cannot migrate $name: %plan<stop>") if %plan<stop>;
    my $ns = ($namespace // %plan<domain> // (%*ENV<IZ4_NAMESPACE> // '').trim // '').trim.lc;
    my @own = %plan<own>.list;

    my %given;
    for ($where // '').split('|').map(*.trim).grep(* ne '') -> $pair {
        user-error("--where takes NAME=SITUATION, like --where=private-stays-private='a private profile can be seen by anyone but its owner' (several: join them with |); '$pair' is not one")
            unless $pair ~~ /^ (\S+?) '=' (.+) $/;
        my $id = (try resolve-identity(check-doc($path), ~$0)) // ~$0;
        user-error("--where names '$0', and $name has no such invariant of its own") unless @own.first({ .<id> eq $id });
        %given{$id} = (~$1).trim;
    }
    my @missing = @own.grep({ !(%given{.<id>}:exists) });

    say "Moving $name to the three-clause form: each invariant says where it applies (WHERE), what must remain true there (ALWAYS) and what must not be defeated (PROTECTS).";
    say "Your words become ALWAYS and PROTECTS word for word; WHERE is the new part, and it is yours to say.";
    my @unexplained = @own.grep({ !(.<because> // '').trim });
    if @unexplained {
        say '';
        say "These have no BECAUSE, and PROTECTS is required in the three-clause form: whose what would be lost if it stopped holding?";
        say "  iz4 because {.<id>.split('.')[0]} 'whose what'" for @unexplained;
        say 'Nothing was written.';
        return 2;
    }
    if $ns eq '' {
        user-error("the header names the project's domain, and $name does not show one: pass --namespace=your.domain") unless interactive();
        $ns = init-namespace(Str);
    }
    if @missing && !interactive() {
        say '';
        say "These need a WHERE, and only you can say it:";
        say "  {.<id>}: {short(.<text>)}" for @missing;
        say '';
        say 'Nothing was written. Run it on a terminal to be asked, or give them:';
        say "  iz4 migrate --where={@missing[0]<id>.split('.')[0]}='the situation it applies in'" ~ (@missing > 1 ?? '|...' !! '');
        return 2;
    }
    for @missing -> %o {
        say '';
        say "{%o<id>}";
        say "  ALWAYS:   {%o<text>}";
        say "  PROTECTS: {%o<because> // '(none)'}";
        for ^3 {
            my $answer = (ask(REACH-QUESTION ~ "\n> ") // user-error("{%o<id>}: no WHERE given; nothing was written")).trim;
            if $answer eq '' { say 'A WHERE is needed: the situation it applies in.'; next }
            if vague-reach($answer) {
                say $answer.chars <= 3 ?? "That is not a situation. Where does this invariant apply: which data, actions or moments?" !! "That covers a lot. Which situations exactly: which data, actions or moments? (enter keeps it)";
                my $more = (ask('> ') // '').trim;
                if $more ne '' { $answer = $more } elsif $answer.chars <= 3 { say 'A WHERE is needed.'; next }
            }
            %given{%o<id>} = $answer; last;
        }
        user-error("{%o<id>}: no WHERE given; nothing was written") unless %given{%o<id>}:exists;
    }
    if $dry-run {
        say '';
        say "WHERE of each, as it would be written:";
        say "  {.<id>}  WHERE  {%given{.<id>}}" for @own;
        say 'Dry run: nothing was written.';
        return 0;
    }
    migrate-clauses($path, %given, :namespace($ns));
    say '';
    say "Wrote $name in the three-clause form: header 'IZ4 $ns', your own invariants in three clauses, the foundation last. Not a word of your own changed.";
    say-next(['iz4 check', "iz4 gate --staged   (after 'git add': it shows each WHERE as a change to agree to)", 'iz4 approve'], :then(Str));
    0;
}

# ------------------------------------------------------------ review

multi MAIN('review', *@range, Str :$file, Bool :$staged = False, Bool :$for-push = False,
           Bool :$offline = False, Bool :$strict = False, Bool :$install-hook = False, Bool :$force = False) {
    attempt {
        my $path = resolve-target($file);
        if $install-hook {
            say "pre-push hook: {install-hook($path, :$force)} (advisory; set IZ4_REVIEW_STRICT=1 to make it block on a conflict)";
            return 0;
        }
        my $doc = check-doc($path);
        user-error("fix the errors 'iz4 check' reports before reviewing") if $doc.errors;
        my ($diff, $what) = change-diff($path, |($for-push ?? (push-range($path),) !! @range), :$staged);
        .say for offline-report($doc, $diff, :$what);
        return 0 unless $diff.trim;
        return 0 if $offline;

        my $review = try agent-review($path, :$diff, :$what);
        without $review {
            say "No agent review: {$!.message.lines.head} (IZ4_AGENT_CMD names your agent; --offline skips this).";
            return 0;
        }
        say '';
        .say for assessment-lines($review, $doc);
        my $conflicts = $review<assessments>.grep(*<level> eq 'conflicting').elems;

        if $review<candidates> {
            for $review<candidates>.list -> %c {
                say '';
                say "Candidate invariant ({%c<class>.lc}): {%c<text>}";
                say "  BECAUSE {%c<because>}" if %c<because>;
                say "  Evidence that would show it holds: {%c<evidence>}" if %c<evidence>;
                if interactive() {
                    my $answer = (ask('Consider it? [Y/n/q] ') // 'q').trim.lc;
                    last if $answer.starts-with('q');
                    next if $answer.starts-with('n');
                    coach-into($path, :candidate(%c<text>), :suggested-because(%c<because>));
                }
            }
            say "Nothing was added. Add one with 'iz4 add' if you agree." unless interactive();
        }
        say '';
        say $conflicts
            ?? "A conflict is the agent's reading of the diff, with its evidence above; you decide."
            !! "No conflict reported. That is one reading of the diff, not a proof.";
        $strict && $conflicts ?? 1 !! 0;
    }
}

# ------------------------------------------------------------ suggest

multi MAIN('suggest', Str :$file) {
    attempt {
        my $path = try resolve-target($file);
        my $dir  = $path.defined ?? $path.parent !! $*CWD;
        my $reply = try agent-suggest($dir, current => ($path.defined ?? $path.slurp !! ''));
        user-error("agent suggestion failed: {$!.message.lines.head}; nothing was added") without $reply;
        show-suggestions(%$reply, $path);
        0;
    }
}

#| From init: ask the agent for candidates and go through them.  False
#| when the agent could not be asked, so the caller can coach instead.
sub review-suggestions(IO::Path $path, Bool :$quiet = False --> Bool) {
    my $reply = try agent-suggest($path.parent, current => $path.slurp);
    without $reply {
        say "The agent could not be asked ({$!.message.lines.head}), so one question at a time instead." unless $quiet && !$!.message;
        return False;
    }
    show-suggestions(%$reply, $path);
    True;
}

#| Said beside a draft that still runs long, so the person cuts it
#| rather than keeping words nobody will read.
sub long-note(Str $text --> Str) {
    "That is {draft-words($text)} words, which is long to read before every change. Say it shorter if you keep it.";
}

sub show-suggestions(%s, $path) {
        my ($strong, $possible) = %s<found><strong possible>;
        my $left = %s<implementation> + %s<not-iz4>;
        say 'Analysed repository.';
        say "I found $strong strong candidate invariant{$strong == 1 ?? '' !! 's'} and $possible "
          ~ "thing{$possible == 1 ?? '' !! 's'} that may depend on product intent.";
        if $strong > %s<strong> || $possible > %s<possible> {
            say "Showing the strongest {+%s<strong>} and {+%s<possible>}: fewer, stronger invariants beat apparent completeness.";
        }
        say "Left out $left as implementation or not IZ4 (for example: {%s<implementation>[0]<text> // %s<not-iz4>[0]<text>})." if $left;
        unless %s<strong> || %s<possible> {
            say "Nothing stood out as enduring intent. That is a fine answer; 'iz4 add' when something does.";
            return;
        }

        if !$path.defined || !interactive() {
            for %s<strong>.list -> %c {
                say "\nStrong candidate: {%c<text>}";
                say "  {long-note(%c<text>)}" if too-long(%c<text>);
                say "  BECAUSE: {%c<because>}" if %c<because>;
            }
            for %s<possible>.list -> %c {
                say "\nPossible, needs your intent: {%c<text>}";
                say "  {long-note(%c<text>)}" if too-long(%c<text>);
                say "  Only you can say: {%c<question>}" if %c<question>;
            }
            say '';
            say $path.defined
                ?? "Nothing was added. Review them on a terminal with 'iz4 suggest', or add one with 'iz4 add'."
                !! "Nothing was added. Run 'iz4 init' first, then 'iz4 suggest' again.";
            return;
        }

        say "Let's review the strongest one first.";
        my @queue = |%s<strong>.map({ %( |$_, kind => 'strong' ) }),
                    |%s<possible>.map({ %( |$_, kind => 'possible' ) });
        for @queue -> %c {
            say '';
            say %c<kind> eq 'strong' ?? "Candidate: {%c<text>}" !! "Possible: {%c<text>}";
            say long-note(%c<text>) if too-long(%c<text>);
            say "Only you can say: {%c<question>}" if %c<question>;
            my $answer = (ask('Consider it? [Y/n/q] ') // 'q').trim.lc;
            last if $answer.starts-with('q');
            next if $answer.starts-with('n');
            coach-into($path, :candidate(%c<text>), :suggested-because(%c<because>));
        }
}

multi MAIN('log', Str $file?) {
    attempt {
        print log-text(resolve-target($file));
        0;
    }
}

multi MAIN('diff', *@args) {
    attempt {
        my $file = @args && looks-like-file(@args[0]) ?? @args.shift !! Str;
        user-error("diff takes at most two revisions") if @args > 2;
        my ($rc, $out, $err) = diff-result(resolve-target($file), |@args);
        if $rc == 127 { say $err.trim; return 0 }      # no Git: informational, like log
        print $out;
        note $err.trim if $err.trim ne '';
        $rc;
    }
}

multi MAIN('version') {
    say "iz4 {VERSION}" ~ (own-revision() andthen " ($_)" orelse '');
}

multi MAIN('update', Bool :$check = False) {
    attempt {
        my %u = self-update(:$check);
        my sub commits() { say "  $_" for %u<commits>.head(8); say "  ..." if %u<commits> > 8 }
        my $rc = do given %u<state> {
            when 'current'  { say "iz4 is up to date ({VERSION}, {%u<from>})."; 0 }
            when 'behind'   { say "iz4 is {%u<n>} commit{%u<n> == 1 ?? '' !! 's'} behind; 'iz4 update' fetches:"; commits(); 0 }
            when 'updated'  { say "Updated iz4 from {%u<from>} to {%u<to>} ({%u<n>} commit{%u<n> == 1 ?? '' !! 's'}):"; commits(); 0 }
            when 'managed'  { say %u<note>; 0 }
            default         { note %u<note>; 1 }
        };
        # 321, when iz4 installed it, is kept current too; one someone else installed is left alone.
        # A source install runs the checkout's bin/iz4 through a launcher script on PATH, so
        # the marker is looked for beside that script as well as beside the program itself.
        my $bin-dir = launcher-owner-dir();
        if $bin-dir.defined {
            my %l = launcher-install(:$bin-dir, :$check);
            given %l<state> {
                when 'current' { say "321.do, an agent launcher, is up to date ({%l<version>})." }
                when 'behind'  { say "321.do, an agent launcher, is behind: {%l<version>} installed, {%l<tag>} published; 'iz4 update' fetches it." }
                when 'updated' { say "Updated 321.do, an agent launcher, from {%l<from>} to {%l<version>}." }
                when 'installed' { say "Installed 321.do, an agent launcher ({%l<version>}) at {%l<path>}." }
                default        { note "321.do: {%l<note>}" }
            }
        }
        $rc;
    }
}

multi MAIN('agent', Bool :$json = False, Str :$file) {
    attempt {
        my %p = agent-packet(resolve-target($file));
        print $json ?? json-encode(%p) ~ "\n" !! packet-text(%p);
        0;
    }
}

multi MAIN('agent', 'install', Bool :$claude = False, Bool :$skill = False, Bool :$hooks,
           Bool :$strict = False, Str :$file) {
    attempt {
        my $root = resolve-target($file).parent;
        for 'AGENTS.md', |($claude ?? 'CLAUDE.md' !! Empty) -> $name {
            say "$name: {install-agent-section($root.add($name), :$root)}";
        }
        say "{SKILL-PATH}: {install-skill(:$root)}" if $skill;
        # Hooks are wired by an environment driver: something that knows
        # the agent harness.  iz4 knows none, and writes into none.  By
        # default, where the driver finds a harness here with nothing wired,
        # it is asked for the advisory set, which delivers the context and
        # refuses nothing.  Wiring already there is never replaced or
        # downgraded by a default run; --hooks asks outright, --strict asks
        # for everything the harness can enforce, --/hooks leaves it alone.
        # Asked for hooks outright, iz4 first makes sure its environment
        # driver is there, installing the official 321 when it is not.
        if (($hooks // False) || $strict) && !driver-binary().defined {
            my %d = ensure-driver();
            given %d<state> {
                when 'installed' { say "321 {%d<version>} installed at {%d<path>}: the environment driver iz4 uses to wire a harness." }
                when 'updated'   { say "321 updated from {%d<from>} to {%d<version>} at {%d<path>}." }
                when 'failed' | 'too-old' | 'foreign' { note "321: {%d<note>}" }
            }
        }
        my $driver = driver-binary();
        my %before = $driver.defined ?? ((try driver($driver, 'status', :$root)) // %()) !! %();
        my $here   = so @(%before<harnesses> // []).grep({ .<detected> });
        my $by-default = !$hooks.defined && !$strict && $here && driver-level(%before) eq 'none';
        my $hooks-now = $hooks // ($strict || $by-default);
        say "hooks: installing the advisory set by default, since an agent harness is in use here (--/hooks to skip, --strict to add the gates)"
            if $by-default;
        my $failed = False;
        # A plain install with no driver wires nothing; where the repository
        # is set up for an agent, one line says whose job that is.
        if !$hooks-now && !$hooks.defined && !$driver.defined {
            my @legacy = legacy-hooks(:$root);
            if @legacy { say "hooks: the Claude Code hooks an earlier iz4 wrote ({@legacy.join(', ')}) are untouched and still active; 321 {DRIVER-MIN-VERSION} or later can adopt them (321 iz4 install)" }
            elsif expected-integrations(:$root).elems > 1 { say "hooks: none installed. Driving an agent harness is 321's job: with 321 {DRIVER-MIN-VERSION} or later ({LAUNCHER-RELEASES}), run 321 iz4 install" }
        }
        if $hooks-now {
            with $driver -> $bin {
                my %h = driver($bin, 'install', :$root, :advisory(!$strict));
                say "hooks via 321 {launcher-version($bin)}, for every harness it knows:";
                say "  $_" for driver-lines(%h);
                $failed = so @(%h<harnesses> // []).grep({ (.<action> // '') eq 'failed' });
            }
            else {
                # Nothing here knows a harness.  Asked with --strict that is a
                # failure; asked without, it is a warning and the rest stands.
                $failed = $strict;
                note no-driver-lines(:$root).join("\n");
            }
        }
        say "These integrations only encourage adherence in tools that load them"
          ~ ($hooks-now && $driver.defined ?? '; a hook can prove the packet was delivered and a report written, never that an invariant was honoured.' !! '.');
        $failed ?? 1 !! 0;
    }
}

#| What is said when hooks are asked for and nothing here knows a harness.
sub no-driver-lines(IO::Path :$root! --> List) {
    my $bin = launcher-binary();
    my @legacy = legacy-hooks(:$root);
    my @l = "hooks: not installed.",
            "  IZ4 defines the invariant checks but does not install agent-environment hooks directly.",
            ($bin.defined
                ?? "  No environment driver is available: the 321 here is {launcher-version($bin)}, and wiring a harness needs {DRIVER-MIN-VERSION} or later."
                !! "  No environment driver is available."),
            "  Install 321 {DRIVER-MIN-VERSION} or later ({LAUNCHER-RELEASES}), then run: 321 iz4 install",
            "  Any other environment can call iz4 itself: iz4 context, iz4 check action, iz4 check change, iz4 verify (docs/drivers.md).";
    @l.push("  The Claude Code hooks an earlier iz4 wrote here ({@legacy.join(', ')}) are untouched and still active.") if @legacy;
    @l.List;
}

#| How the hooks an earlier iz4 wrote can be handed to a driver, given
#| what is installed here.
sub legacy-migration(--> Str) {
    my $bin = launcher-binary();
    return "321 {launcher-version(driver-binary())} can adopt this wiring: 321 iz4 install" if driver-binary().defined;
    return "321 {DRIVER-MIN-VERSION} or later can adopt this wiring; the 321 here is {launcher-version($bin)}. Nothing needs doing until then." if $bin.defined;
    "321 {DRIVER-MIN-VERSION} or later can adopt this wiring; no 321 is installed. Nothing needs doing until then.";
}

# ------------------------------------------------------------ hook

#| The harness-neutral hook contract: JSON in, text for the model out,
#| exit 2 with a reason on standard error to refuse.
multi MAIN('hook', Str $event where 'session-start' | 'pre-edit' | 'stop', Str :$file) {
    my %input = read-input($*IN.slurp);
    my $path = try resolve-target($file);
    without $path { exit ALLOW }                # no IZ4 here: nothing to insist on
    my ($exit, $out, $err) = do given $event {
        when 'session-start' { on-session-start($path, %input) }
        when 'pre-edit'      { on-pre-edit($path, %input) }
        when 'stop'          { on-stop($path, %input) }
    };
    print $out if $out;
    note $err.trim-trailing if $err;
    exit $exit;
}

multi MAIN('agent', 'status', Bool :$json = False, Bool :$strict = False, Str :$file) {
    attempt {
        my IO::Path $path = (try resolve-target($file)) // IO::Path;   # no IZ4 here is a status, not an error
        my $root = $path.defined ?? $path.parent !! $*CWD;
        my %s    = agent-status($path, :$root);
        my $bin = launcher-binary();
        with $bin { %s<launcher> = %( binary => $_, version => launcher-version($_) ) }
        # What is wired into a harness is the driver's to say; iz4 reads no
        # harness's configuration.
        my $driver = driver-binary();
        my %enf = $driver.defined ?? ((try driver($driver, 'status', :$root)) // %()) !! %();
        # The one thing iz4 does read is wiring an earlier iz4 wrote itself,
        # so that hooks still firing are never reported as absent.
        my @legacy = legacy-hooks(:$root);
        %s<hooks> = %enf ?? driver-level(%enf) !! @legacy ?? 'aware' !! 'unknown';
        %s<legacy_hooks> = %( harness => 'claude_code', file => LEGACY-SETTINGS, events => [ |@legacy ],
            managed_by => 'legacy iz4 wiring', enforcement => 'aware', migration => legacy-migration() ) if @legacy;
        %s<enforcement> = %enf if %enf;
        if $json { say json-encode(%s) }
        else {
            if %s<iz4><present> {
                say "IZ4: {display-name($path)} - " ~ (%s<iz4><valid>
                    ?? 'valid'
                    !! "INVALID ({%s<iz4><errors>} errors - run 'iz4 check')");
                say %s<iz4><binding>;
            }
            else { say 'IZ4: none found in this directory or its parents' }
            for 'AGENTS.md', 'CLAUDE.md', SKILL-PATH -> $i {
                my $status = %s<integrations>{$i};
                say integration-line($i, $status, :reason($status eq 'stale' ?? stale-reason($root.add($i)) !! ''));
            }
            if %enf {
                say "321 {%s<launcher><version>}, an agent launcher, is installed: agent runs, suggest, review and test drafting go through it,";
                say "and it drives iz4 in every harness it knows and says how strongly it is enforced:";
                say "  $_" for driver-lines(%enf);
            }
            elsif $driver.defined { say "321 is installed at $driver but '321 iz4 status' failed" }
            elsif $bin.defined {
                say "321 {%s<launcher><version>} is installed, but wiring a harness needs {DRIVER-MIN-VERSION} or later"
                  ~ (@legacy ?? '' !! ": iz4 finds no hooks of its own here, and wires none itself");
            }
            else {
                say "321, an agent launcher, is not installed: "
                  ~ (%*ENV<IZ4_AGENT_CMD> ?? "agent prompts go to your IZ4_AGENT_CMD ({%*ENV<IZ4_AGENT_CMD>})"
                                          !! "suggest, review and test drafting need it, or your own IZ4_AGENT_CMD")
                  ~ (@legacy ?? '' !! ", and iz4 finds no hooks of its own here (iz4 leaves agent environments to a driver: docs/drivers.md)");
            }
            if @legacy { .say for legacy-hooks-lines(@legacy, :migration(legacy-migration())) }
            say %s<note>;
            # the next steps for whatever is not in place, in the order that
            # clears the most first: a file to work on, then the hooks, which
            # are the one step that enforces anything, then the wording
            my @next;
            my $want-hooks = $driver.defined && %s<hooks> ne 'guarded' && so @(%enf<harnesses> // []).grep({ .<detected> });
            # With no driver nothing can be enforced; where the repository is
            # set up for an agent, getting one is the first step.
            my $want-driver = !$driver.defined && expected-integrations(:$root).elems > 1;
            my $driver-step = "install 321 {DRIVER-MIN-VERSION} or later (the environment driver), then: 321 iz4 install";
            @next.push('iz4 init') unless %s<iz4><present>;
            @next.push('iz4 check') if %s<iz4><present> && !%s<iz4><valid>;
            @next.push('321 iz4 install') if $want-hooks && %s<iz4><present>;
            @next.push($driver-step) if $want-driver && %s<iz4><present>;
            for expected-integrations(:$root) -> $i {          # the Claude entry points only where Claude is used
                @next.push(integration-next($i, %s<integrations>{$i})) unless %s<integrations>{$i} eq 'current';
            }
            @next.push('321 iz4 install') if $want-hooks && !%s<iz4><present>;
            say-next(@next, :then('iz4 agent status')) if @next;
        }
        my $fail = !%s<iz4><present> || !%s<iz4><valid>
                || ?%s<integrations>.values.grep(* eq 'stale' | 'malformed');
        ($strict && $fail) ?? 1 !! 0;
    }
}

multi MAIN('register', Str :$url, Str :$token, Str :$file,
           Bool :$github = False, Bool :$force = False) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        with $url {
            my $f = save-register-url($path, $url);
            say "Register URL saved to {display-name($f)}";
        }
        with $token {
            my $u = register-url($path)
                // user-error("save the reports URL first: iz4 register --url=<reports URL>");
            save-token($u, $token);
            say "Token saved to {token-store()} - outside the repository; do not commit it.";
        }
        if $github {
            my $u = register-url($path)
                // user-error("save the reports URL first: iz4 register --url=<reports URL> --github");
            say install-github-workflow($path, :$force) eq 'unchanged'
                ?? '.github/workflows/iz4.yml is already set up'
                !! 'Wrote .github/workflows/iz4.yml: every push installs iz4 (runtime cached) and runs iz4 report';
            my $t = $token // token-for($u);
            if $t.defined {
                given set-github-secret($path, $t) {
                    when 'set'   { say 'Stored the token as the repository secret S2R_TOKEN (GitHub CLI).' }
                    when 'no-gh' { say 'No GitHub CLI found. Add a repository secret named S2R_TOKEN with your token (Settings > Secrets and variables > Actions).' }
                    default      { user-error("the GitHub CLI could not set the secret ($_). Sign in with: gh auth login, then run: iz4 register --github") }
                }
                say "Next: commit and push {display-name(register-file($path))} and .github/workflows/iz4.yml; every push then reports.";
            }
            else {
                say 'No reporting token yet. Mint one on the Connect CI page, then: iz4 register --token=<token> --github';
            }
        }
        my $rc = 0;
        if !$url.defined && !$token.defined && !$github {
            with register-url($path) -> $u {
                say "$name reports to $u";
                with token-for($u) -> $t {
                    $rc = record-checkpoint($path, $u, $t);
                }
                else {
                    say "No reporting token yet. Mint one on the project's Connect CI page, then:\n  iz4 register --token=<token>";
                }
            }
            else {
                print qq:to/END/;
                $name is not connected to a register yet.

                To make it discoverable on the IZ4 register:
                  1. Sign up first (email passcode): {REGISTER-START}
                  2. Create a project there and mint a reporting token (shown once)
                  3. Connect this IZ4 (add --github to set up GitHub Actions too):
                       iz4 register --url=<the project's reports URL> --token=<the token>
                  4. Submit evidence: iz4 report
                  5. Publish the card on iz4.you, then record a checkpoint: iz4 register

                A report carries presence, digest, counts and check outcomes -
                never the text of your IZ4. Only register and report, and the
                agent behind suggest, reach the network; every other iz4
                command stays offline.
                END
            }
        }
        say '';
        say trademark-licence-note();
        $rc;
    }
}

#| A connected 'iz4 register' records a registration checkpoint: this exact
#| declaration, at this revision, mattered now. Evidence for HEAD goes
#| first, so the register has something to bind; then the checkpoint, which
#| the register chains to its predecessor. Every report is evidence for one
#| revision; only this is a registration. Returns the exit code.
sub record-checkpoint(IO::Path $path, Str $url, Str $token --> Int) {
    my ($dirty, $, $) = git($path, 'diff', '--quiet', 'HEAD', '--', $path.basename);
    if $dirty == 1 {
        note "{display-name($path)} has uncommitted changes. A checkpoint records the committed declaration, so commit it first, then: iz4 register";
        return 1;
    }
    my %report = collect-report($path);
    my $rev    = %report<revision>.substr(0, 12);
    my ($code, $reply) = submit-report($url, $token, json-encode(%report));
    unless 200 <= $code < 300 {
        note $code == 0
            ?? "register unreachable: $reply"
            !! "register answered $code to the report: {$reply.substr(0, 300)}";
        note 'No checkpoint recorded: the register needs evidence for this revision first.';
        return 1;
    }
    say "submitted {%report<report_id>} ({display-name($path)} at $rev)";

    ($code, $reply) = submit-checkpoint(registrations-url($url), $token, checkpoint-body(%report));
    my $seq  = json-field($reply, 'sequence');
    my $card = json-field($reply, 'card');
    if $code == 201 {
        my $pred = json-field($reply, 'predecessor');
        say "Registered declaration: checkpoint $seq (revision $rev"
            ~ ($pred.defined ?? ", follows checkpoint $pred)" !! ", the first)");
        say "card: $card" with $card;
        return 0;
    }
    if $code == 200 {
        say "Registered declaration: checkpoint $seq already records this declaration; nothing new to record.";
        say "card: $card" with $card;
        return 0;
    }
    if $code == 0 {
        note "register unreachable: $reply";
        note 'No checkpoint recorded. The report went through; run iz4 register again when the register is reachable.';
        return 1;
    }
    my $error = json-field($reply, 'error') // '';
    my $msg   = json-field($reply, 'message') // $reply.substr(0, 300);
    note "register answered $code: $msg";
    note do given $error {
        when 'not_registered'  { "No checkpoint recorded. Publish the project's card on iz4.you first (the IZ4 Trademark Licence is accepted there, never here), then: iz4 register" }
        when 'no_evidence'     { "No checkpoint recorded: the register holds no report for revision $rev. Run: iz4 report, then: iz4 register" }
        when 'no_declaration'  { "No checkpoint recorded: the register's report for this revision carries no declaration digest. Make sure {display-name($path)} is committed, then: iz4 report, then: iz4 register" }
        when 'digest_mismatch' { "No checkpoint recorded: the register's evidence for revision $rev carries a different digest from this file. Commit the file as it is, then: iz4 report, then: iz4 register" }
        when 'unauthorized'    { "No checkpoint recorded: the register rejected the token. Mint a new one on the project's Connect CI page, then: iz4 register --token=<token>" }
        default                { 'No checkpoint recorded.' }
    }
    1;
}

# Printed by every 'iz4 register': what registering includes, and that the
# acceptance happens on the site. Nothing here is a prompt, and no command
# is gated on it.
sub trademark-licence-note(--> Str) {
    qq:to/END/.chomp;
    Registering a project on iz4.you includes the IZ4 Trademark Licence
    ({TRADEMARK-LICENCE}): permission to use the IZ4 name and
    badge while the project keeps the foundation intact.
    You accept it on iz4.you when you publish the card, not here. Your
    rights under the Apache License 2.0 are unchanged, and nothing in iz4
    needs registration.
      {TRADEMARK-LICENCE-URL}
    END
}

# ------------------------------------------------------------------ gate

sub gate-root(Str $file --> IO::Path) {
    my $path = try resolve-target($file);
    without $path {
        # no IZ4 here: if this is a repository whose HEAD has one, the gate's answer is that it is gone
        my ($rc, $out, $) = git($*CWD.add(ROOT-NAME), 'rev-parse', '--show-toplevel');
        my $root = $rc == 0 ?? $out.trim.IO !! IO::Path;
        return $root if $root.defined && git($root.add(ROOT-NAME), 'cat-file', '-e', 'HEAD:' ~ ROOT-NAME)[0] == 0;
        $!.rethrow;
    }
    user-error("the gate works on a repository root IZ4; {display-name($path)} is not named {ROOT-NAME}") unless $path.basename eq ROOT-NAME;
    my ($rc, $out, $) = git($path, 'rev-parse', '--show-toplevel');
    user-error('not in a Git repository; the gate compares Git trees') if $rc != 0;
    my $root = $out.trim.IO;
    user-error("{display-name($path)} is not at the repository root ({$root})") unless $path.parent.resolve eq $root.resolve;
    $root;
}

#| A pass in one line.
sub brief-line(%r --> Str) {
    with %r<vibe> -> %m {
        my @said;
        @said.push: "{%m<changes>} change{%m<changes> == 1 ?? '' !! 's'} to what it promises" if %m<changes>;
        @said.push: "{%m<failing>} invariant test{%m<failing> == 1 ?? '' !! 's'} failing" if %m<failing>;
        return 'iz4: vibe mode, ' ~ (@said ?? @said.join(', ') ~ ". Nothing waits on you; 'iz4 mode solid' when they are ready to hold." !! 'nothing it promises changed.');
    }
    (%r<approval><status> // '') eq 'valid'
        ?? "iz4: the change to what this promises is agreed, by {%r<approval><approved_by>}."
        !! 'iz4: nothing this software promises has changed.';
}

sub gate-lines(%r --> List) {
    my @l;
    my $b = %r<base> eq 'none' ?? 'no base (initial)' !! "base {%r<base>.substr(0, 12)} ({%r<base_ref>})";
    @l.push: "gate: candidate tree {%r<candidate>.substr(0, 12)} ({%r<candidate_ref>}) against $b, {%r<mode>}";
    if %r<iz4><candidate_present> || %r<iz4><base_present> {
        my %p = changes => %r<changes>, protections => %r<protections>.grep({ .<kind> ne 'protection-changed' }).List;
        my @pl = proposal-lines(%p);
        @l.push: 'commitments and protections:' ~ (@pl ?? '' !! ' unchanged');
        @l.push: "  $_" for @pl;
        for |%r<protections>.grep({ .<kind> eq 'protection-changed' }) { @l.push: "  ({.<id>}: {.<detail>})" }
        if %r<checks> {
            @l.push: 'checks, run from the candidate tree:';
            for |%r<checks> -> %c {
                my $mark = %c<outcome> eq 'passed' ?? '✓' !! %c<outcome> eq 'failed' ?? '✗' !! '?';
                @l.push: "  $mark {%c<file>} ({%c<invariants>.join(', ')}) {%c<outcome>}" ~ (%c<detail> ?? ": {%c<detail>}" !! '');
            }
        }
        else { @l.push: 'checks: no test names an invariant, so nothing was run' }
        @l.push: "touches, by their own words (for a person to look at, not a finding): {%r<touches>.map(*.<id>).join(', ')}" if %r<touches>;
        given %r<approval><status> {
            when 'valid'   { @l.push: "approval: valid ({%r<approval><level>}) by {%r<approval><approved_by>} at {%r<approval><approved_at>}" ~ (%r<approval><reasons> ?? "; {%r<approval><reasons>.join('; ')}" !! '') }
            when 'invalid' { @l.push: "approval: invalid - {%r<approval><reasons>.join('; ')}" }
            when 'missing' { @l.push: 'approval: none for this candidate tree' }
        }
    }
    @l.push: "  note: $_" for |%r<notes>;
    with %r<vibe> { @l.push: "vibe mode: the invariants are still settling, so nothing here waits for a yes ({.<changes>} changed, {.<failing>} test{.<failing> == 1 ?? '' !! 's'} failing). 'iz4 mode solid' when they are ready to hold." }
    my %why =
        pass => 'no commitment or protection changed, and every check that could run passed',
        'agreement-required' => 'this changes what the software promises, so it waits for your yes',
        blocked => 'something here needs putting right first; a yes cannot stand in for it',
        unassessed => 'a check could not be run, so this is not a pass';
    @l.push: "outcome: {%r<outcome>} - {%why{%r<outcome>} // ''}";
    @l;
}

# ------------------------------------------------- the machine interface
# What an environment driver calls.  iz4 knows no harness: a driver (321,
# a native hook, a Git hook, CI) knows its environment and calls these.

multi MAIN('discover', Bool :$json = False, Str :$dir) {
    attempt {
        my %d = discover($dir.defined ?? $dir.IO !! $*CWD);
        if $json { say json-encode(%d) }
        elsif !%d<present> { say 'no IZ4 governs this directory' }
        else {
            say "IZ4: {%d<file>}";
            say "sha256: {%d<sha256>}";
            say %d<valid> ?? 'valid' !! "invalid: {%d<errors>.join('; ')}";
            say "invariants ({%d<format>}): {%d<invariants>.map(*<id>).join(', ')}";
        }
        0;
    }
}

#| The questions that help a person write an invariant, as data, so a page
#| that is not a terminal can ask them.
multi MAIN('draft', 'questions') {
    attempt { say json-encode(draft-questions()); 0 }
}

#| Questions about a draft, as data.  With a name and a file, also whether
#| the name can be used there, and the digest the invariant would have.
multi MAIN('draft', 'check', Str :$where = '', Str :$always, Str :$holds, Str :$protects = '', Str :$name, Str :$file) {
    attempt {
        my $rule = $always // $holds // '';
        my %r = draft-check(:reach($where), :$rule, :because($protects));
        with $name {
            my $path = resolve-target($file);
            my $doc = check-doc($path);
            my $id = $doc.form eq 'clauses' ?? clauses-identity($name, $doc.domain // 'example.com') !! full-identity($name, project-namespace($path));
            %r<identity> = $id;
            try {
                check-new-name($path, $doc, $id);
                CATCH { when X::IZ4 { %r<findings>.push: %( clause => 'NAME', code => 'name', level => 'ask', message => .message ); %r<ok> = False } }
            }
            %r<digest> = invariant-digest($id, $rule.trim, $protects.trim, |($doc.form eq 'clauses' ?? (:reach($where.trim)) !! ()))
                if $rule.trim ne '' && ($doc.form ne 'clauses' || $where.trim ne '');
        }
        say json-encode(%r);
        0;
    }
}

multi MAIN('context', Bool :$json = False, Str :$file) {
    attempt {
        my %c = context(resolve-target($file));
        print $json ?? json-encode(%c) ~ "\n" !! %c<text>;
        0;
    }
}

sub say-check(%r, Bool $json --> Int) {
    if $json { say json-encode(%r) } else { .say for check-lines(%r) }
    %r<exit_code>;
}

multi MAIN('check', 'action', Bool :$json = False, Str :$action, Str :$dir) {
    attempt {
        my $text = $action // $*IN.slurp;
        my $parsed = try Rakudo::Internals::JSON.from-json($text);
        user-error('check action reads one JSON object describing the action: operation, target, and optionally parameters, resource, repository, recipient, context')
            unless $parsed ~~ Associative;
        say-check(check-action(%$parsed, :dir($dir.defined ?? $dir.IO !! $*CWD)), $json);
    }
}

sub change-options(Bool :$staged, Bool :$worktree, Str :$base, Str :$candidate, Bool :$checks, Int :$timeout, Str :$check-cmd,
                   Str :$approval, Str :$approvers --> Hash) {
    user-error('choose one of --worktree, --staged or --candidate=REV') if ($worktree, $staged, $candidate.defined).grep(?*).elems > 1;
    %( staged => $staged, worktree => $worktree, base => $base, candidate => $candidate, checks => $checks, timeout => $timeout,
       check-cmd => $check-cmd, approval-file => ($approval.defined ?? $approval.IO !! IO::Path),
       approvers => ($approvers.defined ?? $approvers.IO !! IO::Path) );
}

multi MAIN('check', 'change', Bool :$staged = False, Bool :$worktree = False, Str :$base, Str :$candidate, Bool :$json = False,
           Bool :$checks = True, Int :$timeout = 300, Str :$check-cmd = %*ENV<IZ4_CHECK_CMD> // Str,
           Str :$approval, Str :$approvers = %*ENV<IZ4_APPROVERS> // Str, Str :$file) {
    attempt {
        my %o = change-options(:$staged, :$worktree, :$base, :$candidate, :$checks, :$timeout, :$check-cmd, :$approval, :$approvers);
        say-check(check-change(gate-root($file), |%o), $json);
    }
}

multi MAIN('verify', Bool :$staged = False, Bool :$worktree = False, Str :$base, Str :$candidate, Str :$summary,
           Bool :$json = False, Bool :$checks = True, Int :$timeout = 300, Str :$check-cmd = %*ENV<IZ4_CHECK_CMD> // Str,
           Str :$approval, Str :$approvers = %*ENV<IZ4_APPROVERS> // Str, Str :$file) {
    attempt {
        my %o = change-options(:$staged, :$worktree, :$base, :$candidate, :$checks, :$timeout, :$check-cmd, :$approval, :$approvers);
        say-check(verify(gate-root($file), :$summary, |%o), $json);
    }
}

multi MAIN('gate', Bool :$install-hook!, Bool :$enforce = False, Bool :$force = False, Str :$file) {
    attempt {
        my $path = resolve-target($file);
        my $state = install-hook($path, :$force, :hook<pre-commit>, :text(gate-hook-text(:$enforce)),
                                 :mark(GATE-HOOK-MARK), :manual('iz4 gate --staged'));
        say "pre-commit hook: $state (" ~ ($enforce
            ?? 'it asks you at the terminal when a commit changes what the software promises, and holds a commit made by a script or an agent until you have answered'
            !! 'advisory: it tells you what a commit changes and never holds one; --enforce makes it wait for your answer') ~ ')';
        0;
    }
}

multi MAIN('gate', Str :$base, Str :$candidate, Bool :$staged = False, Bool :$enforce = False, Bool :$json = False,
           Bool :$checks = True, Int :$timeout = 300, Str :$check-cmd = %*ENV<IZ4_CHECK_CMD> // Str,
           Str :$approval, Str :$approvers = %*ENV<IZ4_APPROVERS> // Str, Str :$file, Bool :$brief = False) {
    attempt { gate-command(:$base, :$candidate, :$enforce, :$json, :$checks, :$timeout, :$check-cmd, :$approval, :$approvers, :$file, :$brief) }
}

sub gate-command(Str :$base, Str :$candidate, Bool :$enforce, Bool :$json, Bool :$checks, Int :$timeout, Str :$check-cmd,
                 Str :$approval, Str :$approvers, Str :$file, Bool :$brief = False --> Int) {
    {
        my $root = gate-root($file);
        # the command that runs one linked test: the flag, then IZ4_CHECK_CMD,
        # then this repository's own 'git config iz4.checkCmd' (in .git/config,
        # outside every tree, so a candidate cannot set it), then the default
        # for the repository's test language
        my $cmd = $check-cmd // do {
            my ($rc, $out, $) = git($root.add(ROOT-NAME), 'config', '--get', 'iz4.checkCmd');
            $rc == 0 && $out.trim ne '' ?? $out.trim !! Str;
        };
        my %r;
        my $failure = Nil;
        try {
            %r = run-gate($root, :staged(!$candidate.defined), :$base, :$candidate, :$enforce, :$checks, :$timeout,
                          :check-cmd($cmd), :approval-file($approval.defined ?? $approval.IO !! IO::Path),
                          :approvers($approvers.defined ?? $approvers.IO !! IO::Path));
            CATCH { default { $failure = $_ } }
        }
        with $failure {
            %r = schema => GATE-SCHEMA, outcome => 'error', mode => ($enforce ?? 'enforce' !! 'advisory'),
                 detail => .message, exit_code => 1, next => ('fix the cause above, then run iz4 gate again',).List;
            if $json { say json-encode(%r) } else { note "gate: error - {.message}"; note 'outcome: error - the check could not complete, so this is not a pass' }
            return 1;
        }
        if $json { say json-encode(%r) }
        elsif $brief && %r<outcome> eq 'pass' {
            # nothing for a person to do: one line, so a commit or a deploy is not a wall of text
            say brief-line(%r);
        }
        else {
            say pretty($_) for gate-lines(%r);
            my $again = 'iz4 gate' ~ ($candidate.defined ?? " --candidate=$candidate" !! ' --staged') ~ ($enforce ?? ' --enforce' !! '');
            say-next(%r<next>, :then($again)) if %r<next>;
            say $enforce ?? "exit {%r<exit_code>}" !! 'advisory: this run refuses nothing; --enforce makes the outcome the exit code';
        }
        %r<exit_code>;
    }
}

multi MAIN('approve', Str :$base, Str :$candidate, Bool :$staged = False, Str :$sign, Str :$by, Str :$out, Str :$note = '', Str :$file) {
    attempt :intent, { approve-command(:$base, :$candidate, :$sign, :$by, :$out, :$note, :$file) }
}

sub approve-command(Str :$base, Str :$candidate, Str :$sign, Str :$by, Str :$out, Str :$note = '', Str :$file, Bool :$resolved = False --> Int) {
    {
        my $root = gate-root($file);
        user-error("--sign needs --by=YOU, the name the gate knows your key by. Once is enough: it is remembered.") if $sign.defined && !$by.defined;
        # the checks run here too: a person is only ever shown a proposal for a tree that is not blocked
        # the same command the gate runs a linked test with, so both see the same result
        my $cmd = %*ENV<IZ4_CHECK_CMD> // do {
            my ($rc, $o, $) = git($root.add(ROOT-NAME), 'config', '--get', 'iz4.checkCmd');
            $rc == 0 && $o.trim ne '' ?? $o.trim !! Str;
        };
        my %r = run-gate($root, :staged(!$candidate.defined), :$base, :$candidate, :check-cmd($cmd));
        my %p = changes => %r<changes>, protections => %r<protections>;
        if %r<outcome> eq 'blocked' {
            # An invariant whose test fails is not a wall: it is a question for the
            # person, and they can answer it here.  Anything else blocked is shown.
            my @failed  = %r<checks>.grep({ .<outcome> eq 'failed' });
            my $only-tests = !%r<changes>.grep({ .<kind> eq any(<invalid foundation reused-name format-regressed>) });
            if @failed && $only-tests && interactive() && !$candidate.defined && !$resolved {
                return %EXIT-CODE<blocked> unless settle-failed($root, @failed);
                return approve-command(:$base, :$candidate, :$sign, :$by, :$out, :$note, :$file, :resolved);
            }
            say pretty($_) for proposal-lines(%p);
            say "  ✗ {.<file>} ({.<invariants>.join(', ')}) failed" ~ (.<detail> ?? ": {.<detail>}" !! '') for @failed;
            say @failed && $only-tests
                ?? "Nothing to agree to yet: an invariant no longer holds. At a terminal, 'iz4 approve' asks which is right, the software or the invariant."
                !! 'Nothing to approve: a blocked finding is not a proposal. Fix it first.';
            return %EXIT-CODE<blocked>;
        }
        unless needs-agreement(%p) {
            say "Nothing needs agreement for candidate tree {%r<candidate>.substr(0, 12)}: no commitment or protection changed.";
            return 0;
        }
        # one thing at a time: each change is its own small question
        my @items = |%r<changes>.map({ %( changes => ($_,), protections => () ) }),
                    |%r<protections>.map({ %( changes => (), protections => ($_,) ) });
        unless interactive() {
            say "This change alters what the software promises:";
            say pretty("  $_") for proposal-lines(%p);
            say '';
            say 'pending: agreement needs a person. At a terminal, they run:   iz4 approve';
            say 'Nothing was recorded.';
            return %EXIT-CODE<agreement-required>;
        }
        # who signs, found for them: said outright, last time's, or the key of theirs the gate here already trusts
        my %signer = $sign.defined ?? %( key => home-path($sign), by => $by, found => 'as you said' ) !! find-signer($root);
        user-error("there is no key at {%signer<key>}") if %signer && !%signer<key>.f;

        say @items == 1
            ?? 'This change alters what the software promises. Is it what you mean?'
            !! "This change alters what the software promises in {+@items} ways. One at a time:";
        for @items.kv -> $i, %item {
            say '';
            say "{$i + 1} of {+@items}" if @items > 1;
            say pretty("  $_") for proposal-lines(%item);
            my $yes = Bool;
            for ^3 {
                my $said = ask('Is that right? [y/n] ');
                last without $said;                         # end of input: no answer
                my $a = $said.trim.lc;
                $yes = True  if $a.starts-with('y') || $a.starts-with('a');
                $yes = False if $a.starts-with('n') || $a.starts-with('r') || $a.starts-with('v');
                last if $yes.defined;
                say 'Type y if that is what you mean, n if it is not.';
            }
            unless $yes {
                say '';
                say $yes.defined
                    ?? 'Then nothing is agreed and nothing was recorded. Put the IZ4 or its tests the way you mean them, and commit again.'
                    !! 'No answer, so nothing was recorded.';
                return %EXIT-CODE<agreement-required>;
            }
        }
        my $who = %signer<by> // $by // do {
            my ($rc, $o, $) = git($root.add(ROOT-NAME), 'config', 'user.email');
            $rc == 0 && $o.trim ne '' ?? $o.trim !! (%*ENV<USER> // 'someone at this terminal');
        };
        my %snap = repository => %r<repository>, base => (%r<base> eq 'none' ?? Str !! %r<base>), candidate => %r<candidate>;
        my %a = approval-body(%snap, %r<proposal_digest>, :by($who), :method(%signer ?? 'ssh-signature' !! 'terminal'), :$note);
        %a<signature> = sign-approval(%a, %signer<key>) if %signer;
        my $ref = store-approval($root, %a);
        if $out.defined { $out.IO.spurt(json-encode(%a) ~ "\n"); say "approval written to $out" }
        say '';
        say "Recorded: {%a<method>} approval by $who for tree {%r<candidate>.substr(0, 12)} at $ref";
        say "Signed as $who with {%signer<key>} ({%signer<found>})." if %signer;
        say "It covers exactly this change: alter the tree, the base or the proposal and it is asked again.";
        $*IZ4-INTENT-CHANGED = True;      # a person agreed to a change of intent: enforcement is made sure of
        unless %signer {
            say 'A terminal approval counts for local checks only. For a signed one, say once which key is yours:';
            say '  iz4 approve --sign=KEY --by=YOU      (remembered after that)';
            return 0;
        }
        remember-signer($root, %signer<key>, $who) if %signer<found> eq 'as you said';
        send-approval($root, $ref);
        0;
    }
}

#| An invariant's test fails: the software and the IZ4 disagree, and only
#| the person knows which is right.  One invariant at a time, one question
#| at a time.  True when the IZ4 was brought into line and staged, so the
#| change can be put to them; False when they will fix the software, or
#| gave no answer.  Nothing is decided for them.
sub settle-failed(IO::Path $root, @failed --> Bool) {
    my $path = $root.add(ROOT-NAME);
    my $changed = False;
    for @failed -> %c {
        my $doc = check-doc($path);
        my @own = %c<invariants>.grep({ $doc.invariant($_).defined });
        unless @own {
            say "{%c<file>} fails, and it stands for the foundation ({%c<invariants>.join(', ')}): that part is the software's to put right.";
            return False;
        }
        for @own -> $id {
            my $inv = $doc.invariant($id);
            say '';
            say "The software and the IZ4 disagree about $id.";
            say "  It says: {$inv.text}";
            say "  Its test, {%c<file>}, fails" ~ (%c<detail> ?? ": {%c<detail>}" !! '.');
            say '';
            say 'Which is right?';
            say '  s  the invariant: the software should keep it, and I will fix the software';
            say '  i  the software: bring the invariant up to date';
            say '  w  neither needs it any more: withdraw the invariant';
            my $a = '';
            for ^3 {
                my $said = ask('[s/i/w] ');
                last without $said;
                $a = $said.trim.lc.substr(0, 1);
                last if $a eq any(<s i w>);
                say 'Type s, i or w.';
            }
            given $a {
                when 'i' {
                    my $draft = agent-reachable()
                        ?? (try { say "Asking {agent-label()} what is true of the software now ..."; agent-reword($root, :$id, text => $inv.text, because => ($inv.because // ''), failure => (%c<detail> // '')) })
                        !! Str;
                    say '';
                    if $draft.defined { say 'It could say:'; say "  $draft" }
                    my $said = ask($draft.defined ?? "Enter keeps that; or type the words you mean.\n> " !! "What should it say now?\n> ");
                    return False without $said;
                    my $words = $said.trim eq '' ?? ($draft // '') !! $said.trim;
                    if $words eq '' { say 'No words, so nothing changed.'; return False }
                    revise-invariant($path, $id, $words);
                    git($path, 'add', '--', ROOT-NAME);
                    say "$id now says: $words";
                    # its test checked the old words
                    my $only-this = !$doc.invariants.grep({ .id.defined && .id ne $id && names-identity(($root.add(%c<file>).slurp), .id) });
                    if $only-this && yes-no(ask("{%c<file>} checks the old words. Take it out, so a new one can be written ('iz4 test')? [Y/n] "), :default) {
                        git($path, 'rm', '-q', '-f', '--', %c<file>);
                        say "Removed {%c<file>}.";
                    }
                    $changed = True;
                }
                when 'w' {
                    my %t = withdrawal-tests($path, $doc, $id);
                    withdraw-invariant($path, $id);
                    git($path, 'add', '--', ROOT-NAME);
                    for remove-tests($root, %t<remove>) { git($path, 'add', '-A', '--', $_); say "Removed $_." }
                    say "$id is withdrawn; its name is retired, and Git keeps its words.";
                    $changed = True;
                }
                when 's' {
                    say "Then the invariant stays as it is. Fix the software and commit again; {%c<file>} will tell you when it holds.";
                    return False;
                }
                default { say 'No answer, so nothing changed.'; return False }
            }
        }
    }
    $changed;
}

#| A signed approval is no use to the gate on the far side until it is
#| there.  Offer to send it, so a person has no second command to find.
sub send-approval(IO::Path $root, Str $ref) {
    my $anchor = $root.add(ROOT-NAME);
    my ($rc, $remotes, $) = git($anchor, 'remote');
    my @remotes = $rc == 0 ?? $remotes.lines.grep(*.trim ne '') !! ();
    return unless @remotes;                       # nowhere to send it: the local gate has it already
    my $remote = @remotes.first('origin') // @remotes[0];
    my $said = ask("Send it to $remote too, so the gate there accepts it? [Y/n] ");
    if !$said.defined || $said.trim.lc.starts-with('n') {
        say "Not sent. When you want it there: git push $remote $ref";
        return;
    }
    my ($prc, $, $perr) = git($anchor, 'push', $remote, $ref);
    say $prc == 0
        ?? "Sent to $remote. Nothing more for you to do: the commit can go ahead."
        !! "Could not send it ({$perr.trim.lines.tail // 'git push failed'}). When you can: git push $remote $ref";
}

multi MAIN('badge', Str :$file) {
    attempt {
        my %b = badge-info(resolve-target($file));
        say "card:  {%b<card>}";
        say "badge: {%b<badge>}";
        say '';
        say 'Markdown (paste into README.md):';
        say %b<markdown>;
        say '';
        say 'HTML:';
        say %b<html>;
        say '';
        say 'The badge is served live by the register and renders the card\'s';
        say 'current evidence; embedding it claims nothing the card cannot back.';
        0;
    }
}

multi MAIN('report', Str :$file, Str :$release, Str :$run-id,
           Bool :$dry-run = False, Bool :$strict = False) {
    attempt {
        my $path   = resolve-target($file);
        my %report = collect-report($path, :$release, :$run-id);
        my $body   = json-encode(%report);
        if $dry-run { say $body; return 0 }

        my $url = register-url($path)
            // user-error("not connected to a register; run 'iz4 register' for the steps");
        my $token = token-for($url)
            // user-error("no reporting token; run 'iz4 register' for the steps");

        my ($code, $reply) = submit-report($url, $token, $body);
        if 200 <= $code < 300 {
            say "submitted {%report<report_id>} ({display-name($path)} at {%report<revision>.substr(0, 12)})";
            return 0;
        }
        note $code == 0
            ?? "register unreachable: $reply"
            !! "register answered $code: {$reply.substr(0, 300)}";
        $strict ?? 1 !! 0;   # advisory by design: never blocks a pipeline
    }
}

sub user-error(Str $message) { X::IZ4.new(:$message).throw }
