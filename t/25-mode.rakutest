use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;

# vibe mode: the invariants are still settling.  Nothing of the project's
# own waits for a yes or holds a commit, and iz4 says one line.  Solid:
# each change waits.  The foundation holds in both, and moving between
# the two is itself something a person agrees to.

unless have-git() { skip-rest 'no git available'; exit }

my $config = temp-dir.add('gitconfig');
$config.spurt('');
%*ENV<GIT_CONFIG_GLOBAL> = $config.Str;
%*ENV<IZ4_INTERACTIVE> = '0';
%*ENV<IZ4_NO_321> = '1';
%*ENV<IZ4_CHECK_CMD> = 'sh {file}';
%*ENV<IZ4_AGENT_CMD> = '';

sub g(IO::Path $r, *@a) { my $p = run 'git', '-C', $r.Str, |@a, :out, :err; my $o = $p.out.slurp(:close); $p.err.slurp(:close); $o.trim }
sub add(IO::Path $r, Str $name, Str $text) {
    my ($rc, $out, $err) = iz4($r, 'add', 'invariant', $text, "--name=$name", '--where=the shop takes an order', '--namespace=shop.example.com', '--protects="a customer\'s money"', '--force');
    die "add: $out $err" if $rc != 0;
}

my $r = temp-dir;
g($r, 'init', '-q');
g($r, 'config', 'user.email', 't@test');
g($r, 'config', 'user.name', 'Test');
my ($rc, $out, $err) = iz4($r, 'init', '--namespace=shop.example.com', '--for-what=Taking orders.', '--for-who=People buying things.', '--/agents');
like $out, / 'iz4 mode vibe' \h+ 'move fast while the invariants settle' /, 'init says the mode is there, in a line';
my $iz4 = $r.add('IZ4');
my $fresh = $iz4.slurp;

# ---- a new project, still settling ------------------------------------------
($rc, $out, $err) = iz4($r, 'mode');
like $out, / 'IZ4 is solid' \n\n '  Its invariants hold: a change to one waits for your yes, and a failing' /, 'a file is solid until it says otherwise';
($rc, $out, $err) = iz4($r, 'mode', 'vibe');
is $rc, 0, 'iz4 mode vibe';
like $out, / 'IZ4 is in vibe mode' \n\n '  Changes to its invariants do not wait for a yes' .* 'The foundation holds as ever.' .* 'iz4 mode solid' /, 'says what it means in a calm block';
is $iz4.slurp.lines.grep(* eq VIBE-COMMENT).elems, 1, 'the mode is one line in the file, where everyone can see it';
is $iz4.slurp.subst("\n" ~ VIBE-COMMENT ~ "\n", ''), $fresh, 'and nothing else in the file changed';
ok check-doc($iz4).ok && check-doc($iz4).vibe, 'the file checks, and knows its mode';
like iz4($r, 'mode', 'vibe')[1], / 'already in vibe mode' /, 'asking twice changes nothing';
is iz4($r, 'mode', 'draft')[0], 1, 'only vibe and solid are modes';

add($r, 'charged-once', 'An order is never charged twice.');
$r.add('t').mkdir;
$r.add('t/charged-once.t').spurt("#!/bin/sh\n# charged-once.shop.example.com\nexit 0\n");
g($r, 'add', '-A');
($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', '--brief');
is $rc, 0, 'a first commit in vibe mode waits for nobody';
is $out.lines.elems, 1, 'and the gate says one line';
like $out, / ^ 'iz4: vibe mode, ' \d+ ' changes to what it promises. Nothing waits on you;' /, 'which says what it noticed and that nothing waits';
g($r, 'commit', '-qm', 'start');

# vibe coding: invariants change, a test breaks, nothing holds
add($r, 'stock-true', 'Stock shown is stock held.');
$r.add('t/charged-once.t').spurt("#!/bin/sh\n# charged-once.shop.example.com\nexit 1\n");
g($r, 'add', '-A');
($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', '--brief');
is $rc, 0, 'a new invariant and a failing test hold nothing in vibe mode';
like $out, / ^ 'iz4: vibe mode, 2 changes to what it promises, 1 invariant test failing. Nothing waits on you' /, 'but both are said, in the one line (the new invariant, and the protecting test rewritten)';
($rc, $out, $err) = iz4($r, 'gate', '--staged', '--json');
like $out, / '"outcome":"pass"' /, 'tools see a pass';
like $out, / '"intent_mode":"vibe"' /, 'and are told the mode, so a pass is not mistaken for agreement';
like $out, / '"failing":1' /, 'with what was noticed';
($rc, $out, $err) = iz4($r, 'check');
like $out, / 'vibe mode: 2 settling, 2 with a reason, 1 with a test. Nothing waits on you' /, 'check says where things stand in a line';
unlike $out, / 'no test naming' | 'NOT YET' /, 'and asks for nothing';
g($r, 'commit', '-qm', 'moving');

# the foundation is not the project's to settle
my $kept = $iz4.slurp;
$iz4.spurt($kept.subst('Help people thrive, on their own terms.', 'Help people thrive.'));
g($r, 'add', '-A');
($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', '--brief');
is $rc, 3, 'altering the foundation holds a commit in vibe mode too';
like $out, / 'To put right:' .* 'iz4 foundation restore' /, 'and the full account is given, with the step that puts it right';
$iz4.spurt($kept); g($r, 'add', '-A');

# ---- becoming solid ---------------------------------------------------------
($rc, $out, $err) = iz4($r, 'mode', 'solid');
is $rc, 0, 'iz4 mode solid';
like $out, / 'IZ4 is solid' \n\n '  From now on a change to one of its invariants waits for your yes.' /, 'says what changes';
like $out, / '1 of 2' \s+ 'have a test.' .* 'iz4 test' \h+ 'writes the rest, so each one means something' /, 'and which invariants have nothing behind them yet, with the next step';
like $out, / 'Changing mode is itself something you agree to' /, 'and that the change of mode is agreed to';
nok $iz4.slurp.contains('Vibe:'), 'the line is gone';
is $iz4.slurp, $kept.subst("\n" ~ VIBE-COMMENT ~ "\n", ''), 'and nothing else changed';
$r.add('t/charged-once.t').spurt("#!/bin/sh\n# charged-once.shop.example.com\nexit 0\n");
g($r, 'add', '-A');
($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', '--brief');
is $rc, 2, 'becoming solid waits for a yes';
like $out, / 'The IZ4 becomes solid' \n \s+ 'its 2 invariants become solid: from now on a change to any of them waits for a yes' /, 'and says what is being agreed to';
($rc, $out, $err) = iz4-talk($r, "y\n" x 4, 'approve');
is $rc, 0, 'a yes to each thing it changes, one at a time' or diag $out;
g($r, 'commit', '-qm', 'solid');

# solid: a change waits again
add($r, 'refunds-whole', 'A refund returns the whole amount.');
g($r, 'add', '-A');
is iz4($r, 'gate', '--staged', '--enforce', '--brief')[0], 2, 'once solid, a new invariant waits for a yes';
g($r, 'reset', '-q', '--hard');
($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', '--brief');
is $out, "iz4: nothing this software promises has changed.\n", 'and a commit that changes none of it gets one quiet line';

# going back to settling is agreed to as well: it cannot be slipped in
iz4($r, 'mode', 'vibe');
add($r, 'slipped-in', 'Something added on the quiet.');
g($r, 'add', '-A');
($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', '--brief');
is $rc, 2, 'leaving solid for vibe mode waits for a yes, with whatever came along with it';
like $out, / 'The IZ4 goes into vibe mode' .* 'will not wait for a yes until it is solid again' /, 'and says what that gives up';
like $out, / 'slipped-in.shop.example.com added' /, 'the change made alongside it is shown too';


# ---- firm: the words are agreed, the evidence is still being built ----------
{
    my $r2 = temp-dir;
    g($r2, 'init', '-q'); g($r2, 'config', 'user.email', 't@test'); g($r2, 'config', 'user.name', 'Test');
    iz4($r2, 'init', '--namespace=shop.example.com', '--for-what=Taking orders.', '--for-who=People buying things.', '--/agents');
    iz4($r2, 'mode', 'vibe');
    add($r2, 'charged-once', 'An order is never charged twice.');
    $r2.add('t').mkdir; $r2.add('lib').mkdir; $r2.add('lib/ok').spurt("charged once\n");
    $r2.add('t/charged-once.t').spurt("#!/bin/sh\n# charged-once.shop.example.com\ntest -f lib/ok\n");
    g($r2, 'add', '-A'); g($r2, 'commit', '-qm', 'start');
    my ($rc, $out, $err) = iz4($r2, 'mode', 'firm');
    is $rc, 0, 'iz4 mode firm';
    like $out, / 'IZ4 is firm' \n\n '  From now on a change to one of its invariants waits for your yes. A' .* 'failing test is reported and holds nothing yet' /, 'says what firm means';
    like $r2.add('IZ4').slurp, / ^^ '# Firm:' /, 'one line in the file';
    ok check-doc($r2.add('IZ4')).mode eq 'firm', 'and the file knows its mode';
    g($r2, 'add', 'IZ4');
    is iz4($r2, 'gate', '--staged', '--enforce')[0], 2, 'going firm is agreed to, like any mode change';
    g($r2, 'commit', '-qm', 'firm');   # the test harness has no hook; the gate above is the check
    # a change to the code that makes a protecting test fail holds nothing; the test itself is untouched
    $r2.add('lib/ok').unlink;
    g($r2, 'add', '-A');
    ($rc, $out, $err) = iz4($r2, 'gate', '--staged', '--enforce');
    is $rc, 0, 'in firm mode a failing protecting test holds nothing';
    like $out, / 'reported, not held, while the invariant is firm' /, 'and says so';
    like $out, / 'outcome: pass' /, 'the outcome is pass';
    g($r2, 'commit', '-qm', 'red test');
    add($r2, 'stock-true', 'Stock shown is stock held.');
    g($r2, 'add', '-A');
    ($rc, $out, $err) = iz4($r2, 'gate', '--staged', '--enforce');
    is $rc, 2, 'but a new invariant waits for a yes';
    like $out, / 'stock-true.shop.example.com added' /, 'and is named';
}

# ---- one invariant protected more than the file ------------------------------
{
    my $r3 = temp-dir;
    g($r3, 'init', '-q'); g($r3, 'config', 'user.email', 't@test'); g($r3, 'config', 'user.name', 'Test');
    iz4($r3, 'init', '--namespace=shop.example.com', '--for-what=Paying suppliers.', '--for-who=Small businesses.', '--/agents');
    iz4($r3, 'mode', 'vibe');
    add($r3, 'charged-once', 'An order is never charged twice.');
    add($r3, 'pretty-invoices', 'Invoices look good.');
    g($r3, 'add', '-A'); g($r3, 'commit', '-qm', 'start');
    my ($rc, $out, $err) = iz4($r3, 'mode', 'solid', 'charged-once');
    is $rc, 0, 'iz4 mode solid NAME';
    like $out, / 'charged-once.shop.example.com is solid' \n\n '  The file stays in vibe mode; this one invariant is protected as solid' /, 'protects one invariant more than the file';
    like $r3.add('IZ4').slurp, / ^^ 'charged-once: solid' $$ /, 'one word after its name, nothing else touched';
    my $doc = check-doc($r3.add('IZ4'));
    ok $doc.ok, 'the file is valid';
    is $doc.protection-of('charged-once.shop.example.com'), 'solid', 'the invariant is solid';
    is $doc.protection-of('pretty-invoices.shop.example.com'), 'vibe', 'its neighbour still settles with the file';
    like iz4($r3, 'mode')[1], / 'Protected more than the file:' \s+ 'charged-once.shop.example.com: solid' /, 'iz4 mode shows it';
    g($r3, 'add', '-A');
    is iz4($r3, 'gate', '--staged', '--enforce')[0], 0, 'protecting more, in a settling file, waits for nobody';
    g($r3, 'commit', '-qm', 'protect');
    # the protected one waits; the settling one does not
    my $iz4 = $r3.add('IZ4');
    $iz4.spurt($iz4.slurp.subst('Invoices look good.', 'Invoices look great.'));
    g($r3, 'add', '-A');
    is iz4($r3, 'gate', '--staged', '--enforce')[0], 0, 'rewording the settling invariant waits for nobody';
    g($r3, 'commit', '-qm', 'reword');
    $iz4.spurt($iz4.slurp.subst('An order is never charged twice.', 'An order is rarely charged twice.'));
    g($r3, 'add', '-A');
    ($rc, $out, $err) = iz4($r3, 'gate', '--staged', '--enforce');
    is $rc, 2, 'rewording the solid one waits for a yes';
    g($r3, 'checkout', '-q', '--', 'IZ4');
    # an agent cannot lower the protection and use the lower one in the same step
    $iz4.spurt($iz4.slurp.subst('charged-once: solid', 'charged-once:').subst('An order is never charged twice.', 'An order is rarely charged twice.'));
    g($r3, 'add', '-A');
    ($rc, $out, $err) = iz4($r3, 'gate', '--staged', '--enforce');
    is $rc, 2, 'lowering the protection and changing the words together waits for a yes at the level it had';
    like $out, / 'charged-once.shop.example.com: its protection changes' .* 'lowered: this waits for a yes at the level it had' /, 'and the lowering is named as such';
    g($r3, 'checkout', '-q', '--', 'IZ4');
    # nor delete, rename or replace it
    $iz4.spurt($iz4.slurp.subst(/ 'charged-once: solid' .*? 'PROTECTS:' \N* \n /, ''));
    g($r3, 'add', '-A');
    is iz4($r3, 'gate', '--staged', '--enforce')[0], 2, 'deleting the solid invariant waits for a yes, in a vibe file';
    g($r3, 'checkout', '-q', '--', 'IZ4');
    $iz4.spurt($iz4.slurp.subst('charged-once: solid', 'charged-twice: solid'));
    g($r3, 'add', '-A');
    is iz4($r3, 'gate', '--staged', '--enforce')[0], 2, 'renaming it waits for a yes';
    g($r3, 'checkout', '-q', '--', 'IZ4');
    # a failing test of the solid one holds, in a vibe file
    $r3.add('t').mkdir;
    $r3.add('t/charged-once.t').spurt("#!/bin/sh\n# charged-once.shop.example.com\nexit 1\n");
    g($r3, 'add', '-A');
    is iz4($r3, 'gate', '--staged', '--enforce')[0], 3, 'a failing test of the solid invariant holds the commit although the file is in vibe mode';
    # the mode word is spelled by the person, not the tool: lowering through the command is a change too
    g($r3, 'checkout', '-q', '--', 'IZ4'); $r3.add('t/charged-once.t').unlink;
    ($rc, $out, $err) = iz4($r3, 'mode', 'vibe', 'charged-once');
    is $rc, 0, 'iz4 mode vibe NAME takes the word away';
    unlike $r3.add('IZ4').slurp, / 'charged-once: solid' /, 'and the heading is plain again';
    g($r3, 'add', '-A');
    is iz4($r3, 'gate', '--staged', '--enforce')[0], 2, 'which waits for a yes, because it had solid';
}

done-testing;
