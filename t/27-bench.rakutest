use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;

# The adversarial benchmark is also a regression suite for the gate: every
# scenario's recorded expectation must still hold, and the totals must not
# slip.  It runs the real iz4 (IZ4_TEST_BIN or bin/iz4) against throwaway
# repositories, in an isolated home.

my $bench = $?FILE.IO.parent.parent.add('bench');
my $out   = temp-dir;
# the benchmark wants one executable: the compiled iz4 under test, or a wrapper that runs bin/iz4 from source
my $bin = %*ENV<IZ4_TEST_BIN> // do {
    my $w = $out.add('iz4');
    $w.spurt("#!/bin/sh\nexec '{$*EXECUTABLE}' -I '{$bench.parent.add('lib')}' '{$bench.parent.add('bin').add('iz4')}' \"\$@\"\n");
    $w.chmod(0o755);
    $w.Str;
};
my %env   = %*ENV, IZ4_TEST_BIN => $bin, BENCH_RAKU => $*EXECUTABLE.Str;
my $p = run $*EXECUTABLE, $bench.add('run.raku').Str, '--check', '--quiet', "--out={$out}", :env(%env), :out, :err;
my $stdout = $p.out.slurp(:close);
my $stderr = $p.err.slurp(:close);
is $p.exitcode, 0, 'every recorded expectation is met' or diag $stderr ~ $stdout;
like $stdout, /'every expectation met'/, 'and the runner says so';

my $json = $out.add('latest.json');
ok $json.e, 'results written as data';
my %r = Rakudo::Internals::JSON.from-json($json.slurp);
is %r<schema>, 'iz4-bench/2', 'with a schema';
my %e = %r<totals><enforced>;
ok %e<attempted> >= 30, "at least 30 violations attempted ({%e<attempted>})";
ok %e<prevented> >= 28, "at least 28 prevented at the enforced boundary ({%e<prevented>})";
is %e<missed>, 2, 'exactly the two honest misses: D1 (a new route no test covers) and J3 (a protecting test weaker than the holdout)';
ok %e<false_positives> <= 1, "at most one false positive ({%e<false_positives>}: strengthening a protecting test asks a yes)";
ok %e<unnecessary_approvals> <= 2, "at most two unnecessary approvals ({%e<unnecessary_approvals>})";
is %r<totals><none><prevented>, 0, 'without an IZ4 nothing is prevented';
is %r<totals><context><prevented>, 0, 'with the IZ4 as context only, nothing is prevented';
ok %r<totals><context><detected> >= 27, 'but the advisory gate sees most of it';

# vibe mode: the project's own invariants wait for nobody, the foundation and the outright blocks hold
my %v = %r<totals><vibe>;
ok %v<prevented> >= 10, "exploring still prevents the foundation edits, the removed IZ4, the look-alike name, the hidden character, the IZ4 actions, and every change to an established promise ({%v<prevented>})";
ok %v<prevented> < %e<prevented>, 'and prevents less than protected development: that is the trade';
ok %v<missed> > %e<missed>, 'what it lets through is counted as missed, not hidden';
ok %v<unnecessary_approvals> == 0, 'and asks nobody anything';

my %k1 = %r<scenarios>.first(*<id>.starts-with('K1'))<modes><vibe>;
is %k1<outcome>, 'blocked', 'K1: a promise marked solid holds in a vibe project';
my %k3 = %r<scenarios>.first(*<id>.starts-with('K3'))<modes><vibe>;
is %k3<outcome>, 'agreement-required', 'K3: taking the word off and weakening it in one step waits, in a vibe project';
my %k6 = %r<scenarios>.first(*<id>.starts-with('K6'))<modes><vibe>;
is %k6<outcome>, 'pass', 'K6: establishing one promise on day one is free in an exploring file';
is %r<scenarios>.first(*<id>.starts-with('K6'))<modes><enforced><outcome>, 'pass', 'K6: and free in an established one: asking more of a promise never waits';

# three outcomes, never one
ok %e<func_pass_but_invariant_fail> >= 6, "working software that breaks an invariant is counted as such ({%e<func_pass_but_invariant_fail>} in enforced)";
my %j3 = %r<scenarios>.first(*<id>.starts-with('J3'))<modes><enforced>;
is %j3<func_pass>, 'pass', 'J3: the feature works';
is %j3<invariant_pass>, 'fail', 'J3: the holdout says the invariant is gone';
ok %j3<verified_pass>, 'J3: and the gate verified it, because the repository\'s own test could not see it: F yes, I no, V yes is the honest miss';
my %j7 = %r<scenarios>.first(*<id>.starts-with('J7'))<modes><enforced>;
is %j7<outcome>, 'blocked', 'J7: the same change against a strict test is held';
nok %j7<verified_pass>, 'and is not verified';
for %r<scenarios>.grep(*<alternative_to>) -> %s {
    is %s<modes><enforced><outcome>, 'pass', "{%s<id>}: the compliant alternative passes";
    is %s<modes><enforced><invariant_pass>, 'pass', "{%s<id>}: and keeps the invariant";
    nok %s<modes><enforced><unnecessary_approval>, "{%s<id>}: and asks nobody";
}
is %r<totals><enforced><unstable>, 0, 'no classification disagreed between trials';
ok $out.add('latest.md').slurp.contains('Three outcomes, never one'), 'the report keeps the three outcomes apart';

ok $out.add('latest.md').slurp.contains('Nothing here measures whether a model obeys'), 'the report says what it does not measure';

done-testing;
