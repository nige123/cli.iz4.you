use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4::Document;

# every file carries the foundation after IS FOR WHO?; f() puts it there,
# and FL is how many lines that adds; c() is one promise as a card
my $F  = foundation-block();
my $FL = $F.lines.elems + 1;
sub f(Str $text --> Str) { $text.subst(/ ('IS FOR WHO' '?'? \n \N+ \n) /, { $0 ~ "\n" ~ $F }) }
sub c(Str $name, Str $always = 'Something holds.', Str $protects = 'what people rely on' --> Str) {
    card-lines('PROMISE', $name, 'it applies', ($always,), ($protects,), CHANGE-SIGNED).join("\n") ~ "\n";
}
constant HEAD = "IZ4 shop.example.com\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n";

# ---- the current format: the two questions, then promise cards ------------

my $job = q:to/END/;
    IZ4 jobs.example.com

    # comments are for humans
    IS FOR WHAT?
    Helping people find work they love to do.

    IS FOR WHO?
    People looking for work.

    PROMISE visible-by-choice.jobs.example.com
      WHEN      a profile can be seen
      ALWAYS    People control whether their profile
                is visible.
      PROTECTS  Looking for work should not mean surrendering privacy.
      CHANGES REQUIRE signed human approval for the exact change
      CHECKED WITH    linked tests; failures block commit

    PROMISE contact-by-invitation.jobs.example.com
      WHEN      an employer wants to reach someone
      ALWAYS    Employers cannot contact someone until that person initiates contact.
      PROTECTS  Job seekers should not acquire another unsolicited inbox.
      CHANGES REQUIRE signed human approval for the exact change
      CHECKED WITH    linked tests; failures block commit
    END

my $doc = IZ4::Document.parse(f($job));
ok $doc.ok, 'the example from the brief is a valid IZ4';
nok $doc.warnings, 'and draws no warnings';
is $doc.for-what, 'Helping people find work they love to do.', 'IS FOR WHAT read';
is $doc.for-who, 'People looking for work.', 'IS FOR WHO read';
is $doc.invariants».id, ('visible-by-choice.jobs.example.com', 'contact-by-invitation.jobs.example.com'), 'project invariants are known by their names, in file order';
is $doc.namespace, 'jobs.example.com', 'and the namespace is what the header names';
is $doc.invariants[0].text, 'People control whether their profile is visible.',
    'wrapped lines join into one invariant';
is $doc.invariants[0].because, 'Looking for work should not mean surrendering privacy.',
    'PROTECTS belongs to the card it is on';
is $doc.invariants[1].because, 'Job seekers should not acquire another unsolicited inbox.',
    'each PROTECTS to its own';
is $doc.invariants[0].line, 10 + $FL, 'invariant line tracked';

# the headers are questions; a file that leaves out the question mark is read, with a warning
my $unasked = IZ4::Document.parse(f("IZ4 shop.example.com\n\nIS FOR WHAT\nSign-in codes.\n\nIS FOR WHO?\nPeople signing in.\n"));
ok $unasked.ok, 'IS FOR WHAT without its question mark still parses';
is $unasked.for-what, 'Sign-in codes.', 'and is read';
like $unasked.warnings».Str.join, /"IS FOR WHAT is a question: write it as 'IS FOR WHAT?'"/, 'with a warning saying how to write it';

# minimal files are valid: two answers are a real IZ4
my $minimal = IZ4::Document.parse(f("IZ4 shop.example.com\n\nIS FOR WHAT?\nSign-in codes.\n\nIS FOR WHO?\nPeople signing in.\n"));
ok $minimal.ok && !$minimal.warnings, 'a two-question IZ4 with no invariants is valid';
nok $minimal.invariants, 'and has no project invariants of its own';

# every field of a card is required
my $bare = IZ4::Document.parse(f(HEAD ~ "\nPROMISE holds.shop.example.com\n  WHEN it applies\n  ALWAYS Something holds.\n  CHANGES REQUIRE signed human approval for the exact change\n  CHECKED WITH linked tests; failures block commit\n"));
nok $bare.ok, 'a promise without PROTECTS is an error';
like $bare.errors[0].Str, /'holds.shop.example.com has no PROTECTS'/, 'and is named';

# ---- an identity is a name ------------------------------------------------

for <owner-adjusted.honeywillow.com owner-adjusted.prices.honeywillow.com a.b.co x-1.shop2.example.com> -> $good {
    is identity-problem($good), '', "$good is a name an invariant can have";
}
for ('Owner.shop.example.com' => 'lower case', 'owner adjusted.shop.example.com' => 'space', 'owner_adjusted.shop.example.com' => 'a-z, 0-9',
     'owner..example.com' => 'both sides', '-owner.shop.example.com' => 'hyphen', 'owner.com' => 'a name and a domain',
     'owner-adjusted' => 'a name and a domain', '7' => 'a name and a domain', 'a.b.42' => 'has a letter', '5.shop.example.com' => 'a number is not a name',
     '2024.shop.example.com' => 'a number is not a name', '' => 'empty') -> (:key($bad), :value($why)) {
    ok identity-problem($bad).contains($why), "'$bad' is refused: $why";
}
ok is-identity('x.cli.iz4.you') && !reserved-identity('x.cli.iz4.you'), 'a deeper name under iz4.you is an ordinary name';
ok reserved-identity('sneaky.iz4.you'), 'a name directly under iz4.you that is not one of the five is reserved';
nok reserved-identity('honesty.iz4.you'), 'the five themselves are not "reserved": they are the foundation';

sub with-inv(Str $label, Str $text = 'Something holds.') { IZ4::Document.parse(f(HEAD ~ "\n" ~ c($label, $text))) }
like with-inv('sneaky.iz4.you').errors[0].Str, /"names directly under iz4.you are the foundation's" .* 'the same in every IZ4'/, 'a project cannot take a name in the foundation\'s namespace';
like with-inv('Owner_Adjusted').errors[0].Str, /"'Owner_Adjusted' is not a name a promise can have"/, 'an invalid name is an error that says why';
like with-inv('Owner_Adjusted').errors[0].fix, /'rename the promise on line ' \d+/, 'and says what to change, and where';
like with-inv('owner-adjusted').errors[0].Str, /"'owner-adjusted' is not the whole name"/, 'a name without its domain is told so';
like with-inv('owner-adjusted').errors[0].fix, /'write the heading on line ' \d+/, 'with the heading to write';

# ---- the foundation: five names, word for word, anywhere ------------------

is FOUNDATION-CARD».<id>, <humans-first.iz4.you do-no-harm.iz4.you human-agency.iz4.you honesty.iz4.you binding.iz4.you>,
    'the foundation is exactly these five names';
is FOUNDATION-CARD».<legacy>, (0, 1, 2, 3, 4), 'each remembers the number it carried, as history only';
for foundation-ids() -> $id {
    my $override = with-inv($id, 'My own version.');
    nok $override.ok, "$id cannot be redefined by a project";
}
my $none = IZ4::Document.parse(HEAD);
nok $none.ok, 'a file without the foundation fails';
like $none.errors[0].Str, /'the foundation is missing' .* 'humans-first.iz4.you, do-no-harm.iz4.you' .* 'iz4 foundation restore'/, 'and the error names what is missing and how to write it';
nok $none.foundation-intact, 'and is not intact';
my $altered = IZ4::Document.parse(f(HEAD).subst('do not harm people,', 'do not harm people much,'));
nok $altered.ok, 'an altered foundation fails';
like $altered.errors[0].Str, /'do-no-harm.iz4.you is part of the foundation' .* 'not yours to edit'/, 'naming the invariant and saying it is not the owner\'s to edit';
my $rewrapped = IZ4::Document.parse(f(HEAD).subst("do not harm people, or help", "do not harm people,\n      or help"));
ok $rewrapped.ok && $rewrapped.foundation-intact, 'wrapping the foundation differently is fine: only the words count';
my $one-gone = IZ4::Document.parse(f(HEAD).subst(/ 'FOUNDATION honesty.iz4.you' .*? <before 'FOUNDATION binding.iz4.you'> /, ''));
like $one-gone.errors».Str.join, /'the foundation is missing: every IZ4 carries honesty.iz4.you word for word'/, 'one missing foundation invariant is named alone';
my $twice-f = IZ4::Document.parse(f(HEAD) ~ "\n" ~ c('honesty.iz4.you', 'Again.').subst('PROMISE', 'FOUNDATION'));
like $twice-f.errors».Str.join, /'duplicate honesty.iz4.you'/, 'a foundation invariant appears once';

# order is presentation: the foundation may come last, or in any order
my $late = IZ4::Document.parse(HEAD ~ "\n" ~ c('mine.shop.example.com', 'Mine.') ~ "\n" ~ $F);
ok $late.ok && $late.foundation-intact, 'the foundation after a project invariant is the same file';
my @blocks = $F.split(/ <?before 'FOUNDATION '> /);
my $shuffled = IZ4::Document.parse(HEAD ~ "\n" ~ @blocks[0] ~ @blocks[1 .. *].reverse.join);
ok $shuffled.ok && $shuffled.foundation-intact, 'and so is the foundation in another order';
is $doc.foundation-spans.elems, 5, 'the document knows where each foundation block is';
like $doc.foundation-status, /"the foundation: in the file word for word (sha256 {FOUNDATION-CARD-DIGEST.substr(0, 12)})"/, 'every file carries it, and the status says so';

# the foundation has an order, 0 to 4, and Invariant Zero comes first
is INVARIANT-ZERO, 'humans-first.iz4.you', 'Invariant Zero is humans-first.iz4.you';
is foundation-ids().map({ foundation-order($_) }), (0, 1, 2, 3, 4), 'the foundation is ordered 0 to 4';
is (0 .. 4).map({ foundation-at($_) }), foundation-ids(), 'and each place gives its name back';
nok foundation-order('mine.shop.example.com').defined, "a project's own invariant has no place in that order";
nok foundation-at(5).defined, 'and there is nothing at 5';
like FOUNDATION-COMMENT, /'The foundation: the same words in every IZ4' .* 'Invariant Zero, humans-first.iz4.you, is the foundation of the foundation'/,
    'the comment written above the foundation in every new file says so';
nok FOUNDATION-COMMENT ~~ /:i 'five'/, 'without counting it out';

# ---- structural problems -------------------------------------------------

my $dups = IZ4::Document.parse(f(HEAD ~ "\nIS FOR WHO?\nz\n\n" ~ c('a.shop.example.com', 'a') ~ "\n" ~ c('a.shop.example.com', 'b')));
like $dups.report.join("\n"), /'IZ4:' $(9 + $FL) ': duplicate IS FOR WHO (first at line 6)'/, 'duplicate IS FOR reported';
like $dups.report.join("\n"), /'duplicate a.shop.example.com (first at line ' $(12 + $FL) ')'/, 'duplicate name reported';

my $missing = IZ4::Document.parse("IZ4 shop.example.com\n\n" ~ c('some.shop.example.com'));
like $missing.errors».Str.join("\n"), /'missing IS FOR WHAT' .* 'missing IS FOR WHO'/,
    'both IS FOR answers are required';

my $unnamed = IZ4::Document.parse(f(HEAD ~ "\nPROMISE\n  WHEN it applies\n"));
nok $unnamed.ok, 'a card with no name is an error: every invariant is named';

# a withdrawn name is retired: the comment says so, and the name cannot come back as something else
my $retired = IZ4::Document.parse(f(HEAD ~ "\n# PROMISE gone.shop.example.com was withdrawn on 2026-01-01; its name is retired.\n\n" ~ c('gone.shop.example.com', 'Something else.')));
is $retired.retired, ('gone.shop.example.com',), 'a withdrawal comment retires the name';
like $retired.errors[0].Str, /'reuses a withdrawn name'/, 'and reusing it is an error';
ok IZ4::Document.parse(f(HEAD ~ "\n# INVARIANT gone.shop.example.com was withdrawn on 2026-01-01; its name is retired.\n")).retired.grep('gone.shop.example.com'), 'and so does one written before cards';

# the namespace is what the header names
nok $minimal.namespace ne 'shop.example.com', 'even in a file with no invariant of its own';

# ---- every problem carries its next step ----------------------------------
is $missing.fixes, ('iz4 add for-what "what it is for"', 'iz4 add for-who "who it is for"', 'iz4 foundation restore'),
    'fixes are the next steps for the errors, in line order';
my $twice = IZ4::Document.parse("IZ4 shop.example.com\n\n" ~ c('a.shop.example.com') ~ "\n" ~ c('a.shop.example.com', 'Again.'));
is $twice.fixes.grep(* eq 'iz4 foundation restore').elems, 1, 'a step that clears several errors is listed once';
ok $twice.fixes.first(*.contains('line ')), 'and the duplicate names its line';

# old concepts have no place, and the error says where they belong
my $spec = IZ4::Document.parse(f(HEAD ~ "\nBEHAVIOURS\nSearch shows 20 results.\n"));
like $spec.errors[0].Str, /"unknown block 'BEHAVIOURS'" .* 'README, ADRs, tests or issues'/,
    'an unknown block steers specification content elsewhere';

like IZ4::Document.parse('').report.join, /'file is empty'/, 'empty file reported';
like IZ4::Document.parse("IS FOR WHAT?\nx\n").report[0], /'expected' .* 'IZ4'/, 'missing header reported';
like IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n").report[0], /'expected' .* 'IZ4' .* 'domain'/, 'and one with no domain';

# ---- a file from before cards is told so, and read no further -----------------
for "IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT rule.shop.example.com\nRule.\n\nBECAUSE\nwhy\n",
    "IZ4\n\nIS FOR WHAT?\nx\n\nINVARIANT\nUnnamed.\n",
    "IZ4 shop.example.com\n\nIS FOR WHAT?  x\nIS FOR WHO?   y\n\nrule:\n  WHERE:    it applies\n  ALWAYS:   Rule.\n  PROTECTS: them\n" -> $old {
    my $was = IZ4::Document.parse($old);
    is $was.form, 'earlier', 'a form from before cards is known for what it is';
    is $was.errors.elems, 1, 'in one finding';
    like $was.errors[0].Str, / 'earlier form' .* $(LAST-TO-MIGRATE) .* 'iz4 migrate' /, 'naming the last iz4 that moves it';
    nok $was.invariants, 'and nothing is read out of it';
    nok $was.ok, 'so nothing is reported as held';
    nok $was.foundation-intact, 'least of all the foundation';
}
is IZ4::Document.parse(f(HEAD ~ "\nINVARIANT stray.shop.example.com\n")).form, 'card', 'a card file with a mistake in it stays a card file';

# ---- mistakes the grammar catches by line ---------------------------------------
my $stray = IZ4::Document.parse(f("IZ4 shop.example.com\n\nsome prose\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n"));
like $stray.errors[0].Str, /'stray line'/, 'text outside a block is an error';
is $stray.errors[0].line, 3, 'at its line';
ok IZ4::Document.parse(f("\n# leading comment\n" ~ HEAD)).ok, 'blank and comment lines may precede the header';
ok IZ4::Document.parse(f(HEAD).chomp).ok, 'a file without a final newline is read';


# ---- what a person reads must be what is stored -----------------------------
subtest 'an invisible or direction-changing character is an error' => {
    my $src = "IZ4 jobs.example.com\n\nIS FOR WHAT?  Work.\n\nIS FOR WHO?   People.\n\nPROMISE private.jobs.example.com\n  WHEN      a private profile is requested\n  ALWAYS    It is shown \x[202E]only to people its owner chose\x[202C].\n  PROTECTS  a job seeker's say\n";
    my $doc = IZ4::Document.parse($src);
    nok $doc.ok, 'a right-to-left override makes the file invalid';
    like $doc.report.join("\n"), / 'IZ4:9: invisible or direction-changing character U+202E' /, 'named by line and code';
    like IZ4::Document.parse($src.subst("\x[202E]", "\x[200B]").subst("\x[202C]", '')).report.join("\n"), / 'U+200B' /, 'so is a zero-width space';
    ok IZ4::Document.parse($src.subst("\x[202E]", '').subst("\x[202C]", '')).errors.grep(*.Str.contains('invisible')) == 0, 'the same words in plain characters are not';
    ok IZ4::Document.parse("IZ4 jobs.example.com\n\nIS FOR WHAT?\tWork.\n").errors.grep(*.Str.contains('invisible')) == 0, 'a tab is not invisible in that sense';
}

done-testing;
