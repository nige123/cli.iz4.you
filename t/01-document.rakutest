use Test;
use IZ4::Document;

plan 38;

my $valid = q:to/END/;
    IZ4 0.0

    # a comment
    gist:
        A small tool for testing.
        Second line of gist.

    behaviours:
        - Does X.
        - Does Y,
          continued.

    invariants:
        - X must always remain true.

    constraints:

    references:
        - eu-cra: Article 13
    END

my $doc = IZ4::Document.parse($valid);
ok $doc.ok, 'valid document has no errors';
is $doc.version, '0.0', 'version parsed';
is $doc.sections».name, <gist behaviours invariants constraints references>, 'sections in order';
is $doc.section('gist').text, "A small tool for testing.\nSecond line of gist.", 'gist text';
is $doc.section('behaviours').items».text, ('Does X.', 'Does Y, continued.'), 'items with continuation';
is $doc.section('behaviours').items[1].line, 10, 'item line number';
is $doc.section('references').items[0].text, 'eu-cra: Article 13', 'reference text';
ok $doc.section('constraints').is-empty, 'empty section is allowed';
is $doc.section('invariants').last-line, 14, 'last content line tracked';
is $doc.section('invariants').indent, '    ', 'indent tracked';

# duplicate sections
my $dup = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    hi\n\ninvariants:\n\ninvariants:\n");
nok $dup.ok, 'duplicate section fails';
like $dup.report.join("\n"), /"IZ4:8: duplicate section 'invariants' (first defined at line 6)"/, 'duplicate reported with line';

# gist problems
my $empty = IZ4::Document.parse("IZ4 0.0\n\ngist:\n\nbehaviours:\n");
nok $empty.ok, 'empty gist fails';
like $empty.report.join("\n"), /'IZ4:3: gist is empty'/, 'empty gist reported';

my $placeholder = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    {GIST-PLACEHOLDER}\n");
nok $placeholder.ok, 'placeholder gist fails';
like $placeholder.report[0], /placeholder/, 'placeholder reported';

my $nogist = IZ4::Document.parse("IZ4 0.0\n\nbehaviours:\n    - x\n");
like $nogist.report.join, /"missing 'gist:'"/, 'missing gist reported';

# header
like IZ4::Document.parse("gist:\n    hi\n").report[0], /^ 'IZ4:1: expected' /, 'missing header reported at line 1';
like IZ4::Document.parse('').report.join, /'file is empty'/, 'empty file reported';
my $ver = IZ4::Document.parse("IZ4 0.9\n\ngist:\n    hi\n");
ok $ver.ok, 'a legacy versioned header is read silently';
nok $ver.warnings».Str.grep(*.contains('version')), 'no version warnings: the format is unversioned';
ok IZ4::Document.parse("IZ4\n\ngist:\n    hi\n").ok, 'the bare IZ4 header is the header';

# malformed entries
my $bad = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    hi\n\ninvariants:\n    not an item\n    -\nstray\n");
is $bad.errors».line, (7, 8, 9), 'malformed lines reported with correct line numbers';
like $bad.errors[0].Str, /"expected a '- ' entry"/, 'non-item in list section';
like $bad.errors[1].Str, /'empty entry'/, 'empty item';
like $bad.errors[2].Str, /'unexpected text at column 0'/, 'stray text';

# unknown sections are preserved, with a warning
my $unk = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    hi\n\nrisks:\n    - We chose Raku.\n");
ok $unk.ok && $unk.warnings».Str.grep(*.contains("unknown section 'risks'")) && $unk.section('risks').items[0].text eq 'We chose Raku.',
    'unknown section kept, warned about, not an error';

# invariant zero is inherited from the format version - omission is fine
my $zeroless = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    hi\n\ninvariants:\n    - Something else first.\n");
ok $zeroless.ok, 'a file without invariant zero still has no errors';
nok $zeroless.warnings.grep(*.Str.contains('invariant zero')),
    'omission draws no warning: the binding is inherited';
my $zeroed = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    hi\n\ninvariants:\n    - " ~ INVARIANT-ZERO ~ "\n");
nok $zeroed.warnings, 'the canonical text in first place is clean';

# numbered invariants: numbers are references, duplicates defeat them
is invariant-number('Invariant 3: no surprises.'), '3', 'invariant number extracted';
nok invariant-number('No number here.').defined, 'unnumbered entry has no number';
my $dupnum = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    hi\n\ninvariants:\n    - Invariant 3: a.\n    - Invariant 3: b.\n");
nok $dupnum.ok, 'duplicate invariant number is an error';
like $dupnum.errors[0].Str, /"duplicate invariant number '3'" .* 'first used at line 7'/,
    'duplicate number reported with both lines';

# every invariant is numbered (Invariant 9): an unnumbered one is a warning
my $unnum = IZ4::Document.parse("IZ4\n\ngist:\n    hi\n\ninvariants:\n    - Invariant 0: humans first.\n    - No number.\n    - Invariant zero: legacy spelling.\n    - Invariant 2: b.\n");
ok $unnum.ok, 'an unnumbered invariant is still a valid file';
my @nw = $unnum.warnings.grep(*.message.contains('unnumbered'));
is @nw».line, (8,), 'one warning for the one unnumbered invariant (legacy Invariant 0 spellings count as numbered)';
like @nw[0].Str, /'unnumbered invariant' .* "'iz4 number'"/, 'the warning points at iz4 number';
is $unnum.unnumbered-invariants».text, ('No number.',), 'unnumbered-invariants lists them in order';
