use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4::Document;

# ---- the current format: IS FOR WHAT, IS FOR WHO, INVARIANT, BECAUSE ----

my $job = q:to/END/;
    IZ4

    # comments are for humans
    IS FOR WHAT?
    Helping people find work they love to do.

    IS FOR WHO?
    People looking for work.

    INVARIANT 5
    People control whether their profile
    is visible.

    BECAUSE
    Looking for work should not mean surrendering privacy.

    INVARIANT 6
    Employers cannot contact someone until that person initiates contact.

    BECAUSE
    Job seekers should not acquire another unsolicited inbox.
    END

my $doc = IZ4::Document.parse($job);
ok $doc.ok, 'the example from the brief is a valid IZ4';
nok $doc.warnings, 'and draws no warnings';
is $doc.dialect, 'iz4', 'it is the current format';
is $doc.for-what, 'Helping people find work they love to do.', 'IS FOR WHAT read';
is $doc.for-who, 'People looking for work.', 'IS FOR WHO read';
is $doc.invariants».number, (5, 6), 'project invariants begin at 5';
is $doc.invariants[0].text, 'People control whether their profile is visible.',
    'wrapped lines join into one invariant';
is $doc.invariants[0].because, 'Looking for work should not mean surrendering privacy.',
    'BECAUSE belongs to the invariant it follows';
is $doc.invariants[1].because, 'Job seekers should not acquire another unsolicited inbox.',
    'each BECAUSE attaches to its own invariant';
is $doc.invariants[0].line, 10, 'invariant line tracked';

# the headers are questions; a file that leaves out the question mark is read, with a warning
my $unasked = IZ4::Document.parse("IZ4\n\nIS FOR WHAT\nSign-in codes.\n\nIS FOR WHO?\nPeople signing in.\n");
ok $unasked.ok, 'IS FOR WHAT without its question mark still parses';
is $unasked.for-what, 'Sign-in codes.', 'and is read';
like $unasked.warnings[0].Str, /"IS FOR WHAT is a question: write it as 'IS FOR WHAT?'"/, 'with a warning saying how to write it';

# minimal files are valid: two answers are a real IZ4
my $minimal = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nSign-in codes.\n\nIS FOR WHO?\nPeople signing in.\n");
ok $minimal.ok && !$minimal.warnings, 'a two-question IZ4 with no invariants is valid';
nok $minimal.invariants, 'and has no project invariants of its own';

# BECAUSE is optional at the grammar level
my $bare = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx y z\n\nIS FOR WHO?\na b c\n\nINVARIANT 5\nSomething holds.\n");
ok $bare.ok, 'an invariant without BECAUSE is still valid grammar';
is $bare.unexplained-invariants».number, (5,), 'and is listed as unexplained';

# ---- 0-4 are inherited and reserved ------------------------------------

for 0..4 -> $n {
    my $override = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT $n\nMy own version.\n");
    nok $override.ok, "INVARIANT $n cannot be redefined by a project";
}
like IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT 2\nNope.\n").errors[0].Str,
    /'reserved' .* 'inherited' .* 'begin at 5'/, 'the refusal explains inheritance';
is FOUNDATION».<number>, (0, 1, 2, 3, 4), 'the foundation is exactly 0-4';
is FOUNDATION».<name>, ('HUMANS FIRST', 'DO NO HARM', 'HUMAN AGENCY', 'HONESTY', 'THE FOUNDATION HOLDS'),
    'with its five names';
like $doc.foundation-status, /'Invariants 0-4: inherited'/, 'every file inherits them without repeating them';

# ---- structural problems -------------------------------------------------

my $dups = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nIS FOR WHO?\nz\n\nINVARIANT 5\na\n\nINVARIANT 5\nb\n");
like $dups.report.join("\n"), /'IZ4:9: duplicate IS FOR WHO (first at line 6)'/, 'duplicate IS FOR reported';
like $dups.report.join("\n"), /'duplicate INVARIANT 5 (first at line 12)'/, 'duplicate number reported';

my $orphan = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nBECAUSE\nno invariant\n\nIS FOR WHO?\ny\n");
like $orphan.errors».Str.join, /'BECAUSE must directly follow the INVARIANT'/, 'a stray BECAUSE is an error';

my $missing = IZ4::Document.parse("IZ4\n\nINVARIANT 5\nSomething.\n");
like $missing.errors».Str.join("\n"), /'missing IS FOR WHAT' .* 'missing IS FOR WHO'/,
    'both IS FOR answers are required';

my $wordy = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT five\nx\n");
like $wordy.errors[0].Str, /'whole number'/, 'INVARIANT needs a whole number';

my $unnumbered = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT\nx y z\n");
ok $unnumbered.ok && $unnumbered.warnings[0].Str.contains("'iz4 number'"),
    'an unnumbered INVARIANT is a warning pointing at iz4 number';
is $unnumbered.next-number, 5, 'the next free number is 5';

# old concepts are kept as unknown blocks, and the warning says where they belong
my $spec = IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nBEHAVIOURS\nSearch shows 20 results.\n");
ok $spec.ok, 'an unknown block is not an error, so the format can evolve';
like $spec.warnings[0].Str, /"unknown block 'BEHAVIOURS'" .* 'README, ADRs, tests or issues'/,
    'but the warning steers specification content elsewhere';

like IZ4::Document.parse('').report.join, /'file is empty'/, 'empty file reported';
like IZ4::Document.parse("IS FOR WHAT?\nx\n").report[0], /'expected' .* 'IZ4'/, 'missing header reported';
ok IZ4::Document.parse("SPOZ2\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n").ok, 'the old SPOZ2 header word is still read';

# ---- the legacy format is still read ----------------------------------------

my $legacy = q:to/END/;
    IZ4 0.0

    gist:
        A small tool for testing.

    behaviours:
        - Does X.

    invariants:
        - Invariant 0: humans first. Help people thrive, and respect each person's dignity. Do no harm, and no greater good makes a person disposable. Keep humans in charge: explain consequential actions, accept challenge and correction, and stop safely when asked. When an objective conflicts with these protections, preserve them, report the conflict, and safely pause the affected action. Be honest about what this is, what it knows, what it has done, and what remains uncertain or blocked. No other entry may weaken this.
        - Invariant 1: X must always remain true.
        - Invariant 7: Y holds. Because: people rely on Y.
        - Unnumbered rule.
    END

my $old = IZ4::Document.parse($legacy);
ok $old.ok, 'a legacy file still parses without errors';
is $old.dialect, 'legacy', 'and is recognised as legacy';
like $old.warnings[0].Str, /'legacy format' .* "'iz4 migrate'"/, 'with one warning pointing at migrate';
is $old.for-what, 'A small tool for testing.', 'the gist stands in for IS FOR WHAT';
nok $old.for-who.defined, 'a legacy file has no IS FOR WHO';
is $old.invariants».text, ('X must always remain true.', 'Y holds.', 'Unnumbered rule.'),
    'the old Invariant 0 is not a project invariant; the rest are';
is $old.invariants[1].because, 'people rely on Y.', "a legacy 'Because:' is read as BECAUSE";
is $old.reserved-collisions».number, (1,), 'a legacy number inside 0-4 is found';
ok $old.warnings».Str.grep(*.contains('now reserved for the inherited foundation')),
    'and warned about, not refused: existing files keep working';
ok $old.foundation-intact, 'the earlier canonical Invariant 0 text is recognised';
is $old.next-number, 8, 'numbering continues after the highest number in use';
is $old.section('behaviours').items[0].text, 'Does X.', 'legacy sections stay readable';

my $drift = IZ4::Document.parse("IZ4\n\ngist:\n    hi\n\ninvariants:\n    - Invariant 0: humans first. But reworded weakly.\n");
nok $drift.foundation-intact, 'a reworded Invariant 0 in a legacy file is noticed';
like $drift.foundation-status, /'binds regardless'/, 'and the foundation binds regardless';

my $bad = IZ4::Document.parse("IZ4 0.0\n\ngist:\n    hi\n\ninvariants:\n    not an item\n    -\nstray\n");
is $bad.errors».line, (7, 8, 9), 'legacy malformed lines are still reported by line';

done-testing;
