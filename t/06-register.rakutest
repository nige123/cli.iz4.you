use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;
use IZ4::Register;

plan 94;

# Everything here is offline: no test ever reaches a real register.
%*ENV<XDG_CONFIG_HOME> = temp-dir.Str;
%*ENV<IZ4_REGISTER_TOKEN>:delete;
%*ENV<S2R_TOKEN>:delete;

# connection: the reports URL beside the IZ4, the token outside the repo
my $dir  = temp-dir;
my $path = minimal-iz4(:$dir);
my $reports-url = 'https://iz4.you/api/v1/projects/p1/reports';
nok register-url($path).defined, 'no register URL until saved';
my $cfg = save-register-url($path, $reports-url);
is $cfg.basename, '.iz4-register', 'URL lives beside the IZ4';
is register-url($path), $reports-url, 'URL round-trips';
nok token-for($reports-url).defined, 'no token until saved';
save-token($reports-url, 'secret-token');
is token-for($reports-url), 'secret-token', 'token round-trips from the store';
ok token-store().Str.starts-with(%*ENV<XDG_CONFIG_HOME>), 'token store honours XDG_CONFIG_HOME';
nok $dir.dir.first(*.basename eq 'tokens'), 'the token never lands in the project';
{
    temp %*ENV<IZ4_REGISTER_TOKEN> = 'env-wins';
    is token-for($reports-url), 'env-wins', 'environment token overrides the store';
}

# badge: card and snippets derived offline from the stored connection
my %b = badge-info($path);
is %b<card>, 'https://iz4.you/p/p1', 'card URL derived from the reports URL';
is %b<badge>, 'https://iz4.you/p/p1/badge.svg', 'badge URL sits beside the card';
is %b<markdown>, '[![IZ4](https://iz4.you/p/p1/badge.svg)](https://iz4.you/p/p1)',
    'GitHub-ready Markdown snippet';
like %b<html>, /'<a href="https://iz4.you/p/p1">'/, 'HTML snippet links to the card';
my $bare = temp-dir;
minimal-iz4(:dir($bare));
throws-like { badge-info($bare.add('IZ4')) }, X::IZ4, message => /'not connected'/,
    'badge for an unconnected IZ4 points at the register steps';
my ($brc, $bout, $berr) = iz4($dir, 'badge');
is $brc, 0, 'iz4 badge exits 0 when connected';
like $bout, /'[![IZ4](https://iz4.you/p/p1/badge.svg)](https://iz4.you/p/p1)'/,
    'iz4 badge prints the paste-ready snippet';

# evidence collection mirrors the s2r-report contract
if have-git() {
    my $repo = temp-dir;
    run 'git', '-C', $repo.Str, 'init', '-q';
    run 'git', '-C', $repo.Str, 'config', 'user.email', 't@test';
    run 'git', '-C', $repo.Str, 'config', 'user.name', 'Test';
    my $sp = minimal-iz4(:dir($repo));
    add-invariant($sp, 'Registered things stay registered.', :because('People find them there.'));
    run 'git', '-C', $repo.Str, 'add', '-A';
    run 'git', '-C', $repo.Str, 'commit', '-qm', 'x';

    my %r = collect-report($sp, :release('v1'));
    is %r<schema_version>, 'iz4-report/2', 'report declares its schema';
    ok %r<revision> ~~ /^ <[0..9a..f]> ** 40 $/, 'revision is the exact commit';
    ok %r<declaration><present>, 'declaration present';
    is %r<declaration><invariant_count>, 1, "the count is the project's own invariants, never the inherited 0-4";
    is %r<declaration><grammar_version>, 'IZ4', 'the grammar label names the current format';
    ok %r<declaration><digest> ~~ /^ <[0..9a..f]> ** 64 $/, 'digest is a sha256';
    is %r<declaration><canonical_digest>, canonical-digest($sp), 'iz4-digest/1 travels beside the raw digest';
    is %r<checks><syntax><outcome>, 'passed', 'syntax outcome from iz4 itself';
    is %r<release_label>, 'v1', 'release label carried';

    my $j = json-encode(%r);
    like $j, /'"schema_version":"iz4-report/2"'/, 'encodes as JSON';
    unlike $j, /'Registered things'/, 'the report never carries invariant text';

    # CLI: --dry-run prints the report and sends nothing
    my ($rc, $out, $err) = iz4($repo, 'report', '--dry-run');
    is $rc, 0, 'report --dry-run exits 0';
    like $out, /'"revision":"' <[0..9a..f]> ** 40 '"'/, 'dry run prints the payload';
}
else {
    skip 'no git available', 13;
}

# iz4-digest/1: the register's vectors (spec/iz4-digest-1.md), byte for byte
{
    my $d = temp-dir;
    sub vec(Blob $bytes --> Str) { my $f = $d.add('v'); $f.spurt($bytes); canonical-digest($f) }
    my $same = '1abb269161b7774f833898a6d2b61f40e537c5de5155254b903654b69ca99b89';
    is vec("IS FOR WHAT?\n".encode), $same, 'LF-terminated text';
    is vec("IS FOR WHAT?\r\n".encode), $same, 'CRLF is LF';
    is vec("IS FOR WHAT?".encode), $same, 'a missing final newline is added';
    is vec(Blob.new(0xEF, 0xBB, 0xBF, |"IS FOR WHAT?\n\n\n".encode.list)), $same, 'one BOM dropped, trailing LFs become one';
    is vec("IS FOR WHAT?\r".encode), $same, 'a lone CR is LF';
    is vec("IS FOR WHAT? \n".encode), 'fbc6708acc849d84ef5f7e657f5f8021f5313a94f2935ea016da63c3a5b35fe3', 'a trailing space is kept: it is a change to the words';
    is vec(Blob.new), '01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b', 'an empty file is one LF';
    nok vec(Blob.new(0xFF, 0x0A)).defined, 'not UTF-8: no canonical digest';
    is DIGEST-RULE, 'iz4-digest/1', 'the rule has the id the register wrote';
}

# the checkpoint request: schema, revision and the digests to compare
{
    my %r = revision => 'a' x 40, declaration => %( digest => 'b' x 64, canonical_digest => 'c' x 64 );
    my $b = checkpoint-body(%r);
    like $b, /'"schema_version":"iz4-registration/1"'/, 'checkpoint declares its schema';
    like $b, /'"revision":"' a ** 40 '"'/, 'and the revision';
    like $b, /'"canonical_digest":"' c ** 64 '"'/, 'and the canonical digest for the register to compare';
    is registrations-url('https://iz4.you/api/v1/projects/p9/reports'), 'https://iz4.you/api/v1/projects/p9/registrations', 'registrations sit beside reports';
    is json-field('{"ok":true,"sequence":13,"predecessor":null,"card":"https://iz4.you/p/AB"}', 'sequence'), '13', 'json-field reads a number';
    nok json-field('{"predecessor":null}', 'predecessor').defined, 'null is Nil';
    is json-field('{"card":"https://iz4.you/p/AB"}', 'card'), 'https://iz4.you/p/AB', 'and a string';
}

# CLI: --github writes the workflow and hands the token to gh on stdin
if have-git() {
    my $repo = temp-dir;
    run 'git', '-C', $repo.Str, 'init', '-q';
    run 'git', '-C', $repo.Str, 'config', 'user.email', 't@test';
    run 'git', '-C', $repo.Str, 'config', 'user.name', 'Test';
    minimal-iz4(:dir($repo));
    my $bin = temp-dir;
    my $gh  = $bin.add('gh');
    $gh.spurt: qq:to/SH/;
        #!/bin/sh
        case "\$1" in --version) echo 'gh version 2'; exit 0;; esac
        cat > '{$bin.add('gh.stdin')}'
        echo "\$@" > '{$bin.add('gh.args')}'
        SH
    $gh.chmod(0o755);
    temp %*ENV<PATH> = "{$bin}:{%*ENV<PATH>}";
    my ($rc, $out, $err) = iz4($repo, 'register',
        '--url=https://iz4.you/api/v1/projects/p9/reports', '--token=tok-123', '--github');
    is $rc, 0, 'register --url --token --github exits 0';
    my $wf = $repo.add('.github').add('workflows').add('iz4.yml');
    ok $wf.f, 'writes .github/workflows/iz4.yml';
    like $wf.slurp, /'iz4 report'/, 'the workflow runs iz4 report';
    like $wf.slurp, /'secrets.S2R_TOKEN'/, 'and reads the token from the repository secret';
    like $wf.slurp, /'actions/cache'/, 'the runtime is cached between runs';
    is $bin.add('gh.stdin').slurp.trim, 'tok-123', 'the token reaches gh on standard input';
    like $bin.add('gh.args').slurp, /'secret set S2R_TOKEN'/, 'as the repository secret S2R_TOKEN';
    nok $bin.add('gh.args').slurp.contains('tok-123'), 'never on the command line';
    nok $wf.slurp.contains('tok-123'), 'the token never lands in the repository';
    ($rc, $out, $err) = iz4($repo, 'register', '--github');
    is $rc, 0, 'running --github again is harmless';
    like $out, /'already set up'/, 'and says so';
    $wf.spurt("name: mine\n");
    ($rc, $out, $err) = iz4($repo, 'register', '--github');
    is $rc, 1, 'a different existing workflow is never overwritten';
    like $err, /'--force'/, 'the error says how to replace it';
    is $wf.slurp, "name: mine\n", 'and the file is untouched';

    # a gh that fails is reported as an error, never a crash (the sunk Proc throws otherwise)
    $gh.spurt: qq:to/SH/;
        #!/bin/sh
        case "\$1" in --version) echo 'gh version 2'; exit 0;; esac
        cat >/dev/null
        echo 'HTTP 401: not logged in' >&2
        exit 1
        SH
    ($rc, $out, $err) = iz4($repo, 'register', '--token=tok-456', '--github', '--force');
    is $rc, 1, 'a failing gh makes register exit 1';
    like $err, /'not logged in'/, 'with what gh said';
    like $err, /'gh auth login'/, 'and what to do about it';

    # a curl that cannot reach the register leaves report advisory: exit 0, reason on stderr
    my $curl = $bin.add('curl');
    $curl.spurt: qq:to/SH/;
        #!/bin/sh
        cat >/dev/null
        echo 'curl: (7) Failed to connect' >&2
        exit 7
        SH
    $curl.chmod(0o755);
    run 'git', '-C', $repo.Str, 'add', '-A';
    run 'git', '-C', $repo.Str, 'commit', '-qm', 'x';
    ($rc, $out, $err) = iz4($repo, 'report');
    is $rc, 0, 'report exits 0 when the register is unreachable';
    like $err, /'register unreachable' .* 'Failed to connect'/, 'and says so with the reason';
    ($rc, $out, $err) = iz4($repo, 'report', '--strict');
    is $rc, 1, 'report --strict exits 1 on the same failure';

    # a connected 'iz4 register' reports HEAD, then records a checkpoint.
    # The fake curl answers the reports endpoint 201 and the registrations
    # endpoint with whatever the test put in reply.status and reply.body.
    my $status = $bin.add('reply.status');
    my $body   = $bin.add('reply.body');
    my $log    = $bin.add('curl.log');
    $curl.spurt: q:to/SH/.subst('__LOG__', $log.Str, :g).subst('__BODY__', $body.Str).subst('__STATUS__', $status.Str);
        #!/bin/sh
        for a; do url="$a"; done
        cat >> '__LOG__'; echo >> '__LOG__'
        echo "$url" >> '__LOG__'
        case "$url" in
          */registrations) cat '__BODY__'; printf '\n%s' "$(cat '__STATUS__')";;
          *) printf '{"ok":true}\n201';;
        esac
        SH
    $status.spurt('201');
    $body.spurt('{"ok":true,"created":1,"sequence":1,"revision":"x","predecessor":null,"card":"https://iz4.you/p/p9"}');
    ($rc, $out, $err) = iz4($repo, 'register');
    is $rc, 0, 'a connected register exits 0 when a checkpoint is recorded';
    like $out, /'submitted'/, 'it submits evidence for HEAD first';
    like $out, /'Registered declaration: checkpoint 1 (revision ' <[0..9a..f]> ** 12 ', the first)'/, 'then says which checkpoint was recorded';
    like $out, /'card: https://iz4.you/p/p9'/, 'and where to see it';
    like $out, /'IZ4 Trademark Licence'/, 'the licence note still closes the output';
    my @calls = $log.slurp.lines.grep(*.starts-with('http'));
    like @calls[0], /'/reports' $/, 'the report call comes first';
    like @calls[1], /'/registrations' $/, 'the checkpoint call second';
    like $log.slurp, /'"schema_version":"iz4-registration/1"'/, 'with the registration schema';
    like $log.slurp, /'"schema_version":"iz4-report/2"'/, 'and the report with schema 2';
    nok $out.contains('prov') || $out.contains('certif') || $out.contains('verif'), 'nothing claims proof, certification or verification';

    $status.spurt('201');
    $body.spurt('{"ok":true,"created":1,"sequence":14,"predecessor":13,"card":"https://iz4.you/p/p9"}');
    ($rc, $out, $err) = iz4($repo, 'register');
    like $out, /'checkpoint 14 (revision ' <[0..9a..f]> ** 12 ', follows checkpoint 13)'/, 'a later checkpoint names its predecessor';

    $status.spurt('200');
    $body.spurt('{"ok":true,"created":0,"sequence":14,"predecessor":13,"card":"https://iz4.you/p/p9"}');
    ($rc, $out, $err) = iz4($repo, 'register');
    is $rc, 0, 'the same declaration again exits 0';
    like $out, /'checkpoint 14 already records this declaration'/, 'and says nothing new was recorded';

    $status.spurt('409');
    $body.spurt('{"ok":false,"error":"not_registered","message":"Register the project on its publish page first."}');
    ($rc, $out, $err) = iz4($repo, 'register');
    is $rc, 1, 'an unregistered project exits 1';
    like $err, /'publish page first'/, 'with what the register said';
    like $err, /'Publish the project' .* 'card on iz4.you first' .* 'Licence is accepted there'/, 'and where the licence is accepted';

    $status.spurt('409');
    $body.spurt('{"ok":false,"error":"digest_mismatch","message":"The digest differs from the evidence."}');
    ($rc, $out, $err) = iz4($repo, 'register');
    is $rc, 1, 'a digest mismatch exits 1';
    like $err, /'No checkpoint recorded' .* 'different digest' .* 'iz4 report, then: iz4 register'/, 'and says nothing was recorded, and what to do';

    $status.spurt('401');
    $body.spurt('{"ok":false,"error":"unauthorized","message":"Unknown token."}');
    ($rc, $out, $err) = iz4($repo, 'register');
    is $rc, 1, 'a rejected token exits 1';
    like $err, /'iz4 register --token=<token>'/, 'and says how to mint a new one';

    # an uncommitted IZ4 is never checkpointed under HEAD's revision
    $repo.add('IZ4').spurt($repo.add('IZ4').slurp ~ "\n# edited\n");
    my $before = $log.slurp.lines.elems;
    ($rc, $out, $err) = iz4($repo, 'register');
    is $rc, 1, 'an uncommitted IZ4 exits 1';
    like $err, /'uncommitted changes' .* 'commit it first'/, 'and asks for the commit first';
    is $log.slurp.lines.elems, $before, 'without talking to the register at all';
}
else {
    skip 'no git available', 43;
}

# CLI: an unconnected IZ4 is guided through signing up first
my $fresh = temp-dir;
minimal-iz4(:dir($fresh));
my ($rc, $out, $err) = iz4($fresh, 'register');
like $out, /'Sign up first' .* 'https://iz4.you/start'/, 'register guides sign-up first, on iz4.you';

# CLI: register says what registering includes; the acceptance is on the site, never here
like $out, /'IZ4 Trademark Licence' \s+ '(iz4-trademark-licence/1.0-draft)'/,
    'register names the trademark licence that registering includes, by its own id';
like $out, /'accept it on iz4.you when you publish the card, not here'/, 'and says the acceptance happens on the site';
nok $out.contains('[Y/n]') || $out.contains('[y/n]'), 'without asking anything itself';
($rc, $out, $err) = iz4($fresh, 'check');
nok $out.contains('Trademark'), 'check says nothing about the licence: no command is gated on it';

# CLI: report outside Git is a hard, plain error
my $nogit = temp-dir;
minimal-iz4(:dir($nogit));
($rc, $out, $err) = iz4($nogit, 'report', '--dry-run');
is $rc, 1, 'report outside Git exits 1';
like $err, /'not in a Git repository'/, 'and says why';
