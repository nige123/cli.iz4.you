use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;
use IZ4::Register;
use IZ4::Gate;

# The gate compares two Git trees and says whether a change alters a
# commitment, needs a person's agreement, is blocked, or could not be
# assessed.  Every scenario here is offline and hermetic.



unless have-git() { skip-rest 'no git available'; exit }

my %hermetic = GIT_CONFIG_GLOBAL => temp-dir().add('gitconfig').Str, GIT_CONFIG_NOSYSTEM => '1';
%hermetic<GIT_CONFIG_GLOBAL>.IO.spurt('');
%*ENV{.key} = .value for %hermetic;
%*ENV<IZ4_APPROVERS>:delete;
%*ENV<IZ4_CHECK_CMD>:delete;
%*ENV<IZ4_INTERACTIVE> = '0';

sub repo(--> IO::Path) {
    my $r = temp-dir;
    run 'git', '-C', $r.Str, 'init', '-q';
    run 'git', '-C', $r.Str, 'config', 'user.email', 't@test';
    run 'git', '-C', $r.Str, 'config', 'user.name', 'Test';
    $r;
}
sub g(IO::Path $r, *@a) { my $p = run 'git', '-C', $r.Str, |@a, :out, :err; my $o = $p.out.slurp(:close); $p.err.slurp(:close); $o.trim }
sub gate(IO::Path $r, *@a) { iz4($r, 'gate', |@a) }
# the top-level field: the last occurrence, since nested checks carry an 'outcome' too
# one change (or protection) object of a kind for an identity, as its JSON text
sub change($out, Str $kind, Str $id?) {
    my @objs = $out.match(/ '{' <-[{}]>* '"kind":"' $kind '"' <-[{}]>* '}' /, :g).map(~*);
    $id.defined ?? (@objs.first({ .contains('"id":"' ~ $id ~ '"') }) // '') !! (@objs.head // '');
}
sub changes($out, Str $kind) { $out.match(/ '{' <-[{}]>* '"kind":"' $kind '"' <-[{}]>* '}' /, :g).map(~*).List }
sub field($obj, Str $k) { $obj ~~ / '"' $k '":"' (<-["]>*) '"' / ?? ~$0 !! Str }
sub json($out, $k) { my @m = $out.match(/ '"' $k '"' \s* ':' \s* [ '"' (<-["]>*) '"' | (<[0..9.-]>+) | 'null' ] /, :g); @m ?? (@m.tail[0].defined ?? @m.tail[0].Str !! Str) !! Str }

# a project: an IZ4 with one invariant of its own, a shell test that carries
# its name and checks a file in the tree, so the test can be made to fail by
# a code-only change
my constant VIS     = 'visible-by-choice.shop.example.com';
my $VIS = VIS;
my constant CONTACT = 'no-first-contact.shop.example.com';
my $CONTACT = CONTACT;
my constant TEST    = 'tests/visible-by-choice.sh';
my $TEST = TEST;
my $r = repo;
my $sp = minimal-iz4(:dir($r));
add-invariant($sp, 'People control whether their profile is visible.', :name(VIS), :because('Privacy.'));
$r.add('lib').mkdir; $r.add('tests').mkdir;
$r.add('lib/profile.txt').spurt("visible: private\n");
$r.add(TEST).spurt("#!/bin/sh\n# INVARIANT {$VIS}\ngrep -q 'visible: private' lib/profile.txt\n");
g($r, 'add', '-A');

# ---- an initial tree: everything in it is a new commitment -----------------
my ($rc, $out, $err) = gate($r, '--staged', '--json');
is $rc, 0, 'advisory gate exits 0 whatever the outcome';
is json($out, 'schema'), 'iz4-gate/2', 'the result is versioned';
is json($out, 'outcome'), 'agreement-required', 'an initial IZ4 is a commitment change: agreement required';
is json($out, 'base'), 'none', 'with no base, since HEAD is unborn';
is json($out, 'selection'), 'staged', 'the staged tree was compared';
ok change($out, 'added', VIS), 'the invariant is reported as added, under its name';
like change($out, 'added', VIS), /'"digest":"' <xdigit>**64 '"'/, 'with the digest of its exact words';
is field(change($out, 'added', VIS), 'digest'), invariant-digest(VIS, 'People control whether their profile is visible.', 'Privacy.'), 'which is the iz4-invariant/1 digest';
unlike $out, /'"number"'/, 'no change carries a number';
ok $out.contains('"checks":[{') && $out.contains('"invariants":["' ~ $VIS ~ '"],"outcome":"passed"'), 'a check carries the names of the invariants it stands for';
like $out, /'"kind":"purpose"'/, 'and so is IS FOR WHAT';
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 2, 'under --enforce agreement-required is exit 2';
like $out, /"INVARIANT {$VIS} added: People control whether their profile is visible."/, 'the proposal shows the exact wording';
like $out, /"✓ {$TEST} ({$VIS}) passed"/, 'the linked test was run from the candidate tree';
like $out, /"next:\n  1. iz4 approve --staged"/, 'and the next step is a person approving';
g($r, 'commit', '-qm', 'init');

# ---- a routine change passes without anyone being asked -------------------
$r.add('README.md').spurt("hello\n");
g($r, 'add', 'README.md');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 0, 'a routine change passes under --enforce';
like $out, /'commitments and protections: unchanged'/, 'nothing committed to changed';
like $out, /'outcome: pass'/, 'outcome pass';
($rc, $out, $err) = gate($r, '--staged', '--json');
is json($out, 'outcome'), 'pass', 'and in JSON';
is json($out, 'exit_code'), '0', 'exit code 0 in the result';
g($r, 'commit', '-qm', 'readme');

# ---- the working directory never substitutes for the staged tree ----------
$sp.spurt($sp.slurp ~ "\nINVARIANT unstaged.shop.example.com\nUnstaged words.\n\nBECAUSE\nNot staged.\n");
($rc, $out, $err) = gate($r, '--staged', '--json');
is json($out, 'outcome'), 'pass', 'an unstaged IZ4 edit is not in the candidate tree, so nothing changed';
g($r, 'checkout', '--', 'IZ4');

# ---- a new invariant needs agreement; a revision and a removal too --------
add-invariant($sp, 'Employers cannot contact someone first.', :name(CONTACT), :because('No new inbox.'));
g($r, 'add', 'IZ4');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 2, 'a new project invariant requires agreement';
like $out, /"INVARIANT {$CONTACT} added: Employers cannot contact someone first." \n \s+ 'BECAUSE No new inbox.'/, 'with its BECAUSE';
like $out, /'approval: none for this candidate tree'/, 'and no approval exists yet';
my $tree6 = json(gate($r, '--staged', '--json')[1], 'candidate');

# approving is a person's act: a script gets a pending state and nothing is recorded
($rc, $out, $err) = iz4($r, 'approve', '--staged');
is $rc, 2, 'approve without a terminal exits 2: pending';
like $out, /'pending: agreement needs a person at a terminal'/, 'and says so';
like $out, /'Nothing was recorded'/, 'recording nothing';
is g($r, 'for-each-ref', 'refs/iz4/approvals/'), '', 'no approval ref was written';

# a person at a terminal rejects: nothing recorded
($rc, $out, $err) = iz4-talk($r, "r\n", 'approve', '--staged');
is $rc, 2, 'a rejection exits 2';
like $out, /'Rejected: nothing recorded'/, 'and records nothing';
is g($r, 'for-each-ref', 'refs/iz4/approvals/'), '', 'still no approval ref';

# a person at a terminal accepts: a terminal approval, bound to this exact tree
($rc, $out, $err) = iz4-talk($r, "a\n", 'approve', '--staged');
is $rc, 0, 'an acceptance exits 0';
like $out, /'Agreement covers exactly: repository ' <xdigit>+ ', base ' <xdigit>+ ', candidate tree ' <xdigit>+/, 'the proposal says exactly what agreement covers';
like $out, /'Recorded: terminal approval by t@test for tree ' <xdigit>**12 ' at refs/iz4/approvals/' <xdigit>+/, 'and where the approval went';
like $out, /'counts for local checks only'/, 'a terminal approval says what it is good for';
like g($r, 'for-each-ref', 'refs/iz4/approvals/'), /'refs/iz4/approvals/' $tree6/, 'the approval ref names the candidate tree';
like g($r, 'cat-file', '-p', "refs/iz4/approvals/$tree6"), /'"schema":"iz4-approval/1"'/, 'and holds an iz4-approval/1 document';
is g($r, 'ls-files', '--error-unmatch', 'approval.json'), '', 'nothing about the approval is inside the tree it approves';

($rc, $out, $err) = gate($r, '--staged', '--json');
is json($out, 'outcome'), 'pass', 'advisory: the terminal approval satisfies the agreement';
like $out, /'"level":"terminal"'/, 'and is labelled terminal';
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 2, 'enforce: a terminal approval is not accepted at an acceptance boundary';
like $out, /'approval: invalid - a terminal approval by t@test is not accepted under --enforce'/, 'and says why';
like $out, /'iz4 approve --staged --sign=<key> --by=<principal>'/, 'and how to get one that is';

# ---- a signed approval, verified against an allowed-signers file ----------
my $have-ssh = so (try run 'ssh-keygen', '-Y', 'sign', :out, :err).defined;
if $have-ssh {
    my $keys = temp-dir;
    my $key  = $keys.add('key');
    run 'ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', $key.Str, :out, :err;
    my $signers = $keys.add('allowed_signers');
    $signers.spurt("owner\@example.com {$key.IO.extension('pub', :parts(0)).slurp}");
    ($rc, $out, $err) = iz4-talk($r, "a\n", 'approve', '--staged', "--sign={$key}", '--by=owner@example.com');
    is $rc, 0, 'a signed approval is recorded' or diag $err;
    like $out, /'Recorded: ssh-signature approval by owner@example.com'/, 'and named as such';
    ($rc, $out, $err) = gate($r, '--staged', '--enforce', "--approvers={$signers}");
    is $rc, 0, 'enforce: a signed approval by an allowed signer passes';
    like $out, /'approval: valid (signed) by owner@example.com'/, 'and is labelled signed';
    ($rc, $out, $err) = gate($r, '--staged', '--enforce');
    is $rc, 2, 'enforce with no allowed-signers file does not accept even a signed approval';
    like $out, /'no allowed-signers file was given'/, 'and says so';
    my $others = $keys.add('others');
    my $key2 = $keys.add('key2');
    run 'ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', $key2.Str, :out, :err;
    $others.spurt("owner\@example.com {$key2.IO.extension('pub', :parts(0)).slurp}");
    ($rc, $out, $err) = gate($r, '--staged', '--enforce', "--approvers={$others}");
    is $rc, 2, 'a signature by a key the boundary does not list is refused';
    like $out, /'signature does not verify'/, 'and says so';
    # a forged approval: the stored document edited after signing
    my $forged = temp-dir.add('forged.json');
    $forged.spurt(g($r, 'cat-file', '-p', "refs/iz4/approvals/$tree6").subst('"method":"ssh-signature"', '"method":"ssh-signature","note":"edited"'));
    ($rc, $out, $err) = gate($r, '--staged', '--enforce', "--approvers={$signers}", "--approval={$forged}");
    is $rc, 2, 'an approval edited after signing is refused';
    like $out, /'signature does not verify'/, 'because its signature no longer verifies';
}
else { skip 'ssh-keygen -Y not available', 10 }

# a malformed approval never passes anything
my $bad = temp-dir.add('bad.json');
$bad.spurt("approved\n");
($rc, $out, $err) = gate($r, '--staged', '--enforce', "--approval={$bad}");
is $rc, 2, 'a file that merely says approved is not an approval';
like $out, /'approval: invalid - approval is not an iz4-approval/1 document'/, 'and the gate says what it got';

# editing the staged tree after approval invalidates it
$r.add('README.md').spurt("hello again\n");
g($r, 'add', 'README.md');
($rc, $out, $err) = gate($r, '--staged', '--json');
is json($out, 'outcome'), 'agreement-required', 'a different candidate tree has no approval';
like $out, /'"status":"missing"'/, 'the approval for the earlier tree does not transfer';
g($r, 'checkout', 'HEAD', '--', 'README.md');
g($r, 'reset', '-q', 'README.md');
($rc, $out, $err) = gate($r, '--staged', '--json');
is json($out, 'outcome'), 'pass', 'restoring the exact tree restores the approval';
g($r, 'commit', '-qm', 'no first contact');

# ---- the same gate over revisions: a bypassed local hook is caught later ---
($rc, $out, $err) = gate($r, '--candidate=HEAD', '--enforce', '--json');
is json($out, 'outcome'), 'agreement-required', 'the committed change still needs agreement when checked by revision';
is json($out, 'selection'), 'revisions', 'revision selection';
is json($out, 'base_ref'), 'HEAD^1', 'the base defaults to the first parent';
($rc, $out, $err) = gate($r, '--candidate=HEAD', '--base=HEAD~2', '--json');
ok change($out, 'added', CONTACT), 'an explicit base covers several commits at once';
my $root = g($r, 'rev-list', '--max-parents=0', 'HEAD');
($rc, $out, $err) = gate($r, "--candidate=$root", '--base=none', '--json');
is json($out, 'base'), 'none', 'an initial commit is gated against no base';
is json($out, 'outcome'), 'agreement-required', 'and its whole IZ4 is a new commitment';
($rc, $out, $err) = gate($r, '--candidate=nonsense', '--json');
is $rc, 1, 'an unknown revision is an operational error, exit 1 even in advisory mode';
is json($out, 'outcome'), 'error', 'reported as error, never pass';

# an approval made by revision is bound to that commit's tree and base
($rc, $out, $err) = iz4-talk($r, "a\n", 'approve', '--candidate=HEAD');
is $rc, 0, 'approving by revision works';
($rc, $out, $err) = gate($r, '--candidate=HEAD', '--json');
is json($out, 'outcome'), 'pass', 'and satisfies the gate for that revision';
($rc, $out, $err) = gate($r, '--candidate=HEAD', '--base=HEAD~2', '--json');
is json($out, 'outcome'), 'agreement-required', 'but not with another base';
like $out, /'rebased or merged, so agree again'/, 'which the gate explains';

# ---- a revision, a removal, a weakened protection -------------------------
$sp.spurt($sp.slurp.subst('Employers cannot contact someone first.', 'Employers may contact anyone.'));
g($r, 'add', 'IZ4');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 2, 'revising an invariant requires agreement';
like $out, /"INVARIANT {$CONTACT} revised" \n \s+ 'before: Employers cannot contact someone first.' .* \n \s+ 'after:  Employers may contact anyone.'/, 'with exact before and after';
g($r, 'checkout', 'HEAD', '--', 'IZ4'); g($r, 'reset', '-q', 'IZ4');

($rc, $out, $err) = iz4($r, 'withdraw', CONTACT, '--force');
is $rc, 0, 'the invariant is withdrawn' or diag $err;
g($r, 'add', 'IZ4');
($rc, $out, $err) = gate($r, '--staged', '--json');
is json($out, 'outcome'), 'agreement-required', 'withdrawing an invariant requires agreement';
ok change($out, 'removed', CONTACT), 'as a removal, under its name';
g($r, 'commit', '-qm', 'withdraw no-first-contact');

# a retired name coming back is blocked, not approvable
$sp.spurt($sp.slurp ~ "\nINVARIANT {$CONTACT}\nSomething else entirely.\n\nBECAUSE\nReasons.\n");
g($r, 'add', 'IZ4');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 3, 'reusing a withdrawn name is blocked';
like $out, /"BLOCKED: INVARIANT {$CONTACT} was withdrawn before; a retired name is never given to a different invariant"/, 'and says why';
like $out, /"next:\n" .* 'give the invariant a name the file has never used'/, 'with the way out';
($rc, $out, $err) = gate($r, '--staged', '--json');
ok change($out, 'reused-name', CONTACT), 'as reused-name in the result';
is json($out, 'outcome'), 'blocked', 'outcome blocked';
($rc, $out, $err) = iz4-talk($r, "a\n", 'approve', '--staged');
is $rc, 3, 'and no approval can lift it';
g($r, 'checkout', 'HEAD', '--', 'IZ4'); g($r, 'reset', '-q', 'IZ4');

# the linked test deleted: protection removed
g($r, 'rm', '-q', TEST);
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 2, 'removing the test that names an invariant requires agreement';
like $out, /"Protection of {$VIS}: removed"/, 'as a protection removal';
g($r, 'checkout', 'HEAD', '--', TEST); g($r, 'reset', '-q', 'tests');

# a skip line added to the linked test: weakened, suspected
$r.add(TEST).spurt($r.add(TEST).slurp.subst("grep", "exit 0 # skip for now\ngrep"));
g($r, 'add', 'tests');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 2, 'a new skip line in the linked test requires agreement';
like $out, /"Protection of {$VIS}: weakened"/, 'as a suspected weakening';
g($r, 'checkout', 'HEAD', '--', TEST); g($r, 'reset', '-q', 'tests');

# a harmless edit to the linked test is noted, not gated
$r.add(TEST).spurt($r.add(TEST).slurp ~ "# a comment\n");
g($r, 'add', 'tests');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 0, 'a changed linked test that still names its invariant and passes is not a commitment change';
like $out, /"({$VIS}: {$TEST} changed; its check runs below)"/, 'but is pointed out';
g($r, 'checkout', 'HEAD', '--', TEST); g($r, 'reset', '-q', 'tests');

# a linked test that uses git itself must find a working git: the gate's own
# temporary index must not leak into the checks it runs
$r.add(TEST).spurt("#!/bin/sh\n# INVARIANT {$VIS}\n"
    ~ "d=\$(mktemp -d) && cd \"\$d\" && git init -q && echo x > a && git add -A && git -c user.email=t\@t -c user.name=t commit -qm x && cd / && rm -rf \"\$d\"\n");
g($r, 'add', 'tests');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 0, 'a linked test that runs git itself passes: no GIT_INDEX_FILE leaks from the gate' or diag $out;
{
    # inside a hook Git exports GIT_INDEX_FILE; the checks must not inherit it
    my $before = g($r, 'write-tree');
    my ($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', :env(GIT_INDEX_FILE => $r.add('.git/index').absolute));
    is $rc, 0, 'with GIT_INDEX_FILE exported, as in a hook, the git-using check still passes' or diag $out;
    is g($r, 'write-tree'), $before, 'and it did not write into this repository\'s index';
}
g($r, 'checkout', 'HEAD', '--', TEST); g($r, 'reset', '-q', 'tests');

# ---- the environment: ignored files are linked into the candidate ---------
# A dependency the project keeps out of Git (an installed library, local
# configuration) must be there when the linked test runs, and must survive
# the gate's clean-up untouched.
{
    $r.add('.gitignore').spurt("deps/\n");
    $r.add('deps').mkdir;
    $r.add('deps/needed.txt').spurt("installed\n");
    my $keep = $r.add(TEST).slurp;
    $r.add(TEST).spurt($keep ~ "grep -q installed deps/needed.txt\n");
    g($r, 'add', '.gitignore', 'tests');
    ($rc, $out, $err) = gate($r, '--staged', '--enforce');
    is $rc, 0, 'a linked test finds the ignored dependency: the checkout is the environment' or diag $out;
    ok $r.add('deps/needed.txt').f, 'and the gate leaves the real dependency in place when it cleans up';
    is $r.add('deps/needed.txt').slurp, "installed\n", 'unchanged';
    ($rc, $out, $err) = gate($r, '--staged', '--json');
    like $out, /'"environment_links":1'/, 'the result says how many ignored entries were linked';

    # an untracked file that is NOT ignored is no part of the candidate, or its environment
    $r.add('new-code.txt').spurt("not staged\n");
    $r.add(TEST).spurt($keep ~ "test ! -e new-code.txt\n");
    g($r, 'add', 'tests');
    ($rc, $out, $err) = gate($r, '--staged', '--enforce');
    is $rc, 0, 'an untracked, unignored file is not linked in: a commit would not carry it' or diag $out;
    $r.add('new-code.txt').unlink;

    # a test that cannot start for want of a dependency is unassessed, not a failure
    $r.add(TEST).spurt($keep ~ 'echo "Can\'t locate Some/Module.pm in @INC (you may need to install it)" >&2; exit 2' ~ "\n");
    g($r, 'add', 'tests');
    ($rc, $out, $err) = gate($r, '--staged', '--enforce');
    is $rc, 4, 'a missing dependency makes the check unassessed (exit 4), never blocked' or diag $out;
    like $out, /"? {$TEST} ({$VIS}) unassessed: could not run: Can't locate Some/Module.pm"/, 'and says what could not be found';
    like $out, /"install the project's dependencies so {$TEST} can run"/, 'with the next step';

    # output that is not UTF-8 never stops the gate
    $r.add(TEST).spurt($keep ~ "printf 'price \\243 5\\n'; exit 1\n");
    g($r, 'add', 'tests');
    ($rc, $out, $err) = gate($r, '--staged', '--enforce');
    is $rc, 3, 'a failing test whose output is not UTF-8 is still reported as failed' or diag $out ~ $err;

    $r.add(TEST).spurt($keep);
    g($r, 'add', 'tests');
    g($r, 'commit', '-qm', 'gitignore for deps');
}

# ---- a code-only violation of a tested invariant is blocked --------------
$r.add('lib/profile.txt').spurt("visible: public\n");
g($r, 'add', 'lib');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 3, 'a failing linked test blocks, with the IZ4 untouched';
like $out, /"✗ {$TEST} ({$VIS}) failed"/, 'naming the test and the invariant';
like $out, /'outcome: blocked'/, 'outcome blocked';
($rc, $out, $err) = gate($r, '--staged', '--json');
is json($out, 'outcome'), 'blocked', 'in advisory mode the outcome is the same';
is $rc, 0, 'and the exit code is still 0 there';
# an approval cannot lift a blocked outcome
($rc, $out, $err) = iz4-talk($r, "a\n", 'approve', '--staged');
is $rc, 3, 'approve refuses a blocked candidate';
like $out, /'Nothing to approve: a blocked finding is not a proposal'/, 'and says so';
g($r, 'checkout', 'HEAD', '--', 'lib/profile.txt'); g($r, 'reset', '-q', 'lib');

# ---- the foundation cannot be weakened by any project ---------------------
$sp.spurt($sp.slurp.subst('Help people thrive, on their own terms.', 'Help people thrive, mostly.'));
g($r, 'add', 'IZ4');
($rc, $out, $err) = gate($r, '--staged', '--enforce');
is $rc, 3, 'altering the foundation is blocked';
like $out, /'no project approval can change it (foundation-holds.iz4.you)'/, 'and the gate says no approval can lift it';
like $out, /"next:\n  1. iz4 foundation --restore"/, 'with the restore as the next step';
g($r, 'checkout', 'HEAD', '--', 'IZ4'); g($r, 'reset', '-q', 'IZ4');

# ---- checks that cannot complete are unassessed, never a pass --------------
my $have-timeout = so (try run 'timeout', '--version', :out, :err).?exitcode == 0;
$r.add('lib/profile.txt').spurt("visible: private\n# touched\n");
g($r, 'add', 'lib');
if $have-timeout {
    my $slow = temp-dir.add('slow.sh');
    $slow.spurt("#!/bin/sh\nsleep 3\nexit 0\n");
    ($rc, $out, $err) = gate($r, '--staged', '--enforce', '--timeout=1', "--check-cmd=sh {$slow} \{file\}");
    is $rc, 4, 'a check that times out makes the outcome unassessed, exit 4';
    like $out, /"? {$TEST} ({$VIS}) timeout"/, 'and names the test';
}
else { skip 'no timeout utility', 2 }
($rc, $out, $err) = gate($r, '--staged', '--enforce', '--check-cmd=no-such-runner-here {file}');
is $rc, 4, 'a runner that cannot be found makes the outcome unassessed';
{
    # the same on a system with no 'timeout' utility, as macOS is by default
    my ($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', '--check-cmd=no-such-runner-here {file}', :env(IZ4_NO_TIMEOUT => '1'));
    is $rc, 4, 'without a timeout utility a missing runner is still unassessed, never blocked' or diag $out;
    like $out, /'could not run no-such-runner-here: not found'/, 'and named';
    ($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', :env(IZ4_NO_TIMEOUT => '1'));
    is $rc, 0, 'and a check that passes still passes there' or diag $out;
}
like $out, /'outcome: unassessed - a check could not be run, so this is not a pass'/, 'and the outcome says it is not a pass';
($rc, $out, $err) = gate($r, '--staged', '--enforce', '--/checks');
is $rc, 4, 'skipping the checks when linked tests exist is unassessed, not pass';
like $out, /'checks were not run (--no-checks): 1 invariant has a test naming it'/, 'and says so, with the count';
{
    # with no test naming any invariant there is nothing to skip: that is a pass
    my $bare = repo;
    minimal-iz4(:dir($bare));
    g($bare, 'add', '-A'); g($bare, 'commit', '-qm', 'init');
    $bare.add('x').spurt("y\n"); g($bare, 'add', 'x');
    my ($rc, $out, $err) = gate($bare, '--staged', '--enforce', '--/checks');
    is $rc, 0, '--no-checks with no linked tests is a pass: nothing was left unrun' or diag $out;
}
g($r, 'checkout', 'HEAD', '--', 'lib/profile.txt'); g($r, 'reset', '-q', 'lib');

# ---- the check command: flag, then IZ4_CHECK_CMD, then git config ---------
{
    g($r, 'config', 'iz4.checkCmd', 'false {file}');
    my ($rc, $out, $err) = gate($r, '--staged', '--enforce');
    is $rc, 3, "the repository's own git config iz4.checkCmd names the command that runs a check" or diag $out;
    ($rc, $out, $err) = gate($r, '--staged', '--enforce', '--check-cmd=true {file}');
    is $rc, 0, 'and --check-cmd takes precedence over it';
    ($rc, $out, $err) = iz4($r, 'gate', '--staged', '--enforce', :env(IZ4_CHECK_CMD => 'true {file}'));
    is $rc, 0, 'as does IZ4_CHECK_CMD';
    g($r, 'config', '--unset', 'iz4.checkCmd');
}

# ---- the pre-commit hook ---------------------------------------------------
($rc, $out, $err) = gate($r, '--install-hook');
like $out, /'pre-commit hook: installed (advisory'/, 'the advisory hook installs' or diag $err;
my $hook = $r.add('.git/hooks/pre-commit');
like $hook.slurp, /'iz4 gate --staged; exit 0'/, 'and never refuses';
($rc, $out, $err) = gate($r, '--install-hook', '--enforce');
like $out, /'pre-commit hook: updated (enforce'/, 'the enforcing hook replaces it';
like $hook.slurp, /'iz4 gate --staged --enforce'/, 'and refuses on any outcome but pass';
$hook.spurt("#!/bin/sh\necho mine\n");
($rc, $out, $err) = gate($r, '--install-hook');
is $rc, 1, 'a hook that is not ours is never overwritten';
like $err, /'--force'/, 'without --force';
is $hook.slurp, "#!/bin/sh\necho mine\n", 'and is left alone';

# ---- an invariant is compared by its name and nothing else -----------------
# The comparisons themselves, document against document; the same through
# the command follows.
{
    my constant PRICES = 'owner-adjusted.prices.shop.example.com';
    my $PRICES = PRICES;
    my $head = "IZ4\n\nIS FOR WHAT?\nHelping people find work they love to do.\n\nIS FOR WHO?\nPeople looking for work.\n\n";
    my $old-foundation = FOUNDATION-LEGACY.map({ "INVARIANT {.<number>} - {.<name>}\n{.<text>}\n\nBECAUSE\n{.<because>}\n\n" }).join;
    my sub block(Str $label, Str $text, Str $why) { "INVARIANT $label\n$text\n\nBECAUSE\n$why\n\n" }
    my sub named(*@blocks)  { IZ4::Document.parse($head ~ foundation-block() ~ @blocks.join) }
    my sub legacy(*@blocks) { IZ4::Document.parse($head ~ $old-foundation ~ @blocks.join) }
    my sub kinds(@c) { @c.map(*<kind>).join(' ') }
    my sub verdict(@c) { my %p = changes => @c.List, protections => (); is-blocked(%p) ?? 'blocked' !! needs-agreement(%p) ?? 'agreement-required' !! 'pass' }

    my $vis     = block(VIS, 'People control whether their profile is visible.', 'Privacy.');
    my $contact = block(CONTACT, 'Employers cannot contact someone first.', 'No new inbox.');
    my $base    = named($vis, $contact);
    ok $base.ok && !$base.legacy, 'a named base parses' or diag $base.errors.join('; ');
    is commitment-changes($base, named($vis, $contact)).elems, 0, 'the same file against itself changes nothing';

    # order is presentation
    my @c = commitment-changes($base, named($contact, $vis));
    is @c.elems, 0, 'two project invariants swapping places is no change' or diag @c.raku;
    my $foundation-last = IZ4::Document.parse($head ~ $contact ~ $vis ~ foundation-block());
    ok $foundation-last.ok && $foundation-last.foundation-intact, 'the foundation may come after the project invariants' or diag $foundation-last.errors.join('; ');
    @c = commitment-changes($base, $foundation-last);
    is @c.elems, 0, 'and moving it there is no change' or diag @c.raku;
    is verdict(@c), 'pass', 'so a pure reorder passes';
    my @ids = foundation-ids();
    my $shuffled = IZ4::Document.parse($head ~ $vis
        ~ @ids.reverse.map({ my %f = foundation-entry($_); block($_, %f<text>, %f<because>) }).join ~ $contact);
    ok $shuffled.ok && $shuffled.foundation-intact, 'the five may come in any order, among the others' or diag $shuffled.errors.join('; ');
    is commitment-changes($base, $shuffled).elems, 0, 'and that too is no change';

    # re-wrapping is free; a word is a revision, under the same name
    my $wrapped = block(VIS, "People control whether\n   their profile\nis visible.", "Privacy.");
    is commitment-changes($base, named($wrapped, $contact)).elems, 0, 're-wrapping an invariant changes nothing';
    @c = commitment-changes($base, named(block(VIS, 'Staff control whether a profile is visible.', 'Privacy.'), $contact));
    is kinds(@c), 'revised', 'different words under the same name is one revision';
    is @c[0]<id>, VIS, 'reported under that name';
    ok !(@c[0]<number>:exists), 'and under no number';
    is @c[0]<before>, 'People control whether their profile is visible.', 'with the words before';
    is @c[0]<after>, 'Staff control whether a profile is visible.', 'and after';
    is @c[0]<before_digest>, invariant-digest(VIS, 'People control whether their profile is visible.', 'Privacy.'), 'the digest of the wording before';
    is @c[0]<after_digest>, invariant-digest(VIS, 'Staff control whether a profile is visible.', 'Privacy.'), 'and of the wording after';
    isnt @c[0]<before_digest>, @c[0]<after_digest>, 'which differ';
    is verdict(@c), 'agreement-required', 'a revision needs agreement';
    like proposal-lines(%( changes => @c.List, protections => () )).join("\n"),
        /"INVARIANT {$VIS} revised" \n '  before: People control whether their profile is visible. BECAUSE Privacy.' \n '  after:  Staff control whether a profile is visible. BECAUSE Privacy.'/,
        'a person reads it as a revision of that name';
    @c = commitment-changes($base, named(block(VIS, 'People control whether their profile is visible.', 'It is theirs.'), $contact));
    ok kinds(@c) eq 'revised' && @c[0]<id> eq VIS && @c[0]<before_because> eq 'Privacy.' && @c[0]<after_because> eq 'It is theirs.',
        'a changed BECAUSE is a revision of the same name too';
    # a revision in a file that was also reordered is still found by name
    @c = commitment-changes($base, named($contact, block(VIS, 'Staff control whether a profile is visible.', 'Privacy.')));
    ok kinds(@c) eq 'revised' && @c[0]<id> eq VIS, 'a revision is found by name wherever the block went';

    # the same words under a new name: a withdrawal and a new commitment
    @c = commitment-changes($base, named(block(PRICES, 'People control whether their profile is visible.', 'Privacy.'), $contact));
    is kinds(@c), 'added removed', 'the same words under a new name is an addition and a removal';
    my %added   = @c.first({ .<kind> eq 'added' });
    my %removed = @c.first({ .<kind> eq 'removed' });
    is %added<id>, PRICES, 'the new name is added';
    is %removed<id>, VIS, 'the old name is removed';
    like %added<detail>, /'not a rename'/, 'and the detail says it is not a rename';
    ok %added<detail>.contains(VIS), 'naming the invariant whose words these were';
    is %added<digest>, invariant-digest(PRICES, 'People control whether their profile is visible.', 'Privacy.'), 'the added one has the digest of its name and words';
    isnt %added<digest>, invariant-digest(VIS, 'People control whether their profile is visible.', 'Privacy.'), 'which is not the digest those words had under the old name';
    is verdict(@c), 'agreement-required', 'a person agrees to both';
    my $said = proposal-lines(%( changes => @c.List, protections => () )).join("\n");
    like $said, /"INVARIANT {$PRICES} added: People control whether their profile is visible."/, 'shown as added';
    like $said, /"INVARIANT {$VIS} removed: People control whether their profile is visible."/, 'and as removed';
    like $said, /"the same words as {$VIS}, which this change removes: a new name is a new commitment, not a rename"/, 'with the detail';
    # a genuinely new invariant carries no such detail
    @c = commitment-changes($base, named($vis, $contact, block(PRICES, 'Only the owner changes a price.', 'Trust.')));
    ok kinds(@c) eq 'added' && @c[0]<id> eq PRICES && !@c[0]<detail>, 'a plain addition says nothing about renames';

    # a retired name never comes back, even when the candidate drops the note that retired it
    my $retired = named($vis, "# INVARIANT {$CONTACT} was withdrawn on 2026-01-02; its name is retired.\n");
    is $retired.retired.join(' '), CONTACT, "a file's withdrawal comment retires the name";
    is kinds(commitment-changes($base, $retired)), 'removed', 'withdrawing is a removal';
    my $comes-back = named($vis, block(CONTACT, 'Something else entirely.', 'Reasons.'));
    ok $comes-back.ok, 'a candidate that drops the comment parses on its own';
    @c = commitment-changes($retired, $comes-back);
    is kinds(@c), 'reused-name', 'yet against a base that retired the name it is reused-name';
    is @c[0]<id>, CONTACT, 'under that name';
    is verdict(@c), 'blocked', 'which is blocked, not approvable';
    like proposal-lines(%( changes => @c.List, protections => () )).join("\n"), /"BLOCKED: INVARIANT {$CONTACT} was withdrawn before"/, 'and reads as such';
    @c = commitment-changes($retired, named($vis, block(CONTACT, 'Employers cannot contact someone first.', 'No new inbox.')));
    is kinds(@c), 'reused-name', 'even with the words it had before';

    # the numbered format moving to names
    my $five = block('5', 'People control whether their profile is visible.', 'Privacy.');
    my $six  = block('6', 'Employers cannot contact someone first.', 'No new inbox.');
    my $numbered = legacy($five, $six);
    ok $numbered.ok && $numbered.legacy, 'a numbered base parses, as legacy' or diag $numbered.errors.join('; ');
    is commitment-changes($numbered, legacy($five, $six)).elems, 0, 'a numbered file against itself still changes nothing';
    is correspondence($numbered, $base), %( '5' => VIS, '6' => CONTACT ), 'numbered to named: an invariant is followed by its unchanged words';
    @c = commitment-changes($numbered, $base);
    is kinds(@c), 'foundation-migrated named named', 'the foundation migrates and each invariant whose words are unchanged is named';
    is @c.grep({ .<kind> eq 'named' }).map({ "{.<from>}={.<id>}" }).join(' '), "5={$VIS} 6={$CONTACT}", 'each named change says which number became which name, in the old order';
    is @c[1]<digest>, invariant-digest(VIS, 'People control whether their profile is visible.', 'Privacy.'), 'with the digest under the new name';
    ok @c[0]<before>.contains(FOUNDATION-LEGACY-DIGEST.substr(0, 12)) && @c[0]<after>.contains(FOUNDATION-DIGEST.substr(0, 12)),
        'the foundation change names both foundations by digest';
    is verdict(@c), 'agreement-required', 'the move needs agreement and is not blocked';
    $said = proposal-lines(%( changes => @c.List, protections => () )).join("\n");
    like $said, /'The foundation moves to named invariants, with new words'/, 'a person is told the foundation has new words';
    like $said, /"Invariant 5 is named {$VIS}; its words are unchanged"/, 'and which invariant got which name';
    # reordered while being named: still followed by words
    @c = commitment-changes($numbered, named($contact, $vis));
    is @c.grep({ .<kind> eq 'named' }).map({ "{.<from>}={.<id>}" }).join(' '), "5={$VIS} 6={$CONTACT}", 'the order of the named file does not matter to the move';
    # words changed during the move: not the same invariant
    @c = commitment-changes($numbered, named($vis, block(CONTACT, 'Employers may contact anyone.', 'No new inbox.')));
    is kinds(@c), 'foundation-migrated named added removed', 'an invariant reworded during the move is not named: it is added, and the numbered one removed';
    ok @c.first({ .<kind> eq 'added' })<id> eq CONTACT && @c.first({ .<kind> eq 'removed' })<id> eq '6', 'each under its own identity';

    # and never back
    @c = commitment-changes($base, $numbered);
    is kinds(@c), 'format-regressed', 'a named base with a numbered candidate is format-regressed, and nothing else';
    is verdict(@c), 'blocked', 'which is blocked';
    like proposal-lines(%( changes => @c.List, protections => () )).join("\n"), /'BLOCKED: the candidate goes back to numbered invariants'/, 'and reads as such';

    # ---- the same through the command, with a test that protects the invariant
    my $m = repo;
    my $mp = $m.add('IZ4');
    $mp.spurt($head ~ $old-foundation ~ $five ~ $six);
    $m.add('lib').mkdir; $m.add('tests').mkdir;
    $m.add('lib/profile.txt').spurt("visible: private\n");
    my $t = $m.add('tests/visible.sh');
    $t.spurt("#!/bin/sh\n# Invariant 5: People control whether their profile is visible.\ngrep -q 'visible: private' lib/profile.txt\n");
    g($m, 'add', '-A');
    my ($rc, $out, $err) = gate($m, '--staged', '--enforce');
    is $rc, 2, 'a numbered IZ4 still gates: its first commit needs agreement' or diag $out ~ $err;
    like $out, /'✓ tests/visible.sh (5) passed'/, 'and its test, linked the old way, still runs';
    g($m, 'commit', '-qm', 'numbered');

    # named, and the test relinked by name: the protection follows the invariant
    $mp.spurt($head ~ foundation-block() ~ $vis ~ $contact);
    $t.spurt("#!/bin/sh\n# INVARIANT {$VIS}\ngrep -q 'visible: private' lib/profile.txt\n");
    g($m, 'add', '-A');
    ($rc, $out, $err) = gate($m, '--staged', '--json');
    is json($out, 'outcome'), 'agreement-required', 'numbered to named needs agreement' or diag $out;
    is changes($out, 'foundation-migrated').elems, 1, 'with foundation-migrated';
    is changes($out, 'named').elems, 2, 'and one named change per invariant whose words are unchanged';
    like change($out, 'named', VIS), /'"from":"5"'/, 'saying which number it was';
    like change($out, 'named', CONTACT), /'"from":"6"'/, 'for each';
    is changes($out, 'added').elems + changes($out, 'removed').elems, 0, 'nothing is added or removed by naming';
    is changes($out, 'protection-removed').elems + changes($out, 'protection-unlinked').elems, 0, 'the protection followed the invariant to its name';
    like change($out, 'protection-changed', VIS), /'tests/visible.sh'/, 'the relinked test is noted as changed, under the name';
    like $out, /'"file":"tests/visible.sh"' <-[}]>* "\"invariants\":[\"{$VIS}\"]" | "\"invariants\":[\"{$VIS}\"]" <-[}]>* '"file":"tests/visible.sh"'/, 'and its check ran for the named invariant';
    ($rc, $out, $err) = gate($m, '--staged', '--enforce');
    is $rc, 2, 'exit 2 under --enforce: approvable, not blocked';
    like $out, /"✓ tests/visible.sh ({$VIS}) passed"/, 'the check is shown under the name';
    unlike $out, /'Protection of'/, 'and no protection is reported lost';

    # named, but the test left saying 'Invariant 5': the protection is gone, and said to be
    $t.spurt("#!/bin/sh\n# Invariant 5: People control whether their profile is visible.\ngrep -q 'visible: private' lib/profile.txt\n");
    g($m, 'add', '-A');
    ($rc, $out, $err) = gate($m, '--staged', '--enforce');
    is $rc, 2, 'a test left linked the old way: still agreement-required';
    like $out, /"Protection of {$VIS}: removed - INVARIANT {$VIS} had a test naming it; the candidate has none"/, 'and the lost protection is reported under the new name';
    ($rc, $out, $err) = gate($m, '--staged', '--json');
    like change($out, 'protection-removed', VIS), /'tests/visible.sh'/, 'in the result too';
    $t.spurt("#!/bin/sh\n# INVARIANT {$VIS}\ngrep -q 'visible: private' lib/profile.txt\n");
    g($m, 'add', '-A');
    ($rc, $out, $err) = iz4-talk($m, "a\n", 'approve', '--staged');
    is $rc, 0, 'a person can agree to the move' or diag $out ~ $err;
    like $out, /"Invariant 5 is named {$VIS}; its words are unchanged"/, 'having been shown what it names';
    g($m, 'commit', '-qm', 'named');

    # a pure reorder: the project's own first, the foundation after
    $mp.spurt($head ~ $contact ~ $vis ~ foundation-block());
    g($m, 'add', 'IZ4');
    ($rc, $out, $err) = gate($m, '--staged', '--enforce');
    is $rc, 0, 'moving blocks about passes under --enforce' or diag $out;
    like $out, /'commitments and protections: unchanged'/, 'nothing committed to changed';
    ($rc, $out, $err) = gate($m, '--staged', '--json');
    is json($out, 'outcome'), 'pass', 'and in JSON';
    like $out, /'"changes":[]'/, 'with no changes at all';
    g($m, 'commit', '-qm', 'reordered');

    # the same words under a new name
    $mp.spurt($head ~ $contact ~ block(PRICES, 'People control whether their profile is visible.', 'Privacy.') ~ foundation-block());
    g($m, 'add', 'IZ4');
    ($rc, $out, $err) = gate($m, '--staged', '--json');
    is json($out, 'outcome'), 'agreement-required', 'a new name for the same words needs agreement';
    like change($out, 'added', PRICES), /'not a rename'/, 'added, with the detail';
    ok change($out, 'removed', VIS), 'and the old name removed';
    is changes($out, 'named').elems + changes($out, 'revised').elems, 0, 'it is neither a naming nor a revision';
    g($m, 'reset', '-q', 'IZ4'); g($m, 'checkout', '--', 'IZ4');

    # back to numbers
    $mp.spurt($head ~ $old-foundation ~ $five ~ $six);
    g($m, 'add', 'IZ4');
    ($rc, $out, $err) = gate($m, '--staged', '--enforce');
    is $rc, 3, 'going back to numbered invariants is blocked';
    like $out, /'BLOCKED: the candidate goes back to numbered invariants; the base names them'/, 'and says why';
    like $out, /"keep the named IZ4"/, 'with the next step';
    ($rc, $out, $err) = gate($m, '--staged', '--json');
    is changes($out, 'format-regressed').elems, 1, 'as format-regressed';
    ($rc, $out, $err) = iz4-talk($m, "a\n", 'approve', '--staged');
    is $rc, 3, 'which no approval can lift';
}

# ---- no IZ4 anywhere: nothing to gate --------------------------------------
my $plain = repo;
$plain.add('README.md').spurt("x\n");
g($plain, 'add', '-A');
($rc, $out, $err) = gate($plain, '--staged', '--json');
is $rc, 1, 'a repository without an IZ4 is told so (the gate needs one to find the root)';

done-testing;
