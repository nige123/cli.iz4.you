# 321.do, an agent launcher, under iz4: when it is installed, agent
# prompts go through it as read-only runs, hooks are wired by it for every
# harness it knows, and status quotes what it enforces; when it is not,
# iz4 falls back to its own command and its own Claude Code wiring.  321
# is a stand-in script here: iz4 only runs it and reads its answers.
use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;
use IZ4::Launcher;
use IZ4::Register;

#| A stand-in 321 that records what it was asked and answers from files
#| beside it: REPLY for a prompt run, DRIVER for iz4 install|status --json.
sub stub-launcher(IO::Path :$dir = temp-dir() --> IO::Path) {
    my $bin = $dir.add('321');
    $bin.spurt(q:to/SH/);
        #!/bin/sh
        here=$(dirname "$0")
        printf '%s\n' "$*" >> "$here/calls"
        case "$*" in
          version) echo "321 ${STUB_321_VERSION:-0.4.0}"; exit 0 ;;
          "packages builtin prompt") mkdir -p "$here/pkg"; echo "$here/pkg"; exit 0 ;;
          *"prompt -"*) cat > "$here/prompt.txt"; cat "$here/REPLY"; exit 0 ;;
          "iz4 install"*|"iz4 status"*|"iz4 remove"*) cat "$here/DRIVER"; exit 0 ;;
          "doctor --json") echo '{"schema":"doctor.v1","adapters":[{"name":"claude_code","available":true,"enforces":{"tool_allowlist":true},"hooks":{"pre-edit":"refuses","stop":"refuses","session-start":"advises"}}]}'; exit 0 ;;
          *) echo "stub: unknown $*" >&2; exit 64 ;;
        esac
        SH
    $bin.chmod(0o755);
    $dir.add('DRIVER').spurt('{"schema":"enforcement-report.v1","controller":"iz4","harnesses":[{"harness":"claude_code","detected":true,"action":"installed","headline":"GUARDED","levels":["aware","checked","guarded"],"warnings":["Network interception is not available in claude_code: this harness cannot intercept it."]}]}' ~ "\n");
    $bin;
}

sub receipt-line(Str $status, Str :$summary = '', Str :$blocked = '' --> Str) {
    json-encode(%( schema => 'run-receipt.v1', status => $status, summary => $summary, blockedOn => $blocked,
        denied => %( reason => 'the work package is invalid', details => ['objective: is required'] ), evidence => %( errors => ['boom'] ) )) ~ "\n";
}

# ---- with 321 installed --------------------------------------------------------
{
    my $bin = stub-launcher();
    temp %*ENV<IZ4_321> = $bin.Str;
    temp %*ENV<IZ4_AGENT_CMD>; %*ENV<IZ4_AGENT_CMD>:delete;
    is launcher-binary(), $bin.Str, 'IZ4_321 names the launcher';
    is launcher-version($bin.Str), '0.4.0', 'and its version is read';
    is driver-binary(), $bin.Str, 'a 321 this new is an environment driver';
    ok agent-label().contains('321, an agent launcher'), 'the label says prompts go through 321';

    $bin.parent.add('REPLY').spurt(receipt-line('completed', :summary("The answer.\nSecond line.")));
    my $root = temp-dir();
    is ask-agent("What is this?\nTwo lines.", :$root), "The answer.\nSecond line.", 'a prompt through 321 comes back as the receipt summary';
    is $bin.parent.add('prompt.txt').slurp, "What is this?\nTwo lines.", 'the prompt went to 321 on stdin, verbatim';
    my @calls = $bin.parent.add('calls').slurp.lines;
    ok @calls.grep(*.contains("--package-dir {$bin.parent.add('pkg')} --workspace {$root} --non-interactive --json prompt -")), 'as a read-only run of the prompt package in the workspace' or diag @calls.join("\n");

    $bin.parent.add('REPLY').spurt(receipt-line('blocked', :blocked('which file?')));
    throws-like { ask-agent('x', :$root) }, Exception, message => /'stopped to ask: which file?'/, 'a blocked run says what it asked';
    $bin.parent.add('REPLY').spurt(receipt-line('denied'));
    throws-like { ask-agent('x', :$root) }, Exception, message => /'refused the run' .* 'invalid'/, 'a denial says why';
    $bin.parent.add('REPLY').spurt(receipt-line('failed'));
    throws-like { ask-agent('x', :$root) }, Exception, message => /'failed' .* 'boom'/, 'a failure carries its errors';
    $bin.parent.add('REPLY').spurt("not json\n");
    throws-like { ask-agent('x', :$root) }, Exception, message => /'no receipt'/, 'no receipt is an error';

    # an explicit command still wins
    my $reply = temp-dir().add('reply.txt'); $reply.spurt("from the command\n");
    is ask-agent('x', :$root, :cmd("cat {$reply}")), "from the command\n", 'an explicit :cmd bypasses 321';
    temp %*ENV<IZ4_AGENT_CMD> = "cat {$reply}";
    is ask-agent('x', :$root), "from the command\n", 'and so does IZ4_AGENT_CMD';
    is agent-label(), "cat {$reply}", 'which the label shows';
}

# suggest goes through 321 and its candidates are parsed as before
{
    my $bin = stub-launcher();
    temp %*ENV<IZ4_321> = $bin.Str;
    temp %*ENV<IZ4_AGENT_CMD>; %*ENV<IZ4_AGENT_CMD>:delete;
    my $dir = temp-dir();
    minimal-iz4(:$dir);
    $bin.parent.add('REPLY').spurt(receipt-line('completed', :summary("STRONG | Private profiles never appear in public search. | BECAUSE: a hidden search can cost a job | EVIDENCE: a test\n")));
    my %s = agent-suggest($dir);
    is %s<strong>.elems, 1, 'one strong candidate came through 321' or diag %s.raku;
    ok %s<strong>[0]<text>.contains('Private profiles'), 'the candidate text';
}

# iz4 hands the harness to the driver, via the CLI
{
    my $bin = stub-launcher();
    my $dir = temp-dir();
    minimal-iz4(:$dir);
    my %env = IZ4_321 => $bin.Str;
    my $calls = $bin.parent.add('calls');
    my ($rc, $out, $err) = iz4($dir, 'agent', 'install', '--hooks', '--strict', :env(%env));
    is $rc, 0, 'agent install --hooks --strict exits 0' or diag $err;
    ok $out.contains('hooks via 321 0.4.0') && $out.contains('claude_code: installed; enforcement GUARDED (aware, checked, guarded)'), 'the driver wires the harness and iz4 quotes what is enforced' or diag $out;
    ok $out.contains('Network interception is not available'), 'with the driver\'s warnings';
    ok $calls.slurp.lines.grep(*.contains("iz4 install --workspace {$dir.resolve} --json")), 'the driver was asked to install, in full' or diag $calls.slurp;
    ok !$calls.slurp.lines.grep(*.contains('--advisory')), 'not the advisory set';
    ok !$dir.add('.claude').e, 'iz4 wrote no harness configuration of its own';

    $calls.spurt('');
    ($rc, $out, $err) = iz4($dir, 'agent', 'install', '--hooks', :env(%env));
    ok $calls.slurp.lines.grep(*.contains("iz4 install --workspace {$dir.resolve} --advisory --json")), 'without --strict the driver is asked for the advisory set' or diag $calls.slurp;

    ($rc, $out, $err) = iz4($dir, 'agent', 'status', :env(%env));
    is $rc, 0, 'agent status exits 0' or diag $err;
    ok $out.contains('321 0.4.0, an agent launcher, is installed') && $out.contains('claude_code:') && $out.contains('enforcement GUARDED'), 'status quotes the driver' or diag $out;
    ($rc, $out, $err) = iz4($dir, 'agent', 'status', '--json', :env(%env));
    my $j = Rakudo::Internals::JSON.from-json($out);
    is $j<launcher><version>, '0.4.0', 'the JSON carries the launcher';
    is $j<hooks>, 'guarded', 'the strongest protection the driver reports';
    is $j<enforcement><schema>, 'enforcement-report.v1', 'and the driver\'s own document, verbatim';

    # by default: the advisory set where a harness is here with nothing wired, and never a downgrade
    $bin.parent.add('DRIVER').spurt('{"schema":"enforcement-report.v1","harnesses":[{"harness":"claude_code","detected":true,"headline":"NONE","levels":[],"warnings":[]}]}' ~ "\n");
    $calls.spurt('');
    ($rc, $out, $err) = iz4($dir, 'agent', 'install', :env(%env));
    like $out, /'hooks: installing the advisory set by default'/, 'a default install says it is adding the advisory hooks';
    ok $calls.slurp.lines.grep(*.contains('iz4 install') && *.contains('--advisory')), 'and asks the driver for them';
    $calls.spurt('');
    ($rc, $out, $err) = iz4($dir, 'agent', 'install', '--/hooks', :env(%env));
    ok !$calls.slurp.lines.grep(*.starts-with('iz4 install')), '--/hooks leaves the harness alone';
    $bin.parent.add('DRIVER').spurt('{"schema":"enforcement-report.v1","harnesses":[{"harness":"claude_code","detected":true,"headline":"GUARDED","levels":["aware","checked","guarded"],"warnings":[]}]}' ~ "\n");
    $calls.spurt('');
    ($rc, $out, $err) = iz4($dir, 'agent', 'install', :env(%env));
    ok !$calls.slurp.lines.grep(*.starts-with('iz4 install')), 'a later default install never downgrades what is wired';
    unlike $out, /'installing the advisory set'/, 'and says nothing about installing any';
    $bin.parent.add('DRIVER').spurt('{"schema":"enforcement-report.v1","harnesses":[{"harness":"claude_code","detected":false,"headline":"NONE","levels":[],"warnings":[]}]}' ~ "\n");
    $calls.spurt('');
    ($rc, $out, $err) = iz4($dir, 'agent', 'install', :env(%env));
    ok !$calls.slurp.lines.grep(*.starts-with('iz4 install')), 'where the driver finds no harness, a default install wires nothing';

    # a failed wiring is a failed install
    $bin.parent.add('DRIVER').spurt('{"schema":"enforcement-report.v1","harnesses":[{"harness":"claude_code","detected":true,"action":"failed","error":"settings.json is not a JSON object","headline":"NONE","levels":[],"warnings":[]}]}' ~ "\n");
    ($rc, $out, $err) = iz4($dir, 'agent', 'install', '--hooks', :env(%env));
    ok $rc == 1 && $out.contains('! settings.json is not a JSON object'), 'when the driver cannot wire the harness, iz4 says so and fails' or diag "$rc $out";

    # a 321 too old to drive a harness is not treated as a driver
    ($rc, $out, $err) = iz4($dir, 'agent', 'install', '--hooks', :env(%( |%env, STUB_321_VERSION => '0.3.4' )));
    ok $rc == 1 && $out.contains('iz4 does not install itself') && $out.contains('the 321 here is 0.3.4'), 'an older 321 is named, and nothing is wired' or diag "$rc $out";
    ($rc, $out, $err) = iz4($dir, 'agent', 'status', :env(%( |%env, STUB_321_VERSION => '0.3.4' )));
    like $out, /'321 0.3.4 is installed, but wiring a harness needs 0.4.0 or later'/, 'and status says what it would take';
}

# ---- without 321 -----------------------------------------------------------------
{
    my $dir = temp-dir();
    minimal-iz4(:$dir);
    my %env = IZ4_321 => temp-dir().add('missing').Str, PATH => temp-dir().Str ~ ':' ~ %*ENV<PATH>.split(':').grep({ !.IO.add('321').e }).join(':');
    my ($rc, $out, $err) = iz4($dir, 'agent', 'install', '--hooks', :env(%env));
    is $rc, 1, 'without 321, agent install --hooks fails: nothing here knows a harness' or diag $err;
    ok $out.contains('iz4 does not install itself into agent environments') && !$dir.add('.claude').e, 'iz4 says so and writes no wiring of its own';
    ($rc, $out, $err) = iz4($dir, 'agent', 'status', :env(%env));
    ok $out.contains('321, an agent launcher, is not installed'), 'and status says 321 is not there' or diag $out;
    temp %*ENV<IZ4_321> = temp-dir().add('missing').Str;
    temp %*ENV<PATH> = temp-dir().Str;
    temp %*ENV<IZ4_AGENT_CMD>; %*ENV<IZ4_AGENT_CMD>:delete;
    ok !launcher-binary().defined, 'no launcher';
    is agent-label(), 'claude -p', 'the default command stands';
}
{
    # IZ4_NO_321=1 hides an installed 321
    my $bin = stub-launcher();
    temp %*ENV<IZ4_321> = $bin.Str;
    temp %*ENV<IZ4_NO_321> = '1';
    ok !launcher-binary().defined, 'IZ4_NO_321=1 makes iz4 act as if 321 were not installed';
}

# ---- the release file for this machine --------------------------------------
ok launcher-asset().defined && launcher-asset().starts-with('321-'), 'a 321 file is published for this machine';
my $bd = temp-dir();
ok !launcher-marker($bd).e, 'no marker means iz4 did not install 321 here';
{
    # a source install: the marker sits beside the launcher script on PATH, not beside bin/iz4
    my $d = temp-dir();
    $d.add('iz4').spurt("#!/bin/sh\nexit 0\n"); $d.add('iz4').chmod(0o755);
    temp %*ENV<PATH> = $d.Str;
    ok !launcher-owner-dir().defined, 'no marker anywhere: 321 is not ours';
    launcher-marker($d).spurt("installed by iz4\n");
    is launcher-owner-dir().Str, $d.Str, 'the marker beside the iz4 on PATH names the owner directory';
}
{
    # a 321 that is on PATH but not ours is never replaced
    my $bin = stub-launcher();
    temp %*ENV<IZ4_321> = $bin.Str;
    my %l = launcher-install(:bin-dir($bd));
    is %l<state>, 'skipped', 'an existing 321 is left as is';
    ok %l<note>.contains('not by iz4'), 'and the note says why';
}

done-testing;
