# Invariant 5: The format and the core CLI work without the iz4.you service,
# an account or a network connection: the file belongs to the project.
# BECAUSE Intent a project cannot hold on its own terms is intent it can
# lose when a service, a company or a connection goes away.
use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;

# The core commands run in a directory with no register connection, no
# token, no agent, and a PATH that holds no network tool at all.
my $dir  = temp-dir;
my $bin  = temp-dir;
for <sh git sha256sum shasum openssl> -> $tool {
    my $real = (%*ENV<PATH>.split(':').map({ $_.IO.add($tool) }).first(*.x)) // next;
    run 'ln', '-s', $real.Str, $bin.add($tool).Str;
}
my %env = %*ENV;
%env<PATH> = "{$bin}:{$*EXECUTABLE.IO.parent}";
%env<IZ4_AGENT_CMD> = 'false';
%env<IZ4_REGISTER_TOKEN>:delete;
my $root = $?FILE.IO.resolve.parent(2);
sub offline(*@args) {
    my $p = run $*EXECUTABLE, '-I', $root.add('lib').Str, $root.add('bin/iz4').Str, |@args, :cwd($dir.Str), :out, :err, :env(%env);
    my $out = $p.out.slurp(:close); my $err = $p.err.slurp(:close);
    (try $p.exitcode) // 1, $out, $err;
}
nok $bin.add('curl').e, 'curl is not on the PATH these commands get';
is offline('init', '--for-what=Offline.', '--for-who=Anyone.', '--/agents')[0], 0, 'init works with no network tool';
is offline('add', 'invariant', 'The file is the source.', '--because=Nothing else is.')[0], 0, 'add works';
is offline('check')[0], 0, 'check works';
like offline('invariants')[1], /'INVARIANT 0 - HUMANS FIRST (inherited)' .* 'INVARIANT 5'/, 'the inherited foundation is available with no account';
is offline('agent')[0], 0, 'the agent packet works';
is offline('number')[0], 0, 'number works';
ok $dir.add('IZ4').slurp.contains('The file is the source.'), 'and the file, plain text, holds it all';

# Nothing in the core modules reaches the network; only the explicit
# opt-ins do (register, report, update, and the agent behind suggest and
# review), and each is named as such in the README.
for <Document Grammar Coach Evidence Hook Agent> -> $m {
    my $src = $root.add("lib/IZ4/$m.rakumod").slurp;
    unlike $src, /'curl' | 'http://' | 'https://iz4.you/api' | 'IO::Socket'/, "IZ4::$m makes no network call";
}
like $root.add('README.md').slurp, /'Offline by default'/, 'the README says so';

done-testing;
