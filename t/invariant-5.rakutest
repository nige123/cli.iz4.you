# INVARIANT works-offline.cli.iz4.you
# The format and the core CLI work without the iz4.you service,
# an account or a network connection: the file belongs to the project.
# BECAUSE Intent a project cannot hold on its own terms is intent it can
# lose when a service, a company or a connection goes away.
use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;

# The core commands run in a directory with no register connection, no
# token, no agent, and a PATH that holds no network tool at all.
my $dir  = temp-dir;
my $bin  = temp-dir;
for <sh git sha256sum shasum openssl> -> $tool {
    my $real = (%*ENV<PATH>.split(':').map({ $_.IO.add($tool) }).first(*.x)) // next;
    run 'ln', '-s', $real.Str, $bin.add($tool).Str;
}
my %env = %*ENV;
%env<PATH> = "{$bin}:{$*EXECUTABLE.IO.parent}";
%env<IZ4_AGENT_CMD> = 'false';
%env<IZ4_REGISTER_TOKEN>:delete;
# The step that follows a change of intent (fetch the environment driver
# if it is missing, switch enforcement on) is left ON here, with no driver
# anywhere and nowhere to get one: the core has to work regardless.
%env<IZ4_ENFORCE> = '1';
%env<IZ4_NO_321>:delete;
%env<IZ4_321>:delete;
%env<IZ4_BIN> = temp-dir.Str;
%env<HOME> = temp-dir.Str;
my $root = $?FILE.IO.resolve.parent(2);
sub offline(*@args) {
    my $p = run $*EXECUTABLE, '-I', $root.add('lib').Str, $root.add('bin/iz4').Str, |@args, :cwd($dir.Str), :out, :err, :env(%env);
    my $out = $p.out.slurp(:close); my $err = $p.err.slurp(:close);
    (try $p.exitcode) // 1, $out, $err;
}
nok $bin.add('curl').e, 'curl is not on the PATH these commands get';
is offline('init', '--for-what=Offline.', '--for-who=Anyone.', '--/agents')[0], 0, 'init works with no network tool';
my ($arc, $aout, $aerr) = offline('add', 'invariant', 'The file is the source.', '--name=file-is-source', '--namespace=offline.example.com', '--because=Nothing else is.');
is $arc, 0, 'add works';
like $aerr, /'so agent enforcement could not be activated.' \n 'The IZ4 intent is recorded, but harness enforcement is currently inactive.'/,
    'with no connection the driver cannot be fetched, and iz4 says enforcement is inactive: the change stands all the same';
nok %env<IZ4_BIN>.IO.add('321').e, 'and nothing was installed';
is offline('check')[0], 0, 'check works';
like offline('invariants')[1], /'INVARIANT humans-first.iz4.you' .* 'INVARIANT file-is-source.offline.example.com'/, 'the foundation is available with no account, and names need no registry';
is offline('agent')[0], 0, 'the agent packet works';
is offline('show', 'invariant', 'file-is-source')[0], 0, 'an invariant is looked up by its name';
is offline('discover', '--json')[0], 0, 'and the machine interface answers';
ok $dir.add('IZ4').slurp.contains('The file is the source.'), 'and the file, plain text, holds it all';

# Nothing in the core modules reaches the network.  What does is named in
# the README: the register commands, update, an agent behind suggest and
# review, and fetching the environment driver once after a change of
# intent, which the core does not depend on (above).
for <Document Grammar Coach Evidence Agent Git Gate Machine Review LegacyHook Integrations> -> $m {
    my $src = $root.add("lib/IZ4/$m.rakumod").slurp;
    unlike $src, /'curl' | 'http://' | 'https://iz4.you/api' | 'IO::Socket'/, "IZ4::$m makes no network call";
}
like $root.add('README.md').slurp, /'The core needs no network, ever'/, 'the README says so';
like $root.add('README.md').slurp, /'Offline, the change still' \s+ 'stands and iz4 says enforcement is inactive'/, 'and says what happens to the one automatic fetch when there is no connection';

done-testing;
