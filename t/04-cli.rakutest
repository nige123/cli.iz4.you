use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;

plan 38;

# Never let a test reach a real agent.
%*ENV<IZ4_AGENT_CMD> = 'false';

my $dir = temp-dir;

my ($rc, $out, $err) = iz4($dir, 'check');
is $rc, 1, 'check without IZ4 exits 1';
is $err, "No IZ4 found in this directory or its parents.\nRun 'iz4 init' to create one.\n", 'actionable message';

($rc, $out, $err) = iz4($dir, 'init', '--/agent');
is ($rc, $out), (0, "Created IZ4\nAGENTS.md: installed\n"), 'init output';
($rc, $out, $err) = iz4($dir, 'init', '--/agent');
is $rc, 1, 'second init fails';
like $err, /'already exists'/, 'second init explains';

($rc, $out, $err) = iz4($dir, 'check');
is $rc, 1, 'placeholder gist fails check';
like $out, /^ 'IZ4:' \d+ ': gist is still the placeholder' /, 'check reports line';

($rc, $out, $err) = iz4($dir, 'add', 'gist', 'A CLI test.');
is $out, "Set gist.\n", 'add gist output';
($rc, $out, $err) = iz4($dir, 'add', 'invariant', 'Always.');
is $out, "Added invariant.\n", 'add invariant output';
($rc, $out, $err) = iz4($dir, 'show', 'invariant', '1');
is ($rc, $out), (0, "Invariant 1: Always.\n"), 'show invariant N resolves the reference';
($rc, $out, $err) = iz4($dir, 'check');
ok $rc == 0 && $out.contains('Invariant 0:') && $out.ends-with("OK IZ4\n"),
    'check passes and reports the invariant-zero binding';
like $out, /'✓ structure: valid' \n '✓ Invariant 0: repeated locally' .* \n '✓ invariants: all 2 numbered' \n '✓ AGENTS.md: integration installed (current)' \n/,
    'check is a checklist with ticks for what is true';

# a root IZ4 in a repository with no agent entry points: crosses, each with its remedy
my $bare = temp-dir;
$bare.add('IZ4').spurt("IZ4\n\ngist:\n    Bare.\n\ninvariants:\n    - Nothing is set up.\n");
($rc, $out, $err) = iz4($bare, 'check');
is $rc, 0, 'crosses never change the exit code';
like $out, /'✗ Invariant 0: not repeated locally, still binding' .* "'iz4 agent'" .* 'first invariant' \n
            '✗ invariants: 1 of 1 unnumbered - run' .* "'iz4 number'" \n
            "✗ AGENTS.md: no file - run 'iz4 agent install'" \n/, 'each cross says how to remedy it';
unlike $out, /'CLAUDE.md' | 'SKILL.md'/, 'CLAUDE.md and the skill are not expected without signs of Claude use';
ok $out.ends-with("OK IZ4 (3 to remedy above)\n"), 'the summary counts what is left to remedy';
($rc, $out, $err) = iz4($bare, 'agent', 'install');
($rc, $out, $err) = iz4($bare, 'number');
($rc, $out, $err) = iz4($bare, 'check');
like $out, /'✓ invariants: all 1 numbered' \n '✓ AGENTS.md: integration installed (current)' \n/, 'remedies turn crosses into ticks';
ok $out.ends-with("OK IZ4 (1 to remedy above)\n"), 'only the missing Invariant 0 text is left';

# explicit .iz4 file from a nested directory
my $nested = $dir.add('docs');
$nested.mkdir;
$nested.add('security.iz4').spurt("IZ4 0.0\n\ngist:\n    Security intent.\n\ninvariants:\n    - Secrets never logged.\n");
($rc, $out, $err) = iz4($nested, 'check', 'security.iz4');
is $rc, 0, 'explicit .iz4 checked and passes';
like $out, /'not repeated locally, still binding' .* 'OK security.iz4'/,
    'omitted invariant zero is reported as inherited, and the file passes';
unlike $out, /'AGENTS.md'/, 'agent entry points are only checked for a root IZ4';
($rc, $out, $err) = iz4($nested, 'show', 'security.iz4', 'invariants');
is $out, "- Secrets never logged.\n", 'show section of explicit .iz4';
($rc, $out, $err) = iz4($nested, 'check', 'security.iz4');
like $out, /'security.iz4:7: warning: unnumbered invariant'/, 'check warns about an unnumbered invariant';
($rc, $out, $err) = iz4($nested, 'add', 'invariant', 'Second.', '--file=security.iz4');
is ($rc, $out), (0, "Added invariant.\n"), 'add still adds beside unnumbered invariants';
like $err, /^ 'note: 1 other invariant is unnumbered in security.iz4' .* "'iz4 number'"/, 'add points out the unnumbered neighbour';
($rc, $out, $err) = iz4($nested, 'number', 'security.iz4');
is ($rc, $out), (0, "Numbered 1 invariant in security.iz4 (Invariant 2)\n"), 'number reports what it wrote';
($rc, $out, $err) = iz4($nested, 'number', 'security.iz4');
is ($rc, $out), (0, "security.iz4: every invariant is already numbered\n"), 'number is a no-op the second time';
($rc, $out, $err) = iz4($nested, 'show', 'invariant', '2', '--file=security.iz4');
is $out, "Invariant 2: Secrets never logged.\n", 'the numbered invariant resolves';

# agent-assisted init: a good draft lands, validated
my $drafted = temp-dir;
my $reply = $drafted.add('reply.txt');
$reply.spurt(qq:to/END/);
    Here is the completed file:
    ```
    IZ4 0.0

    gist:
        A fake project, distilled by a fake agent.

    behaviours:
        - Someone can do the thing.

    invariants:
        - The thing never breaks.
        - The other thing holds.
    ```
    END
%*ENV<IZ4_AGENT_CMD> = "cat {$reply}";
($rc, $out, $err) = iz4($drafted, 'init');
is ($rc, $out), (0, "Created IZ4 (3 invariants, agent-drafted)\nAGENTS.md: installed\n"),
    'agent init reports the draft (its invariants plus invariant zero)';
like $err, /'review it'/, 'agent init asks for review';
($rc, $out, $err) = iz4($drafted, 'check');
ok $rc == 0 && $out.contains('Invariant 0:') && $out.ends-with("OK IZ4\n"),
    'agent-drafted IZ4 passes check and reports the binding';

# a dead agent command falls back to the scaffold, loudly
my $fallback = temp-dir;
%*ENV<IZ4_AGENT_CMD> = 'false';
($rc, $out, $err) = iz4($fallback, 'init');
is ($rc, $out), (0, "Created IZ4\nAGENTS.md: installed\n"), 'fallback still creates the scaffold';
like $err, /'attempt 1 failed' .* 'attempt 2 failed' .* 'falling back to the plain scaffold'/,
    'fallback is loud after two attempts';
like $fallback.add('IZ4').slurp, /'<What is this thing supposed to do?>'/, 'fallback wrote the scaffold';

# a nonsense reply fails validation and also falls back
my $nonsense = temp-dir;
%*ENV<IZ4_AGENT_CMD> = 'echo not a spec';
($rc, $out, $err) = iz4($nonsense, 'init');
is ($rc, $out), (0, "Created IZ4\nAGENTS.md: installed\n"), 'nonsense reply falls back to the scaffold';
like $err, /"no 'IZ4' header"/, 'the validation failure is reported';

# --/agent never runs the agent
my $manual = temp-dir;
%*ENV<IZ4_AGENT_CMD> = 'echo SHOULD-NOT-RUN';
($rc, $out, $err) = iz4($manual, 'init', '--/agent');
is ($rc, $out), (0, "Created IZ4\nAGENTS.md: installed\n"), '--/agent writes the scaffold';
unlike $err, /'asking agent'/, '--/agent does not consult the agent';
