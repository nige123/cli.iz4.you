use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;

# Never let a test reach a real agent.
%*ENV<IZ4_AGENT_CMD> = 'false';
%*ENV<IZ4_INTERACTIVE>:delete;

my $dir = temp-dir;
my ($rc, $out, $err) = iz4($dir, 'check');
is $rc, 1, 'check without IZ4 exits 1';
is $err, "No IZ4 found in this directory or its parents.\nRun 'iz4 init' to create one.\n", 'actionable message';

# ---- init is coached: two questions, then an offer --------------------------
($rc, $out, $err) = iz4-talk($dir, "Helping people find work they love to do.\nPeople looking for work.\nn\n", 'init');
is $rc, 0, 'coached init exits 0';
like $out, /'What is this software for?' .* 'Who is it for?' .* 'Created IZ4.'/, 'init asks what and who';
like $out, /'inherits invariants 0-4' .* 'begin at 5'/, 'init teaches inheritance';
like $out, /'Add an invariant now? [Y/n]'/, 'and offers to add one';
unlike $out, /:i 'behaviour' | 'requirement' | 'constraint'/, 'without asking for a specification';
my $iz4 = $dir.add('IZ4').slurp;
like $iz4, /'IS FOR WHAT' \n 'Helping people find work they love to do.' \n\n 'IS FOR WHO' \n 'People looking for work.'/,
    'the two answers are the file';
nok $iz4.contains('INVARIANT'), 'declining the offer leaves a valid two-question IZ4';
($rc, $out, $err) = iz4($dir, 'init', '--for-what=x', '--for-who=y');
is $rc, 1, 'second init fails';
like $err, /'already exists'/, 'and explains';

# init straight into a first invariant
my $first = temp-dir;
($rc, $out, $err) = iz4-talk($first,
    "Sign-in codes.\nPeople signing in.\ny\nA code works once and only once.\ny\nA code that works twice lets someone else sign in as you.\ny\n",
    'init', '--/agents');
like $out, /'Added INVARIANT 5'/, 'init can go straight on to a coached first invariant';

# scripts and CI are never asked anything
my $script = temp-dir;
($rc, $out, $err) = iz4($script, 'init');
is $rc, 1, 'non-interactive init without answers does not guess';
like $err, /'--for-what' .* '--for-who'/, 'and says how to answer from a script';
nok $script.add('IZ4').e, 'and writes nothing';
($rc, $out, $err) = iz4($script, 'init', '--for-what=A CI smoke test.', '--for-who=Maintainers.');
is $rc, 0, 'init from a script with both answers';
unlike $out, /'[Y/n]'/, 'asks nothing';
($rc, $out, $err) = iz4($script, 'add');
is $rc, 1, 'coached add needs a person';
like $err, /'iz4 add invariant'/, 'and shows the fast path instead';

# ---- check: ticks, crosses with remedies, and honest uncertainty -----------------
($rc, $out, $err) = iz4($dir, 'add', 'invariant', 'Private profiles never appear in public search.',
    '--because=A hidden search for work can cost someone their current job.');
is ($rc, $out), (0, "Added INVARIANT 5.\n"), 'fast path add';
($rc, $out, $err) = iz4($dir, 'check');
is $rc, 0, 'check passes';
like $out, /'✓ structure: valid' \n
            '✓ IS FOR WHAT: Helping people find work they love to do.' \n
            '✓ IS FOR WHO: People looking for work.' \n
            '✓ Invariants 0-4: inherited' .* \n
            '✓ invariants: 1 of your own, numbered from 5' \n
            '✓ BECAUSE: every invariant says why it must survive' \n/, 'ticks for what is true';
like $out, /'? the software keeps Invariants 0-5: uncertain'/, 'conformance is uncertain, never a tick';
unlike $out, /'✓' <-[\n]>* 'keeps Invariants'/, 'no green tick for something a checker cannot know';
ok $out.ends-with("OK IZ4\n"), 'and the summary has nothing to remedy';

($rc, $out, $err) = iz4($dir, 'add', 'invariant', 'Employers cannot contact someone first.');
($rc, $out, $err) = iz4($dir, 'check');
like $out, /'✗ BECAUSE: missing for Invariant 6 - write under each why it must survive'/, 'a missing BECAUSE is a cross with a remedy';
ok $out.ends-with("OK IZ4 (1 to remedy above)\n"), 'crosses are counted, and never fail the check';

# ---- because: check points at a folded reason, and the command moves it ---------
($rc, $out, $err) = iz4($dir, 'add', 'invariant', 'No price is sent unexplained. A confidently wrong price sells work at a loss.', '--force');
($rc, $out, $err) = iz4($dir, 'check');
like $out, /'✗ BECAUSE: Invariant 7 carries the reason inside the invariant' .* "'iz4 because --split'"/,
    'check says when the reason is folded into the invariant';
like $out, /'✗ BECAUSE: missing for Invariant 6'/, 'and separately which have none';
($rc, $out, $err) = iz4($dir, 'because', '--split');
like $out, /'Invariant 7: moved under BECAUSE - A confidently wrong price sells work at a loss.'/, 'because --split moves it';
($rc, $out, $err) = iz4($dir, 'because', '6', 'Employers cannot contact first.');
is $rc, 1, 'a circular reason is challenged';
($rc, $out, $err) = iz4($dir, 'because', '6', 'Job seekers should not acquire another unsolicited inbox.');
is ($rc, $out), (0, "Set BECAUSE for Invariant 6.\n"), 'because N WHY sets a reason';
($rc, $out, $err) = iz4($dir, 'check');
like $out, /'✓ BECAUSE: every invariant says why it must survive'/, 'and the checklist is clean';
($rc, $out, $err) = iz4($dir, 'because', '2', 'Mine.');
ok $rc == 1 && $err.contains('inherited'), 'the foundation reasons are canonical';

# ---- the effective invariant set -------------------------------------------------
($rc, $out, $err) = iz4($dir, 'invariants');
is $rc, 0, 'iz4 invariants exits 0';
like $out, /'INVARIANT 0 - HUMANS FIRST (inherited)' .* 'INVARIANT 4 - THE FOUNDATION HOLDS (inherited)' .* 'INVARIANT 5' \n 'Private profiles'/,
    'it shows the inherited 0-4 and the project invariants together';
($rc, $out, $err) = iz4($dir, 'show', 'invariant', '2');
like $out, /'HUMAN AGENCY'/, 'show invariant 2 is the inherited foundation';
($rc, $out, $err) = iz4($dir, 'show', 'invariant', '5');
like $out, /^ 'INVARIANT 5' \n .* 'BECAUSE'/, 'show invariant 5 is the project invariant with its reason';
($rc, $out, $err) = iz4($dir, 'show', 'for-who');
is $out, "People looking for work.\n", 'show for-who';

# ---- old kinds are redirected, not stored -------------------------------------
for <behaviour constraint decision> -> $kind {
    ($rc, $out, $err) = iz4($dir, 'add', $kind, 'Something.');
    ok $rc == 1 && $err.contains('IZ4 does not record'), "add $kind says where that belongs instead";
}
($rc, $out, $err) = iz4($dir, 'add', 'invariant', 'Sneaky.', '--number=3', '--force');
ok $rc == 1 && $err.contains('reserved'), 'not even --force can take a number in 0-4';

# ---- legacy files: still read, clearly flagged, migrated on request ---------------
my $legacy = temp-dir;
$legacy.add('IZ4').spurt("IZ4\n\ngist:\n    Security intent.\n\nconstraints:\n    - Runs offline.\n\ninvariants:\n    - Invariant 1: Secrets never logged.\n");
($rc, $out, $err) = iz4($legacy, 'check');
is $rc, 0, 'a legacy file still passes check';
like $out, /"✗ format: legacy - 'iz4 migrate'"/, 'and is flagged for migration';
like $out, /'✗ invariants: 1 use numbers reserved for the foundation'/, 'including its reserved-number collision';
($rc, $out, $err) = iz4($legacy, 'migrate');
is $rc, 1, 'migrate from a script needs --for-who';
($rc, $out, $err) = iz4($legacy, 'migrate', '--for-who=The people whose secrets these are.', '--dry-run');
ok $rc == 0 && $out.contains('INVARIANT 5'), 'dry run shows the result';
nok $legacy.add('IZ4.legacy.md').e, 'and writes nothing';
($rc, $out, $err) = iz4($legacy, 'migrate', '--for-who=The people whose secrets these are.');
like $out, /'1 -> 5'/, 'migrate reports the renumbering';
ok $legacy.add('IZ4.legacy.md').slurp.contains('Runs offline.'), 'and keeps what it removed in the companion';
($rc, $out, $err) = iz4($legacy, 'check');
unlike $out, /'legacy'/, 'the migrated file is current';
($rc, $out, $err) = iz4($legacy, 'migrate', '--for-who=x');
is $rc, 1, 'migrating twice is refused';

# ---- explicit .iz4 documents ------------------------------------------------------
my $nested = $dir.add('docs');
$nested.mkdir;
$nested.add('security.iz4').spurt("IZ4\n\nIS FOR WHAT\nKeeping secrets.\n\nIS FOR WHO\nEveryone with an account.\n\nINVARIANT\nSecrets are never logged.\n");
($rc, $out, $err) = iz4($nested, 'check', 'security.iz4');
is $rc, 0, 'explicit .iz4 checked';
like $out, /"security.iz4:9: warning: unnumbered INVARIANT"/, 'with the unnumbered warning';
unlike $out, /'AGENTS.md'/, 'agent entry points are only checked for a root IZ4';
($rc, $out, $err) = iz4($nested, 'number', 'security.iz4');
is ($rc, $out), (0, "Numbered 1 invariant in security.iz4 (Invariant 5)\n"), 'number starts at 5';

# ---- suggest: few candidates, nothing added without a person ---------------------
my $sug = temp-dir;
$sug.add('IZ4').spurt("IZ4\n\nIS FOR WHAT\nJobs.\n\nIS FOR WHO\nJob seekers.\n");
my $reply = $sug.add('reply.txt');
$reply.spurt((1..47).map({ "STRONG | Behaviour $_ is kept. | because $_ | t/$_.t" }).join("\n")
    ~ "\nPOSSIBLE | Applications are never shared. | Is sharing with partners acceptable?\nIMPLEMENTATION | Uses Mojolicious | README\n");
%*ENV<IZ4_AGENT_CMD> = "cat {$reply}";
($rc, $out, $err) = iz4($sug, 'suggest');
is $rc, 0, 'suggest exits 0';
like $out, /'I found 47 strong candidate invariants and 1 thing that may depend on product intent'/, 'it says what it found';
like $out, /'Showing the strongest 5'/, 'but does not dump 47 candidates on a person';
is $out.comb('Strong candidate:').elems, 5, 'only five are shown';
like $out, /'Only you can say: Is sharing with partners acceptable?'/, 'possible ones carry the question for the owner';
like $out, /'Nothing was added'/, 'and nothing is added without a person';
nok $sug.add('IZ4').slurp.contains('INVARIANT'), 'the file is unchanged';
($rc, $out, $err) = iz4-talk($sug, "q\n", 'suggest');
like $out, /"Let's review the strongest one first"/, 'on a terminal it reviews one at a time, strongest first';
%*ENV<IZ4_AGENT_CMD> = 'false';
($rc, $out, $err) = iz4($sug, 'suggest');
ok $rc == 1 && $err.contains('nothing was added'), 'a failing agent adds nothing and says so';

done-testing;
