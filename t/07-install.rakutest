use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;

plan 13;

my $repo-root = $?FILE.IO.parent.parent.resolve;

# iz4 version (what the installer uses to verify itself)
my ($rc, $out, $err) = iz4(temp-dir, 'version');
is $rc, 0, 'version exits 0';
like $out, /^ 'iz4 ' \d+ '.' \d+ '.' \d+ /, 'prints the tool version';
like $out, /^ 'iz4 ' \d+ '.' \d+ '.' \d+ \s* $/, 'prints only the tool version: the format is unversioned';

# the installer, run against this checkout, into an isolated prefix;
# raku is already present here, so no runtime is ever fetched. The installer
# installs the Raku source, so it needs a Rakudo runtime: a CI runner testing
# only a compiled iz4 may have none, and then this part is skipped.
sub have-raku(--> Bool) {
    my $p = try run 'sh', '-c', 'command -v raku || test -x "$HOME/.rakubrew/shims/raku"', :out, :err;
    $p.defined && $p.exitcode == 0;
}
if have-git() && have-raku() {
    my $fake = temp-dir;
    my %env = %*ENV;
    %env<IZ4_REPO>       = $repo-root.Str;
    %env<IZ4_HOME>       = $fake.add('share').Str;
    %env<IZ4_BIN>        = $fake.add('bin').Str;
    %env<IZ4_NO_RUNTIME> = '1';

    my $p1 = run 'sh', $repo-root.add('install').Str, :out, :err, :env(%env);
    my $o1 = $p1.out.slurp(:close);
    my $e1 = $p1.err.slurp(:close);
    is $p1.exitcode, 0, 'installer exits 0' or diag "out: $o1\nerr: $e1";

    my $launcher = $fake.add('bin/iz4');
    ok $launcher.f && $launcher.x, 'launcher is installed and executable';
    like $launcher.slurp, /'"' $($fake.add('share/cli/bin/iz4').Str) '"'/,
        'launcher runs iz4 from the installed checkout';
    like $o1, /'installed:'/, 'installer reports success';

    my $p2 = run 'sh', $repo-root.add('install').Str, :out, :err, :env(%env);
    $p2.out.slurp(:close);
    $p2.err.slurp(:close);
    is $p2.exitcode, 0, 're-running the installer updates cleanly';

    # a symlinked checkout is a developer's own: left alone, never pulled over
    my $cli = $fake.add('share/cli');
    run 'rm', '-rf', $cli.Str;
    run 'ln', '-s', $repo-root.Str, $cli.Str;
    my $p4 = run 'sh', $repo-root.add('install').Str, :out, :err, :env(%env);
    my $o4 = $p4.out.slurp(:close);
    $p4.err.slurp(:close);
    is $p4.exitcode, 0, 'installer accepts a symlinked checkout';
    like $o4, /'running iz4 from your checkout at ' $($repo-root.Str) .* 'not pulling'/,
        'installer says it is running the developer checkout';
    ok $cli.l && $cli.resolve eq $repo-root, 'the symlink is left in place';

    # an existing symlink at the launcher path is replaced, never written
    # through (writing through would clobber the file it points at)
    my $pointee = $fake.add('pointee');
    $pointee.spurt("do not clobber\n");
    $launcher.unlink;
    run 'ln', '-s', $pointee.Str, $launcher.Str;
    my $p3 = run 'sh', $repo-root.add('install').Str, :out, :err, :env(%env);
    $p3.out.slurp(:close);
    $p3.err.slurp(:close);
    ok !$launcher.l && $launcher.f, 'symlink replaced by a real launcher';
    is $pointee.slurp, "do not clobber\n", 'the symlink target was not written through';
}
else {
    skip 'needs git and a Rakudo runtime', 10;
}
