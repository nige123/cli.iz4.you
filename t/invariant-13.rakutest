# INVARIANT stable-names.cli.iz4.you
# An invariant's name is a stable reference: the five foundation names mean
# the same in every IZ4, a project's own are named under its own domain,
# and a name once given is never reused for a different invariant.
# BECAUSE People and agents cite invariants by name in reviews, commits and
# conversations, and a citation that silently changes meaning misleads
# them.
use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;

# the five foundation names mean the same in every IZ4
is foundation-ids(), <humans-first.iz4.you do-no-harm.iz4.you human-agency.iz4.you honesty.iz4.you foundation-holds.iz4.you>,
    'the foundation is five names';
my $dir = temp-dir;
my $iz4 = minimal-iz4(:$dir);
for foundation-ids() -> $id {
    throws-like { add-invariant($iz4, 'Mine.', :name($id)) }, X::IZ4, message => /'part of the foundation'/, "$id cannot be given to a project invariant";
    nok IZ4::Document.parse("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\n" ~ foundation-block() ~ "\nINVARIANT $id\nMine.\n").ok, "nor written a second time by hand";
}
like invariant-text($iz4, 'human-agency.iz4.you'), /'Keep people in charge.'/, "'human-agency.iz4.you' always means the foundation's";
throws-like { add-invariant($iz4, 'Mine.', :name('profit-first.iz4.you')) }, X::IZ4, message => /"the foundation's"/,
    'and no project can put a sixth name beside them';

# a project's own are named under its own domain, by a whole name
is add-invariant($iz4, 'First.', :name('first.shop.example.com'), :because('one')), 'first.shop.example.com', 'an invariant is added under the name it was given';
is add-invariant($iz4, 'Second.', :name('second.shop.example.com'), :because('two')), 'second.shop.example.com', 'and so is the next';
is check-doc($iz4).invariants».id, <first.shop.example.com second.shop.example.com>, 'the file carries the names exactly';
for 'First', 'first', 'first.shop', '7', 'first_one.shop.example.com' -> $bad {
    throws-like { add-invariant($iz4, 'Another.', :name($bad)) }, X::IZ4, "'$bad' is not a name an invariant can have";
}

# a name means one invariant: never two at once
throws-like { add-invariant($iz4, 'Another.', :name('first.shop.example.com')) }, X::IZ4, message => /'already in'/, 'a name in use is refused';

# the name does not depend on where the invariant sits: moving it changes nothing
my $moved = temp-dir.add('IZ4');
my $src = $iz4.slurp;
my $second = $src.substr($src.index('INVARIANT second.shop.example.com'));
$moved.spurt($src.subst($second, '').subst('INVARIANT first.shop.example.com', $second ~ "\nINVARIANT first.shop.example.com"));
is check-doc($moved).invariants».id, <second.shop.example.com first.shop.example.com>, 'the same invariants in another order';
is invariant-text($moved, 'first.shop.example.com'), invariant-text($iz4, 'first.shop.example.com'), 'answer to the same names with the same words';
is invariant-digest('first.shop.example.com', 'First.', 'one'), invariant-digest('first.shop.example.com', "First.\n", ' one '), 'and the digest of a wording does not depend on layout either';

# nor is a name reused after the invariant it named is gone
withdraw-invariant($iz4, 'second.shop.example.com');
like $iz4.slurp, /'# INVARIANT second.shop.example.com was withdrawn on ' \d+ '-' \d+ '-' \d+ '; its name is retired.'/, 'a withdrawal leaves the name on record in the file';
throws-like { add-invariant($iz4, 'New and different.', :name('second.shop.example.com')) }, X::IZ4, message => /'never reused for a different invariant'/,
    'a withdrawn name is refused for a different invariant';
nok check-doc($iz4.parent.add('IZ4')).invariant('second.shop.example.com').defined, 'and it stays out of the file';
my $by-hand = temp-dir.add('IZ4');
$by-hand.spurt($iz4.slurp ~ "\nINVARIANT second.shop.example.com\nNew and different.\n");
like check-doc($by-hand).errors».Str.join, /'reuses a withdrawn name'/, 'writing it back by hand fails the check';
like invariant-text($iz4, 'second.shop.example.com'), /'was withdrawn' .* 'its name is retired and never reused'/, 'a citation of the retired name is answered with what happened to it';

# even when the withdrawal comment is gone, the history remembers
if have-git() {
    my $repo = temp-dir;
    sub g(*@a) {
        my $p = run 'git', '-C', $repo.Str, |@a, :out, :err;
        my $o = $p.out.slurp(:close);
        my $e = $p.err.slurp(:close);
        die "git {@a.join(' ')} failed ({$p.exitcode}): {$e.trim || $o.trim}" if $p.exitcode != 0;
        $p;
    }
    g('init', '-q'); g('config', 'user.email', 't@t'); g('config', 'user.name', 'T');
    my $f = minimal-iz4(:dir($repo));
    add-invariant($f, 'Kept.', :name('kept.shop.example.com'), :because('a'));
    add-invariant($f, 'Retired later.', :name('retired.shop.example.com'), :because('b'));
    g('add', '-A'); g('commit', '-qm', 'two invariants');
    # the owner removes one by hand, leaving no comment
    $f.spurt($f.slurp.subst(/ \n 'INVARIANT retired.shop.example.com' \n .* /, "\n"));
    g('commit', '-qam', 'retire one');
    is check-doc($f).invariants».id, ('kept.shop.example.com',), 'the invariant is gone from the file, and so is any trace of its name';
    throws-like { add-invariant($f, 'New and different.', :name('retired.shop.example.com'), :because('c')) }, X::IZ4, message => /'was used before'/,
        'the Git history still refuses the name to a different invariant';
    is add-invariant($f, 'New and different.', :name('new.shop.example.com'), :because('c')), 'new.shop.example.com', 'a new name is fine';
}
else {
    skip 'git not available', 3;
}

# the numbers of the earlier format are history: nothing gives one out any more
nok template(:for-what<x>, :for-who<y>) ~~ / ^^ 'INVARIANT ' \d /, 'a new IZ4 carries no numbered invariant';
throws-like { invariant-text($iz4, '5') }, X::IZ4, message => /'invariants are named now'/, 'and a citation by number is answered with that, not with a guess';

done-testing;
