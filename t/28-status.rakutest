use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;

# iz4 status: one screen of where things stand.  Each invariant carries one
# of four marks, each a different shape: held (a test names it and passed),
# promised (nothing yet shows it), broken (its test fails), not checked.
# The marks come from the tests it runs now, or the last run while the IZ4
# and those tests are unchanged.

unless have-git() { skip-rest 'no git available'; exit }

my $config = temp-dir.add('gitconfig');
$config.spurt('');
%*ENV<GIT_CONFIG_GLOBAL> = $config.Str;
%*ENV<IZ4_INTERACTIVE> = '0';
%*ENV<IZ4_NO_321> = '1';
%*ENV<IZ4_CHECK_CMD> = 'sh {file}';
%*ENV<IZ4_AGENT_CMD> = '';
%*ENV<LC_ALL> = 'C.UTF-8';

sub g(IO::Path $r, *@a) { my $p = run 'git', '-C', $r.Str, |@a, :out, :err; my $o = $p.out.slurp(:close); $p.err.slurp(:close); $o.trim }

# ---- nowhere -----------------------------------------------------------------
{
    my ($rc, $out, $err) = iz4(temp-dir, 'status');
    is $rc, 0, 'no IZ4 is a status, not an error';
    like $out, / 'No IZ4 here' .* 'iz4 init' /, 'and says what to do';
    my %j = Rakudo::Internals::JSON.from-json(iz4(temp-dir, 'status', '--json')[1]);
    is %j<schema>, 'iz4-status/1', 'the JSON carries its schema';
    nok %j<iz4><present>, 'and says no IZ4 is present';
}

my $r = temp-dir;
g($r, 'init', '-q');
g($r, 'config', 'user.email', 't@test');
g($r, 'config', 'user.name', 'Test');
my ($rc, $out, $err) = iz4($r, 'init', '--namespace=shop.example.com', '--for-what=Taking orders.', '--for-who=People buying things.', '--/agents');
is $rc, 0, 'init';
g($r, 'add', '-A'); g($r, 'commit', '-qm', 'start');

# ---- a fresh IZ4 -------------------------------------------------------------
($rc, $out, $err) = iz4($r, 'status');
is $rc, 0, 'status';
like $out, / ^ 'iz4 status: IZ4, no promises of its own yet' \n \n 'foundation    held, word for word' \n \n 'invariants    none of your own yet' \n \n 'this change' /, 'the header, the foundation, no promises yet, each in its own chunk';
like $out, / 'this change   nothing staged' /, 'nothing staged';
like $out, / 'agents        nothing wired' \h+ '321 is not installed' /, 'no agent wiring in a bare repository, in a table row';
like $out, / 'checked       0 tests just now' .* \n \n 'file facts and test results, never that the software is safe' \n /, 'what was checked, then the disclaimer on its own line';
like $out, / \n 'next:  nothing waits on you' \n /, 'and nothing to do';
unlike $out, / 'All held' /, 'with no invariants of its own there is nothing to call held';
unlike $out, / '◆' | '◇' /, 'no marks without invariants';

# ---- a promise ---------------------------------------------------------------
($rc, $out, $err) = iz4($r, 'add', 'promise', 'An order is never charged twice.', '--name=charged-once', '--when=the shop takes an order', '--namespace=shop.example.com', "--protects=a customer's money", '--force', '--established');
is $rc, 0, 'add';
like $out, / 'Added PROMISE charged-once.shop.example.com, established' /, 'an established promise, so its words wait for a yes';
like iz4($r, 'status')[1], / ^ 'iz4 status: IZ4, established' /, 'and the header says so';
($rc, $out, $err) = iz4($r, 'status');
like $out, / 'invariants    1 of your own: 0% held (0), 1 promised' \n '  ◇ charged-once  no test yet' \n \n /, 'an invariant without a test is a promise: an open diamond, and the share held is said';
like $out, / 'next:  iz4 test' /, 'and the next step is a test';
like $out, / 'this change   nothing staged' /, 'the IZ4 changed in the worktree but nothing is staged';
g($r, 'add', 'IZ4');
($rc, $out, $err) = iz4($r, 'status');
like $out, / 'this change   1 file staged' \h+ '1 change to what it promises, 0 to a protection: agreement-required' /, 'staged, it is a change to what the software promises';
like $out, / 'next:  iz4 approve --staged' /, 'which waits for a yes';
g($r, 'commit', '-qm', 'charged once');

# ---- held --------------------------------------------------------------------
$r.add('t').mkdir;
my $test = $r.add('t/charged-once.t');
$test.spurt("#!/bin/sh\n# charged-once.shop.example.com\nexit 0\n");
($rc, $out, $err) = iz4($r, 'status');
is $rc, 0, 'status with a passing test';
like $out, / 'invariants    1 of your own: 100% held (1)' \n '  ◆ charged-once  t/charged-once.t passed' \n \n /, 'a test names it and passed: a closed diamond, and the share held is said';
like $out, / 'checked       1 test just now, ' \d+ ['.' \d+]? 's' \n /, 'it says it ran the test';
like $out, / 'next:  nothing waits on you' \n \n 'All held: 1 of 1 invariants by their tests just now, and the foundation word for word.' \n /, 'nothing to do, and it says plainly that everything held';
my %j = Rakudo::Internals::JSON.from-json(iz4($r, 'status', '--json')[1]);
is %j<invariants>[0]<mark>, 'held', 'the JSON says held';
is %j<invariants>[0]<id>, 'charged-once.shop.example.com', 'by full name';
ok %j<checks><ran> || %j<checks><recorded>, 'and that it ran the checks, or read the run it had just made';

# the last run speaks while the IZ4 and the test are unchanged
($rc, $out, $err) = iz4($r, 'status', '--no-checks');
is $rc, 0, '--no-checks, as the help spells it';
like $out, / '  ◆ charged-once  t/charged-once.t passed' /, 'without running, the last run still speaks for the same content';
like $out, / 'checked       1 test, ' \d+ ' second' 's'? ' ago' \h+ 'nothing has changed since; --recheck runs them again' /, 'and says when, and that nothing changed';
($rc, $out, $err) = iz4($r, 'status');
like $out, / 'checked       1 test, ' \d+ ' second' 's'? ' ago' /, 'a plain status on an unchanged tree reads the same run instead of running again';
like $out, / 'All held: 1 of 1 invariants by their tests at the last run' /, 'the plain statement says which run';
($rc, $out, $err) = iz4($r, 'status', '--recheck');
like $out, / 'checked       1 test just now' /, '--recheck runs them regardless';
$test.spurt("#!/bin/sh\n# charged-once.shop.example.com\nexit 1\n");
($rc, $out, $err) = iz4($r, 'status', '--/checks');
like $out, / '  ◇ charged-once  not checked; named by t/charged-once.t' /, 'the test changed: the last run no longer speaks, so it is a promise again';
like $out, / 'checked       nothing ran' \h+ '--no-checks' /, 'and nothing ran';
like $out, / 'next:  iz4 status' /, 'the next step is to run them';

# ---- broken ------------------------------------------------------------------
($rc, $out, $err) = iz4($r, 'status');
is $rc, 0, 'status exits 0 even when a test fails: it reports, it does not hold';
like $out, / 'invariants    1 of your own: 0% held (0), 1 broken' \n '  ✕ charged-once  t/charged-once.t FAILED' \n \n /, 'its test fails: a cross';
like $out, / 'next:  make t/charged-once.t pass   (charged-once.shop.example.com is broken; the promise stands as written)' /, 'the next step is to make the test pass, never to approve a failure';
unlike $out, / 'next:  iz4 approve' /, 'a failing test sends nobody to approve';

# ---- not checked -------------------------------------------------------------
($rc, $out, $err) = iz4($r, 'status', :env(IZ4_CHECK_CMD => 'no-such-runner-anywhere {file}'));   # another runner is another run: nothing is reused
like $out, / '  ? charged-once  t/charged-once.t not run (unassessed)' /, 'a runner that is not there: a question mark';
like $out, / 'invariants    1 of your own: 0% held (0), 1 unknown' /, 'counted as unknown';

# ---- plain terminals ---------------------------------------------------------
($rc, $out, $err) = iz4($r, 'status', :env(LC_ALL => 'C', LANG => 'C'));
like $out, / '  x charged-once  t/charged-once.t FAILED' /, 'without UTF-8 the cross is an x';
$test.spurt("#!/bin/sh\n# charged-once.shop.example.com\nexit 0\n");
($rc, $out, $err) = iz4($r, 'status', :env(LC_ALL => 'C', LANG => 'C'));
like $out, / '  * charged-once  t/charged-once.t passed' /, 'and the closed diamond a star';
unlike $out, / "\e[" /, 'and into a pipe, no colour';

# ---- air -----------------------------------------------------------------------
($rc, $out, $err) = iz4($r, 'status', '--no-checks', :env(IZ4_COLOR => '1'));
like $out, / ^ \n /, 'dressed for a terminal, iz4 opens with a row of air';
like $out, / \n \n $ /, 'and closes with one';
($rc, $out, $err) = iz4($r, 'version', :env(IZ4_COLOR => '1'));
like $out, / ^ \n .* 'iz4 ' \d .* \n \n $ /, 'every command, the shortest too, under its title';
($rc, $out, $err) = iz4($r, 'version');
like $out, / ^ 'iz4 ' /, 'into a pipe, the words alone';
unlike $out, / \n \n $ /, 'and no air after them';

done-testing;
