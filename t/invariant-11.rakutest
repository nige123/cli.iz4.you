# INVARIANT keeps-your-words.cli.iz4.you
# The tool never silently overwrites, reformats or discards a
# person's words in an IZ4.
# BECAUSE The file records what its owner decided must stay true; a tool
# that rewrote it quietly would be substituting its own judgement for theirs.
use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;

my $dir = temp-dir;
my $iz4 = $dir.add('IZ4');
$iz4.spurt(q:to/END/);
    IZ4 shop.example.com
    # a comment the owner wrote, with   odd   spacing
    IS FOR WHAT?
    Their words,
      wrapped their way.

    IS FOR WHO?
    Them.

    PROMISE first.shop.example.com

      WHEN      a price is shown
      ALWAYS    First rule.
      PROTECTS  A stale price sells work at a loss.

      CHANGES REQUIRE signed human approval for the exact change
      CHECKED WITH    linked tests; failures block commit
    END
my $before = $iz4.slurp;

# adding appends; every byte that was there is still there
add-invariant($iz4, 'Second rule.', :name('second.shop.example.com'), :because('Why two.'), :reach('there is a second'));
ok $iz4.slurp.starts-with($before.trim-trailing), 'add keeps every existing byte, odd spacing included';

# setting an answer needs --replace, and even then touches only that block
throws-like { set-is-for($iz4, 'IS FOR WHO', 'Others.') }, X::IZ4, message => /'--replace'/, 'replacing an answer is refused without --replace';
set-is-for($iz4, 'IS FOR WHO', 'Others.', :replace);
ok $iz4.slurp.contains("Their words,\n  wrapped their way."), 'replacing one answer leaves the other, and its wrapping, alone';

# init never overwrites; scaffolds never overwrite; a failing rewrite leaves the file as it was
throws-like { init(:$dir, :for-what('x'), :for-who('y'), :namespace('shop.example.com')) }, X::IZ4, message => /'not overwriting'/, 'init refuses an existing file';
my $snapshot = $iz4.slurp;
throws-like { add-invariant($iz4, 'Clash.', :name('first.shop.example.com'), :reach('it applies'), :established) }, X::IZ4, 'a refused add';
is $iz4.slurp, $snapshot, 'writes nothing';

# an old-format file is refused, not rewritten
my $old = temp-dir.add('IZ4');
$old.spurt("IZ4\n\ngist:\n    Their old words.\n");
my ($rc, $out, $err) = iz4($old.parent, 'check');
is $old.slurp, "IZ4\n\ngist:\n    Their old words.\n", 'check leaves a file it cannot read exactly as it was';

# so does everything else: a file in an earlier form is refused by what would write to it, and said to be
for "IZ4\n\nIS FOR WHAT?\nTheir words.\n\nIS FOR WHO?\nThem.\n\nINVARIANT mine.shop.example.com\nTheir rule.\n\nBECAUSE\nTheir reason.\n",
    "IZ4 shop.example.com\n\nIS FOR WHAT?  Their words.\nIS FOR WHO?   Them.\n\nmine:\n  WHERE:    it applies\n  ALWAYS:   Their rule.\n  PROTECTS: their reason\n" -> $words {
    my $f = temp-dir.add('IZ4');
    $f.spurt($words);
    ($rc, $out, $err) = iz4($f.parent, 'check');
    is $rc, 1, 'an earlier form fails the check';
    like $out ~ $err, / 'earlier form' .* {LAST-TO-MIGRATE} /, 'and names the last iz4 that moves it';
    for ('add', 'promise', 'Another.', '--when=now', '--protects=them', '--name=another'), ('add', 'for-who', 'Others.', '--replace'),
        ('foundation', 'restore'), ('protects', 'mine', 'something else', '--replace'), ('when', 'mine', 'always'), ('establish', 'mine'), ('withdraw', 'mine') -> @cmd {
        ($rc, $out, $err) = iz4($f.parent, |@cmd);
        isnt $rc, 0, "iz4 {@cmd[0,1].join(' ')} refuses it";
        like $out ~ $err, /'earlier form'/, 'and says why';
        is $f.slurp, $words, 'not a byte of it changed';
    }
}

done-testing;
