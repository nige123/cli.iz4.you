use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;

my $dir = temp-dir;

# ---- init: the two answers, nothing else -----------------------------------
my $path = init(:$dir, :for-what('Helping people find work they love to do.'), :for-who('People looking for work.'));
ok $path.f && $path.basename eq 'IZ4', 'init creates IZ4';
ok $path.slurp.starts-with("IZ4\n"), 'with the bare IZ4 header';
my $doc = check-doc($path);
ok $doc.ok && !$doc.warnings, 'a freshly initialised IZ4 is valid';
nok $doc.invariants, 'and demands no invariants';
ok $path.slurp.lines.elems < 12, 'and is tiny: no template to fill in';
like $path.slurp, /'inherits Invariants 0-4'/, 'it tells a reader that 0-4 are inherited';
nok $path.slurp ~~ /:i 'behaviour' | 'constraint' | 'decision' | 'gist'/, 'and has no specification sections';
throws-like { init(:$dir, :for-what('x'), :for-who('y')) }, X::IZ4, message => /'already exists'/, 'init never overwrites';
throws-like { init(:dir(temp-dir), :for-what(''), :for-who('y')) }, X::IZ4, message => /'for'/, 'init needs a real answer';

# ---- IS FOR ------------------------------------------------------------------
throws-like { set-is-for($path, 'IS FOR WHO', 'Someone else.') }, X::IZ4, message => /'--replace'/,
    'replacing an answer is deliberate';
set-is-for($path, 'IS FOR WHO', 'People looking for work, and the employers hiring them.', :replace);
is check-doc($path).for-who, 'People looking for work, and the employers hiring them.', 'IS FOR WHO replaced';
my $nowho = temp-dir.add('IZ4');
$nowho.spurt("IZ4\n\nIS FOR WHAT?\nSomething.\n");
set-is-for($nowho, 'IS FOR WHO', 'Somebody.');
ok check-doc($nowho).ok, 'a missing IS FOR WHO is inserted after IS FOR WHAT';

# ---- add: numbering from 5, BECAUSE beside it, nothing else touched --------
my $before = $path.slurp;
is add-invariant($path, 'People control whether their profile is visible.',
    :because('Looking for work should not mean surrendering privacy.')), 5, 'the first project invariant is 5';
ok $path.slurp.starts-with($before.trim-trailing), 'adding never rewrites what was there';
is add-invariant($path, 'Employers cannot contact someone until that person initiates contact.'), 6, 'then 6';
is add-invariant($path, 'Invariant 9: A chosen number.'), 9, "an explicit 'Invariant 9:' is respected";
is add-invariant($path, 'After nine.'), 10, 'numbering continues after the highest';
throws-like { add-invariant($path, 'Clash.', :number(9)) }, X::IZ4, message => /'already used'/, 'a used number is refused';
throws-like { add-invariant($path, '   ') }, X::IZ4, message => /'empty'/, 'an empty invariant is refused';
$doc = check-doc($path);
ok $doc.ok, 'the file stays valid';
is $doc.invariant(5).because, 'Looking for work should not mean surrendering privacy.', 'BECAUSE written beneath its invariant';
nok $doc.invariant(6).because.defined, 'an invariant may be added without one';
my $long = ('word' xx 40).join(' ');
add-invariant($path, $long, :because($long));
ok $path.slurp.lines.grep(*.chars > 80) == 0, 'text is wrapped at 80 columns';
is check-doc($path).invariant(11).text, $long, 'and reads back unchanged';

# old specification kinds have somewhere else to go
for <behaviour constraint decision direction reference requirement task> -> $kind {
    ok %ELSEWHERE-FOR{$kind}.defined, "adding a $kind is redirected, not accepted";
}

# ---- show and the effective invariant set ------------------------------------
is show-text($path, 'for-what'), "Helping people find work they love to do.\n", 'show for-what';
like show-text($path, 'invariants'), /^ 'INVARIANT 5' \n .* 'BECAUSE' /, 'show invariants lists the project ones';
unlike show-text($path, 'invariants'), /'HUMANS FIRST'/, 'without the inherited ones';
my $effective = effective-text(check-doc($path));
like $effective, /'IS FOR WHAT' .* 'IS FOR WHO' .* 'INVARIANT 0 - HUMANS FIRST (inherited)' .* 'INVARIANT 4 - THE FOUNDATION HOLDS (inherited)' .* 'INVARIANT 5' /,
    'the effective set is IS FOR, then 0-4 inherited, then 5 and up';
like invariant-text($path, 'Invariant 5'), /'INVARIANT 5' \n 'People control'/, "show invariant accepts 'Invariant 5'";
throws-like { invariant-text($path, '42') }, X::IZ4, message => /'0-4 are inherited'/, 'an unknown number explains what exists';
is show-text($path), $path.slurp, 'show prints the whole file';

# ---- number -------------------------------------------------------------------
my $num = temp-dir.add('IZ4');
$num.spurt("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT\nFirst.\n\nBECAUSE\nWhy one.\n\nINVARIANT 7\nChosen.\n\nINVARIANT\nSecond.\n");
is number-invariants($num), ((9, 8), (18, 9)), 'unnumbered invariants get the next free numbers from 5, in file order';
is check-doc($num).invariants».number, (8, 7, 9), 'existing numbers are never changed';
like $num.slurp, /'INVARIANT 8' \n 'First.' \n\n 'BECAUSE' \n 'Why one.'/, 'only the header line changes';
is number-invariants($num), (), 'a second run has nothing to do';
my $fresh = temp-dir.add('IZ4');
$fresh.spurt("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT\nOnly.\n");
is number-invariants($fresh), ((9, 5),), 'with nothing numbered, numbering starts at 5';

# ---- migrate: legacy to Is For, nothing silently lost -------------------------
my $old = temp-dir.add('IZ4');
$old.spurt(q:to/END/);
    IZ4

    # a comment someone wrote
    gist:
        A job board.

    behaviours:
        - Search shows 20 results.

    invariants:
        - Invariant 0: humans first. Help people thrive, and respect each person's dignity. Do no harm, and no greater good makes a person disposable. Keep humans in charge: explain consequential actions, accept challenge and correction, and stop safely when asked. When an objective conflicts with these protections, preserve them, report the conflict, and safely pause the affected action. Be honest about what this is, what it knows, what it has done, and what remains uncertain or blocked. No other entry may weaken this.
        - Invariant 1: Private profiles never appear in public search.
        - Invariant 3: Employers cannot message first. Because: people should not get another inbox.
        - Unnumbered promise.

    constraints:
        - Written in Perl.

    decisions:
        - 2026-01-01: chose Postgres.
    END
throws-like { migrate-text($old, :for-who('')) }, X::IZ4, message => /'who'/, 'migrate needs to know who it is for';
my %m = migrate-text($old, :for-who('People looking for work.'));
my $new = IZ4::Document.parse(%m<text>);
ok $new.ok && !$new.warnings, 'the migrated file is a clean current-format IZ4';
is $new.for-what, 'A job board.', 'the gist becomes IS FOR WHAT';
is $new.for-who, 'People looking for work.', 'IS FOR WHO is the answer given';
is $new.invariants».number, (5, 7, 8), 'project numbers move out of 0-4, keeping order and gaps';
is-deeply %m<mapping>.map({ (.[0] // 'none', .[1]) }).List, ((1, 5), (3, 7), ('none', 8)), 'the mapping is returned so it can be reported';
ok %m<renumbered>, 'and renumbering is flagged';
is $new.invariant(7).because, 'people should not get another inbox.', "a legacy 'Because:' becomes BECAUSE";
nok %m<text>.contains('humans first'), 'the earlier Invariant 0 text is not copied: 0-4 are inherited';
for 'Search shows 20 results.', 'Written in Perl.', 'chose Postgres.', 'a comment someone wrote', 'A job board.' -> $words {
    ok %m<companion>.contains($words), "the companion keeps '$words' word for word";
}
like %m<companion>, /'| 1 | 5 |'/, 'the companion records the number mapping';
throws-like { migrate-text($path, :for-who('x')) }, X::IZ4, message => /'already in the current format'/,
    'a current file is not migrated again';

# a reason folded into a legacy invariant is moved under BECAUSE, and reported
my $folded = temp-dir.add('IZ4');
$folded.spurt("IZ4\n\ngist:\n    Petals.\n\ninvariants:\n    - Invariant 5: No price Petals cannot explain. It never sends a price without the full calculation. A confidently wrong price quietly sells work at a loss.\n    - Invariant 6: A live shop price changes only by human decision. Petals never quietly lowers a price.\n");
my %f = migrate-text($folded, :for-who('Makers.'));
my $fd = IZ4::Document.parse(%f<text>);
is $fd.invariant(5).because, 'A confidently wrong price quietly sells work at a loss.', 'migrate moves a folded reason under BECAUSE';
is $fd.invariant(5).text, 'No price Petals cannot explain. It never sends a price without the full calculation.', 'and keeps the rest as the invariant';
nok $fd.invariant(6).because.defined, 'an invariant whose last sentence is a rule is left whole';
is %f<split>».[0], (5,), 'the split is reported';
like %f<companion>, /'Reasons moved under BECAUSE' .* 'Invariant 5'/, 'and recorded in the companion for review';

# because: set one, or move a folded one, only on the owner's words
my $bp = minimal-iz4();
add-invariant($bp, 'No price Petals cannot explain. A confidently wrong price sells work at a loss.');
add-invariant($bp, 'Stock only goes up when a human has seen the goods.');
is split-because($bp, 5), 'A confidently wrong price sells work at a loss.', 'split-because moves the reason';
is check-doc($bp).invariant(5).text, 'No price Petals cannot explain.', 'leaving the invariant';
nok split-because($bp, 6).defined, 'nothing to split returns nothing and changes nothing';
is set-because($bp, 6, 'Believing in stock that is not there makes an order fail mid-make.'), 6, 'set-because writes a reason';
throws-like { set-because($bp, 6, 'Other.') }, X::IZ4, message => /'--replace'/, 'replacing one is deliberate';
throws-like { set-because($bp, 3, 'Mine.') }, X::IZ4, message => /'inherited'/, "the foundation's reasons cannot be set";
ok check-doc($bp).ok && !check-doc($bp).unexplained-invariants, 'the file is valid with every reason in place';
is split-all-because($bp), (), 'split-all finds nothing left to move';

my $clean = temp-dir.add('IZ4');
$clean.spurt("IZ4\n\ngist:\n    x\n\ninvariants:\n    - Invariant 5: Already fine.\n    - Invariant 6: Also fine.\n");
my %c = migrate-text($clean, :for-who('y'));
nok %c<renumbered>, 'numbers already clear of 0-4 are kept';
is IZ4::Document.parse(%c<text>).invariants».number, (5, 6), 'unchanged';

# ---- suggest: the prompt keeps IZ4 small; the parser caps a flood -----------
my $prompt = suggest-prompt(current => '', evidence => 'README: a job board').words.join(' ');
like $prompt, /'Try to make it small'/, 'the agent is told to make IZ4 small, not complete';
like $prompt, /'not automatically an invariant'/, 'observed behaviour is not an invariant';
like $prompt, /'Tests passing today do not prove'/, 'passing tests prove nothing';
like $prompt, /:i 'framework' .* 'do not normally belong'/, 'framework choices do not belong';
like $prompt, /'Never invent intent'/, 'the owner is asked instead of intent being invented';
like $prompt, /'at most 3 STRONG'/, 'strong candidates are capped in the prompt';
like $prompt, /'STRONG' .* 'POSSIBLE' .* 'IMPLEMENTATION' .* 'NOT IZ4'/, 'the four confidence classes are asked for';
like $prompt, /'rewritten tomorrow'/, 'the golden test is in the prompt';

my $flood = (1..47).map({ "STRONG | Behaviour $_ holds. | because $_ | t/$_.t" }).join("\n")
    ~ "\n- POSSIBLE | Applications are never shared. | Is sharing with partners ever acceptable?"
    ~ "\nIMPLEMENTATION | Uses Mojolicious | README"
    ~ "\nNOT-IZ4 | Search shows 20 results | tests"
    ~ "\nSome chatter the model added.";
my %s = parse-suggestions($flood);
is %s<found><strong>, 47, 'the parser counts everything the agent proposed';
is %s<strong>.elems, 5, 'but a flood is capped before it reaches a person';
is %s<possible>[0]<question>, 'Is sharing with partners ever acceptable?', 'possible candidates keep the question for the owner';
is %s<implementation>.elems + %s<not-iz4>.elems, 2, 'implementation and not-IZ4 items are recognised';
is %s<strong>[0]<because>, '1', "a leading 'because' is stripped from the suggested BECAUSE";

my $agent-dir = temp-dir;
throws-like { agent-suggest($agent-dir, :cmd('false')) }, X::AdHoc, message => /'agent command failed'/,
    'a failing agent is an error, never an invented answer';
my $empty = agent-suggest($agent-dir, :cmd('echo nothing useful'));
is $empty<found><strong> + $empty<found><possible>, 0, 'a reply with nothing usable is an honest nothing';

# ---- portability ---------------------------------------------------------------
my $probe = $dir.add('digest.txt');
$probe.spurt("iz4\n");
is sha256-file($probe), '17d3f49c9ea9709daed96db895e9966341a3757250437bc4067cab48eeea6450',
    'sha256-file yields the known digest on this platform';
throws-like { resolve-target(Str, cwd => temp-dir) }, X::IZ4,
    message => /'No IZ4 found' .* "iz4 init"/, 'no IZ4 gives an actionable error';

done-testing;
