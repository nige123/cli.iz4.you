use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;
use IZ4::Assist;

my $dir = temp-dir;

# ---- init: the two answers, nothing else -----------------------------------
my $path = init(:$dir, :for-what('Helping people find work they love to do.'), :for-who('People looking for work.'));
ok $path.f && $path.basename eq 'IZ4', 'init creates IZ4';
ok $path.slurp.starts-with("IZ4\n"), 'with the bare IZ4 header';
my $doc = check-doc($path);
ok $doc.ok && !$doc.warnings, 'a freshly initialised IZ4 is valid';
nok $doc.invariants, 'and demands no invariants';
ok $path.slurp.lines.elems <= 12 + foundation-block().lines.elems, 'and is tiny: no template to fill in beyond the foundation';
like $path.slurp, /'carries the foundation word for word: human intention protected' .* 'Invariant Zero, humans first' .* 'https://iz4.you/foundation'/,
    'it tells a reader that the five are the foundation, what they protect, and where to read about them';
like $path.slurp, /"Your own invariants are named under your project's domain"/, 'and how its own will be named';
ok $path.slurp.contains(foundation-block()), 'and carries the foundation itself, after IS FOR WHO?';
nok $path.slurp ~~ /:i 'behaviours' | 'constraints' | 'decisions' | 'gist'/, 'and has no specification sections';
throws-like { init(:$dir, :for-what('x'), :for-who('y')) }, X::IZ4, message => /'already exists'/, 'init never overwrites';
throws-like { init(:dir(temp-dir), :for-what(''), :for-who('y')) }, X::IZ4, message => /'for'/, 'init needs a real answer';

# ---- IS FOR ------------------------------------------------------------------
throws-like { set-is-for($path, 'IS FOR WHO', 'Someone else.') }, X::IZ4, message => /'--replace'/,
    'replacing an answer is deliberate';
set-is-for($path, 'IS FOR WHO', 'People looking for work, and the employers hiring them.', :replace);
is check-doc($path).for-who, 'People looking for work, and the employers hiring them.', 'IS FOR WHO replaced';
my $nowho = temp-dir.add('IZ4');
$nowho.spurt("IZ4\n\nIS FOR WHAT?\nSomething.\n\n" ~ foundation-block());
set-is-for($nowho, 'IS FOR WHO', 'Somebody.');
ok check-doc($nowho).ok, 'a missing IS FOR WHO is inserted after IS FOR WHAT' or diag check-doc($nowho).report.join("\n");

# ---- add: a name a person chose, BECAUSE beside it, nothing else touched ----
my $NS = 'shop.example.com';
my $before = $path.slurp;
is add-invariant($path, 'People control whether their profile is visible.', :name("visible-by-choice.$NS"),
    :because('Looking for work should not mean surrendering privacy.'), :namespace($NS)), "visible-by-choice.$NS",
    'add returns the name it wrote, and never a number';
ok $path.slurp.starts-with($before.trim-trailing), 'adding never rewrites what was there';
ok $path.slurp.contains("\n# This project's invariants are named under $NS.\n\nINVARIANT visible-by-choice.$NS\n"),
    'the first add records the namespace, once, above the invariant';
is check-doc($path).namespace, $NS, 'and the document reads it back';
is add-invariant($path, 'Employers cannot contact someone until that person initiates contact.',
    :name("no-first-contact.$NS"), :namespace($NS)), "no-first-contact.$NS", 'a second invariant goes under the same namespace';
is $path.slurp.comb("This project's invariants are named under").elems, 1, 'and the namespace is not recorded twice';
is add-invariant($path, 'A chosen name.', :name('chosen.other.example.org')), 'chosen.other.example.org',
    'a whole name is respected as given';
is check-doc($path).invariants.map(*.id), ("visible-by-choice.$NS", "no-first-contact.$NS", 'chosen.other.example.org'),
    'invariants keep the order they were added in';
throws-like { add-invariant($path, 'Clash.', :name("no-first-contact.$NS")) }, X::IZ4, message => /'already in IZ4'/, 'a used name is refused';
throws-like { add-invariant($path, '   ', :name("empty-words.$NS")) }, X::IZ4, message => /'empty'/, 'an empty invariant is refused';
dies-ok { add-invariant($path, 'No name.') }, 'an invariant is never added without a name';

# the name is an identity: validated, and the foundation's namespace is reserved
for 'Bad_Name.shop.example.com', 'Shouting.shop.example.com', 'two.labels', 'trailing-.shop.example.com', 'a..shop.example.com', 'version.1.2' -> $bad {
    throws-like { add-invariant($path, 'Something true.', :name($bad)) }, X::IZ4, message => /'is not a name an invariant can have'/,
        "'$bad' is not a name an invariant can have";
}
throws-like { add-invariant($path, 'Sneaky.', :name('sneaky.iz4.you')) }, X::IZ4, message => /"names directly under iz4.you are the foundation's"/,
    'a name directly under iz4.you is reserved';
throws-like { add-invariant($path, 'Mine now.', :name('humans-first.iz4.you')) }, X::IZ4, message => /'part of the foundation' .* 'cannot be redefined'/,
    "a foundation invariant's name cannot be taken";
is add-invariant($path, 'A deeper name is ordinary.', :name('sample.cli.iz4.you'), :because('Only three labels are reserved.')),
    'sample.cli.iz4.you', 'a deeper name under iz4.you is an ordinary one';
is full-identity('owner-adjusted', $NS), "owner-adjusted.$NS", 'a short name goes under the namespace';
is full-identity('owner-adjusted.prices', $NS), "owner-adjusted.prices.$NS", 'a short name may carry an area';
is full-identity("owner-adjusted.$NS", $NS), "owner-adjusted.$NS", 'a whole name is taken as it is';
ok namespace-problem('iz4.you') eq '' && namespace-problem($NS) eq '', "iz4.you may be a project's own domain (the register's is); a name directly under it is refused by name, not by domain";

$doc = check-doc($path);
ok $doc.ok, 'the file stays valid' or diag $doc.report.join("\n");
is $doc.invariant("visible-by-choice.$NS").because, 'Looking for work should not mean surrendering privacy.', 'BECAUSE written beneath its invariant';
nok $doc.invariant("no-first-contact.$NS").because.defined, 'an invariant may be added without one';
my $long = ('word' xx 40).join(' ');
add-invariant($path, $long, :name("long-words.$NS"), :because($long));
ok $path.slurp.lines.grep({ .chars > 80 && !.starts-with('#') }) == 0, 'text is wrapped at 80 columns';
is check-doc($path).invariant("long-words.$NS").text, $long, 'and reads back unchanged';

# old specification kinds have somewhere else to go
for <behaviour constraint decision direction reference requirement task> -> $kind {
    ok %ELSEWHERE-FOR{$kind}.defined, "adding a $kind is redirected, not accepted";
}

# ---- show and the effective invariant set ------------------------------------
is show-text($path, 'for-what'), "Helping people find work they love to do.\n", 'show for-what';
like show-text($path, 'invariants'), /^ 'INVARIANT visible-by-choice.shop.example.com' \n .* 'BECAUSE' /, 'show invariants lists the project ones';
unlike show-text($path, 'invariants'), /'humans-first.iz4.you'/, 'without the inherited ones';
my $effective = effective-text(check-doc($path));
like $effective, /'IS FOR WHAT' .* 'IS FOR WHO' .* 'INVARIANT humans-first.iz4.you' \n .* 'INVARIANT keystone.iz4.you' \n .* 'INVARIANT visible-by-choice.shop.example.com' \n /,
    'the effective set is IS FOR, then the five foundation invariants, then the project\'s own';
like invariant-text($path, "visible-by-choice.$NS"), /^ 'INVARIANT visible-by-choice.shop.example.com' \n 'People control'/, 'show invariant accepts the full name';
like invariant-text($path, 'visible-by-choice'), /^ 'INVARIANT visible-by-choice.shop.example.com' \n 'People control'/,
    'and its first label, when only one invariant begins with it';
like invariant-text($path, 'honesty'), /^ 'INVARIANT honesty.iz4.you' \n .* 'BECAUSE'/, 'the foundation answers by name too';
throws-like { invariant-text($path, 'nonesuch') }, X::IZ4,
    message => /"no invariant 'nonesuch'" .* "visible-by-choice.$NS" .* 'the foundation is humans-first.iz4.you'/, 'an unknown name explains what exists';
throws-like { invariant-text($path, '42') }, X::IZ4, message => /'only the foundation, 0 to 4, has an order'/, 'a number is answered with where the names are';
throws-like { invariant-text($path, 'Invariant 5') }, X::IZ4, message => /'only the foundation, 0 to 4, has an order'/, "and so is 'Invariant 5'";
is show-text($path), $path.slurp, 'show prints the whole file';

# ---- withdraw -------------------------------------------------------------------
{
    my $w = minimal-iz4(:dir(temp-dir));
    add-invariant($w, 'Prices are shown before checkout.', :name("prices-shown.$NS"), :because('A surprise at the till is a broken promise.'));
    add-invariant($w, 'Refunds go back the way they came.', :name("refunds-return.$NS"), :because('Money should not change shape on the way back.'));
    add-invariant($w, 'Nothing is sold unexplained.', :name("nothing-unexplained.$NS"));
    my $before = $w.slurp;
    my $gone = withdraw-invariant($w, "refunds-return.$NS");
    is $gone.text, 'Refunds go back the way they came.', 'withdraw returns the invariant as it was';
    is $gone.id, "refunds-return.$NS", 'under its name';
    my $after = check-doc($w);
    is $after.invariants.map(*.id), ("prices-shown.$NS", "nothing-unexplained.$NS"), 'the others keep their names';
    ok $after.ok, 'and the file is still valid';
    ok !$w.slurp.contains('Refunds') && !$w.slurp.contains('change shape'), 'the INVARIANT and its BECAUSE are gone';
    is $w.slurp, $before.subst("INVARIANT refunds-return.$NS\nRefunds go back the way they came.\n\nBECAUSE\nMoney should not change shape on the way back.\n", "# INVARIANT refunds-return.$NS was withdrawn on {Date.today}; its name is retired.\n"),
        'one comment line stands where it was, and nothing else changed';
    is withdrawn-in-text($w), ("refunds-return.$NS",), 'the comment is how a file without Git history remembers';
    is $after.retired, ("refunds-return.$NS",), 'and the document reads the retired name from it';
    throws-like { add-invariant($w, 'Later.', :name("refunds-return.$NS"), :because('Why.')) }, X::IZ4, message => /'used before' .* 'never reused'/,
        'so the name is never given to a different invariant';
    is $w.slurp.comb("INVARIANT refunds-return.$NS").elems, 1, 'and the refused add wrote nothing';
    {
        my $reused = temp-dir.add('IZ4');
        $reused.spurt($w.slurp ~ "\nINVARIANT refunds-return.$NS\nSomething else entirely.\n\nBECAUSE\nA different reason.\n");
        my $r = check-doc($reused);
        ok !$r.ok && $r.errors.first({ .message.contains('reuses a withdrawn name') }).defined,
            'a retired name written back in by hand is an error too';
    }
    is add-invariant($w, 'Later.', :name("later.$NS"), :because('Why.')), "later.$NS", 'a new name is fine';
    withdraw-invariant($w, 'later');
    withdraw-invariant($w, "nothing-unexplained.$NS");
    ok $w.slurp.ends-with("# INVARIANT later.$NS was withdrawn on {Date.today}; its name is retired.\n"), 'withdrawing the last one leaves no trailing blank';
    throws-like { withdraw-invariant($w, "nothing-unexplained.$NS") }, X::IZ4, message => /'already withdrawn'/, 'twice is refused';
    for foundation-ids() -> $id {
        throws-like { withdraw-invariant($w, $id) }, X::IZ4, message => /'cannot be withdrawn' .* 'binding.iz4.you'/, "the foundation's $id cannot be withdrawn";
    }
    throws-like { withdraw-invariant($w, 'humans-first') }, X::IZ4, message => /'cannot be withdrawn'/, 'nor by its short name';
    throws-like { withdraw-invariant($w, "nonesuch.$NS") }, X::IZ4, message => /"no invariant 'nonesuch.$NS'"/, 'a name the file never held is refused';
    ok check-doc($w).ok, 'and after all that the file is still valid';
}

# ---- name: an unnamed INVARIANT is an error, and is given a name on its line ----
my $num = temp-dir.add('IZ4');
$num.spurt("IZ4\n\nIS FOR WHAT?\nx\n\nIS FOR WHO?\ny\n\nINVARIANT\nFirst.\n\nBECAUSE\nWhy one.\n\nINVARIANT chosen.$NS\nChosen.\n\nINVARIANT\nSecond.\n");
{
    my $d = check-doc($num);
    is $d.unnamed-invariants.map(*.line), (9, 18), 'unnamed invariants are found, in file order';
    is $d.errors.grep({ .message.starts-with('INVARIANT has no name') }).map(*.line), (9, 18), 'and each is an error, not a warning';
    nok $d.warnings.first({ .message.contains('no name') }).defined, 'never just a warning';
    ok $d.fixes.first({ .starts-with('iz4 name 9 ') }).defined, 'with the command that names it as the fix';
}
is name-invariant($num, 9, "first.$NS"), "first.$NS", 'name-invariant names the block on a line';
is check-doc($num).invariants.map({ .id // 'unnamed' }), ("first.$NS", "chosen.$NS", 'unnamed'), 'existing names are never changed';
like $num.slurp, /'INVARIANT first.shop.example.com' \n 'First.' \n\n 'BECAUSE' \n 'Why one.'/, 'only the header line changes';
is $num.slurp.lines.elems, 19, 'no line is added or removed';
throws-like { name-invariant($num, 15, "renamed.$NS") }, X::IZ4, message => /'already named chosen.shop.example.com'/, 'a name is an identity and is not changed';
throws-like { name-invariant($num, 9, "again.$NS") }, X::IZ4, message => /'already named first.shop.example.com'/, 'not even one just given';
throws-like { name-invariant($num, 3, "nothing-there.$NS") }, X::IZ4, message => /'no INVARIANT on line 3'/, 'a line with no INVARIANT is refused';
throws-like { name-invariant($num, 18, "chosen.$NS") }, X::IZ4, message => /'already in IZ4'/, 'a name in use is refused';
throws-like { name-invariant($num, 18, 'second.iz4.you') }, X::IZ4, message => /"the foundation's"/, 'and so is a reserved one';
throws-like { name-invariant($num, 18, 'Second') }, X::IZ4, message => /'is not a name an invariant can have'/, 'and an invalid one';
is name-invariant($num, 18, "second.$NS"), "second.$NS", 'the last unnamed one is named';
nok check-doc($num).unnamed-invariants, 'and none is left unnamed';
is check-doc($num).namespace, $NS, 'with no comment to say so, the namespace is what the names share';

# ---- suggest: the prompt keeps IZ4 small; the parser caps a flood -----------
my $prompt = suggest-prompt(current => '', evidence => 'README: a job board').words.join(' ');
like $prompt, /'Try to make it small'/, 'the agent is told to make IZ4 small, not complete';
like $prompt, /'not automatically an invariant'/, 'observed behaviour is not an invariant';
like $prompt, /'Tests passing today do not prove'/, 'passing tests prove nothing';
like $prompt, /:i 'framework' .* 'do not normally belong'/, 'framework choices do not belong';
like $prompt, /'Never invent intent'/, 'the owner is asked instead of intent being invented';
like $prompt, /'at most 3 STRONG'/, 'strong candidates are capped in the prompt';
like $prompt, /'STRONG' .* 'POSSIBLE' .* 'IMPLEMENTATION' .* 'NOT IZ4'/, 'the four confidence classes are asked for';
like $prompt, /'rewritten tomorrow'/, 'the golden test is in the prompt';

my $flood = (1..47).map({ "STRONG | Behaviour $_ holds. | because $_ | t/$_.t" }).join("\n")
    ~ "\n- POSSIBLE | Applications are never shared. | Is sharing with partners ever acceptable?"
    ~ "\nIMPLEMENTATION | Uses Mojolicious | README"
    ~ "\nNOT-IZ4 | Search shows 20 results | tests"
    ~ "\nSome chatter the model added.";
my %s = parse-suggestions($flood);
is %s<found><strong>, 47, 'the parser counts everything the agent proposed';
is %s<strong>.elems, 5, 'but a flood is capped before it reaches a person';
is %s<possible>[0]<question>, 'Is sharing with partners ever acceptable?', 'possible candidates keep the question for the owner';
is %s<implementation>.elems + %s<not-iz4>.elems, 2, 'implementation and not-IZ4 items are recognised';
is %s<strong>[0]<because>, '1', "a leading 'because' is stripped from the suggested BECAUSE";

# ---- drafts are brief: the prompts say so, and a long one is asked for again --
like $prompt, /'at most 25 words'/, 'the agent is given a word budget for an invariant';
like $prompt, /'not a specification'/, 'and told an IZ4 is not a specification';
like purpose-prompt(evidence => 'x'), /'at most 20 words'/, 'what it is for and who for are budgeted too';
like reword-prompt(id => 'a.example.com', text => 'Old.', evidence => 'x'), /'at most 25 words'/, 'and so are new words for an old invariant';
my $wordy = ('word' xx 40).join(' ') ~ '.';
ok too-long($wordy) && !too-long('Payment details never leave the payment system.'), 'a draft past the budget is too long; a plain sentence is not';
my @asked = ($wordy, 25), ($wordy, 20);
like shorten-prompt(@asked), /'1 (at most 25 words): word' .* '2 (at most 20 words): word'/, 'a long draft is sent back with its own limit';
is-deeply parse-shorter("1: Short now.\n2: $wordy\n3: Not asked for.\nchatter", @asked), %( 0 => 'Short now.' ),
    'only a shorter answer to a line that was asked about is taken';
{
    my $d = temp-dir;
    my $count = $d.add('asked');
    # an agent that drafts long, and says it shorter when asked to
    my $cmd = "echo x >> $count; if grep -q 'They are too long'; then echo '1: Payments stay private.'; echo '2: People trust it.'; else echo 'STRONG | $wordy | BECAUSE: $wordy | README'; echo 'POSSIBLE | Short one. | Is it?'; fi";
    my %got = agent-suggest($d, :$cmd);
    is %got<strong>[0]<text>, 'Payments stay private.', 'a long drafted invariant comes back shorter';
    is %got<strong>[0]<because>, 'People trust it.', 'and so does a long reason';
    is %got<possible>[0]<text>, 'Short one.', 'a draft that was already brief is left alone';
    is $count.lines.elems, 2, 'which takes one more pass, not one per line';
    # an agent that cannot say it shorter: the first draft stands
    $count.unlink;
    %got = agent-suggest($d, cmd => "echo x >> $count; cat >/dev/null; echo 'STRONG | $wordy | BECAUSE: why | README'");
    is %got<strong>[0]<text>, $wordy, 'when the agent will not shorten it, the first draft stands for the person to cut';
    is $count.lines.elems, 2, 'after one try, not a loop';
    # brief drafts cost no second pass
    $count.unlink;
    agent-suggest($d, cmd => "echo x >> $count; cat >/dev/null; echo 'STRONG | Brief. | BECAUSE: why | README'");
    is $count.lines.elems, 1, 'brief drafts are not sent back';
    is-deeply agent-purpose($d, cmd => "if grep -q 'They are too long'; then echo '1: Keeping promises.'; else echo 'FOR WHAT: $wordy'; echo 'FOR WHO: Developers.'; fi"),
        %( for-what => 'Keeping promises.', for-who => 'Developers.' ), 'a long answer to what it is for is shortened too';
    is agent-reword($d, id => 'a.example.com', text => 'Old words.', cmd => "if grep -q 'They are too long'; then echo '1: New words.'; else echo 'INVARIANT: $wordy'; fi"),
        'New words.', 'and so are new words for an invariant the software moved on from';
}

my $agent-dir = temp-dir;
throws-like { agent-suggest($agent-dir, :cmd('false')) }, X::AdHoc, message => /'agent command failed'/,
    'a failing agent is an error, never an invented answer';
my $empty = agent-suggest($agent-dir, :cmd('echo nothing useful'));
is $empty<found><strong> + $empty<found><possible>, 0, 'a reply with nothing usable is an honest nothing';

# ---- portability ---------------------------------------------------------------
my $probe = $dir.add('digest.txt');
$probe.spurt("iz4\n");
is sha256-file($probe), '17d3f49c9ea9709daed96db895e9966341a3757250437bc4067cab48eeea6450',
    'sha256-file yields the known digest on this platform';
throws-like { resolve-target(Str, cwd => temp-dir) }, X::IZ4,
    message => /'No IZ4 found' .* "iz4 init"/, 'no IZ4 gives an actionable error';

# the upward search for an IZ4 ends at a root, on every system
nok find-root($*SPEC.rootdir.IO).defined || $*SPEC.rootdir.IO.add('IZ4').f, 'searching from the root directory ends, with nothing found';
nok find-root(temp-dir()).defined && !find-root(temp-dir()).f, 'and so does a search from a directory with no IZ4 above it';

done-testing;
