use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use IZ4Test;
use IZ4;
use IZ4::Document;

plan 51;

my $dir = temp-dir;

# init
my $path = init(:$dir);
ok $path.f, 'init creates IZ4';
is $path.basename, 'IZ4', 'root file is named IZ4';
ok $path.slurp.starts-with("IZ4\n"), 'file starts with the bare IZ4 header';
throws-like { init(:$dir) }, X::IZ4, message => /'already exists'/, 'init refuses to overwrite';
nok check-doc($path).ok, 'freshly initialised IZ4 does not pass check (placeholder gist)';
is check-doc($path).section('invariants').items[0].text, INVARIANT-ZERO,
    'init seeds invariant zero as the first invariant';

# add
is add-entry($path, 'gist', 'A test project.'), 'gist', 'add gist on placeholder';
throws-like { add-entry($path, 'gist', 'Other.') }, X::IZ4, message => /'--replace'/,
    'replacing gist needs --replace';
add-entry($path, 'gist', 'Replaced gist.', :replace);
is check-doc($path).section('gist').text, 'Replaced gist.', 'gist replaced deliberately';

add-entry($path, 'invariant', 'Only one active session may exist per user.');
add-entry($path, 'invariant', 'Second invariant.');
add-entry($path, 'behaviour', 'A user can request a sign-in code by email.');
add-entry($path, 'constraint', 'Must work without client-side JavaScript.');
add-entry($path, 'reference', 'eu-cra: Article 13');
my $doc = check-doc($path);
ok $doc.ok, 'document valid after adds';
is $doc.section('invariants').items».text,
    (INVARIANT-ZERO, 'Invariant 1: Only one active session may exist per user.',
     'Invariant 2: Second invariant.'),
    'add invariant numbers entries and appends after the seeded invariant zero';
is $doc.section('behaviours').items».text, ('A user can request a sign-in code by email.',), 'add behaviour works';
is $doc.section('constraints').items».text, ('Must work without client-side JavaScript.',), 'add constraint works';
is $doc.section('references').items».text, ('eu-cra: Article 13',), 'add reference works';
throws-like { add-entry($path, 'thing', 'x') }, X::IZ4, message => /'unknown kind'/, 'unknown kind rejected';
add-entry($path, 'decision', 'Raku, because it is quick to change.');
add-entry($path, 'direction', 'A context command for AI tools.');
is check-doc($path).section('decisions').items».text, ('Raku, because it is quick to change.',), 'add decision works';
is check-doc($path).section('direction').items».text, ('A context command for AI tools.',), 'add direction works';

# long entries are wrapped losslessly
my $long = ('word' xx 40).join(' ');
add-entry($path, 'constraint', $long);
ok $path.slurp.lines.grep(*.chars > 80) == 0, 'add wraps entries at 80 columns';
is check-doc($path).section('constraints').items[*-1].text, $long, 'wrapped entry reads back unchanged';

# digests are portable: sha256-file must give the exact digest whichever
# tool the platform has (sha256sum, shasum or openssl)
my $digest-probe = $dir.add('digest.txt');
$digest-probe.spurt("iz4\n");
is sha256-file($digest-probe), '17d3f49c9ea9709daed96db895e9966341a3757250437bc4067cab48eeea6450',
    'sha256-file yields the known digest on this platform';
throws-like { add-entry($path, 'invariant', '  ') }, X::IZ4, message => /'empty'/, 'empty text rejected';

# add to a file whose section is missing appends a new section
my $mini = $dir.add('mini.iz4');
$mini.spurt("IZ4 0.0\n\ngist:\n    Mini.\n");
add-entry($mini, 'constraint', 'Added to missing section.');
is check-doc($mini).section('constraints').items[0].text, 'Added to missing section.', 'missing section is created';
add-entry($mini, 'behaviour', 'Goes before constraints.');
is $mini.slurp, "IZ4 0.0\n\ngist:\n    Mini.\n\nbehaviours:\n    - Goes before constraints.\n\nconstraints:\n    - Added to missing section.\n",
    'missing section is created in canonical order';

# show
is show-text($path, 'gist'), "Replaced gist.\n", 'show gist';
my $inv-shown = show-text($path, 'invariants');
ok $inv-shown.starts-with('- Invariant 0: humans first'), 'shown invariants lead with invariant zero';
like $inv-shown, /'- Invariant 1: Only one active session may exist per user.' \n '- Invariant 2: Second invariant.'/, 'show list section';
is show-text($path), $path.slurp, 'show whole document';
is show-text($path, 'invariant'), show-text($path, 'invariants'), 'singular section noun works';

# numbered invariants are explicit references
add-entry($path, 'invariant', 'Invariant 9: Chosen number.');
is check-doc($path).section('invariants').items[*-1].text, 'Invariant 9: Chosen number.',
    'an explicit number is respected';
add-entry($path, 'invariant', 'After nine.');
is check-doc($path).section('invariants').items[*-1].text, 'Invariant 10: After nine.',
    'auto-numbering continues after the highest explicit number';
throws-like { add-entry($path, 'invariant', 'Invariant 9: Clash.') }, X::IZ4,
    message => /"'9' is already used"/, 'a duplicate explicit number is refused';
is invariant-text($path, '2'), "Invariant 2: Second invariant.\n", 'invariant-text resolves a number';
throws-like { invariant-text($path, '77') }, X::IZ4,
    message => /'numbered invariants here'/, 'unknown number lists what exists';

# discovery
my $nested = $dir.add('src/foo/bar');
$nested.mkdir;
# resolved on both sides: macOS temp dirs sit behind a /var -> /private/var symlink
is find-root($nested).resolve.Str, $path.resolve.Str, 'upward lookup from nested directory';
is resolve-target(Str, :cwd($nested)).resolve.Str, $path.resolve.Str, 'resolve-target uses nearest IZ4';
my $lonely = temp-dir;
throws-like { resolve-target(Str, :cwd($lonely)) }, X::IZ4,
    message => /'No IZ4 found' .* "iz4 init"/, 'no IZ4 gives actionable error';

# agent-assisted init drafting: the reply is validated, or we die
my $agent-dir = temp-dir;
throws-like { agent-init-draft($agent-dir, :cmd('false')) }, X::AdHoc,
    message => /'agent command failed'/, 'failing agent command dies';
throws-like { agent-init-draft($agent-dir, :cmd('echo just chatter')) }, X::AdHoc,
    message => /"no 'IZ4' header"/, 'reply without a header dies';

my $placeholder = $agent-dir.add('placeholder.txt');
$placeholder.spurt(template());
throws-like { agent-init-draft($agent-dir, :cmd("cat {$placeholder}")) }, X::AdHoc,
    message => /'draft has problems'/, 'reply still holding the placeholder gist dies';

my $gutless = $agent-dir.add('gutless.txt');
$gutless.spurt("IZ4 0.0\n\ngist:\n    A gist with nothing behind it.\n");
throws-like { agent-init-draft($agent-dir, :cmd("cat {$gutless}")) }, X::AdHoc,
    message => /'draft has no invariants'/, 'reply without invariants dies';

my $good = $agent-dir.add('good.txt');
$good.spurt(qq:to/END/);
    Here is the completed file:
    ```
    IZ4 0.0

    gist:
        A fake project, distilled by a fake agent.

    invariants:
        - The thing never breaks.
        - The other thing holds.
    ```
    END
my $draft = agent-init-draft($agent-dir, :cmd("cat {$good}"));
ok $draft.starts-with("IZ4 0.0\n"), 'chatter and fences are stripped from the reply';
my $draft-doc = IZ4::Document.parse($draft);
is $draft-doc.section('invariants').items.elems, 3, 'draft keeps its invariants and gains invariant zero';
is $draft-doc.section('invariants').items[0].text, INVARIANT-ZERO,
    'invariant zero is restored first when the agent drops it';
is $draft-doc.section('invariants').items[1..2]».text,
    ('Invariant 1: The thing never breaks.', 'Invariant 2: The other thing holds.'),
    'the draft is numbered before it is written';

# number: every unnumbered invariant gets the next free number, in file
# order; existing numbers, wrapping and comments are left alone
my $num-dir = temp-dir;
my $num = $num-dir.add('IZ4');
$num.spurt(qq:to/END/);
    IZ4

    gist:
        Numbering.

    invariants:
        - {INVARIANT-ZERO}
    # a comment stays
        - First rule, wrapped onto
          a second line.
        - Invariant 3: Chosen early.
        - Second rule.
    END
is number-invariants($num), ((9, 4), (12, 5)), 'number reports the lines and numbers written';
is check-doc($num).section('invariants').items».text,
    (INVARIANT-ZERO, 'Invariant 4: First rule, wrapped onto a second line.',
     'Invariant 3: Chosen early.', 'Invariant 5: Second rule.'),
    'numbers continue after the highest in use and existing numbers are untouched';
like $num.slurp, /"# a comment stays\n    - Invariant 4: First rule, wrapped onto\n      a second line.\n"/,
    'only the first line of each numbered entry changes';
is number-invariants($num), (), 'a second run has nothing to do';
ok check-doc($num).ok && !check-doc($num).warnings, 'a numbered file checks clean';
my @lines = "IZ4", "", "gist:", "    g", "", "invariants:", "    - Loose.";
is number-lines(@lines), ((7, 1),), 'number-lines works on lines in place';
is @lines[6], '    - Invariant 1: Loose.', 'the line is rewritten in place';
